# Local Supabase (copy this file to .env.local after `pnpm supabase:start`)
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=copy_the_local_anon_key_from_pnpm_supabase_status

# Server-only values. Never expose SERVICE_ROLE_KEY through a PUBLIC_ variable.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=copy_the_local_service_role_key_from_pnpm_supabase_status

# Optional: only needed when local Discord OAuth is enabled in supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
