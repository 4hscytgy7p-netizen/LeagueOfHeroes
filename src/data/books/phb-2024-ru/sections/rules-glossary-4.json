{
  "bookId": "phb-2024-ru",
  "id": "rules-glossary-4",
  "title": "Глоссарий правил · Часть 4",
  "description": "Падение [Опасность] · [Falling] · Парализованный [Состояние] · [Paralyzed]",
  "sourcePages": [
