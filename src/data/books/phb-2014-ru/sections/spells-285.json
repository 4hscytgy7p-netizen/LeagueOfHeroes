            }
          ],
          "id": "p285-1",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "2 уровень, вызов",
              "italic": true
            }
          ],
          "id": "p285-2",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Время накладывания: 1 бонусное действие"
            }
          ],
          "style": "attribute",
          "id": "p285-3",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Дистанция: На себя"
            }
          ],
          "style": "attribute",
          "id": "p285-4",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Компоненты: В"
            }
          ],
          "style": "attribute",
          "id": "p285-5",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Длительность: Мгновенная Окутавшись серебристым туманом, вы телепортируетесь на 30 футов в свободное пространство, видимое вами."
            }
          ],
          "style": "attribute",
          "id": "p285-6",
          "sourcePage": 285
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "Т"
            },
            {
              "text": "ЬМА"
            },
            {
              "text": ""
            }
          ],
          "id": "p285-7",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "2 уровень, воплощение",
              "italic": true
            }
          ],
          "id": "p285-8",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Время накладывания: 1 действие"
            }
          ],
          "style": "attribute",
          "id": "p285-9",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Дистанция: 60 футов"
            }
          ],
          "style": "attribute",
          "id": "p285-10",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Компоненты: В, М (мех летучей мыши и либо капля дёгтя, либо кусочек угля)"
            }
          ],
          "style": "attribute",
          "id": "p285-11",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Длительность: Концентрация, вплоть до 10 минут"
            }
          ],
          "style": "attribute",
          "id": "p285-12",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Из точки, выбранной вами в пределах дистанции, расползается магическая тьма сферой с радиусом 15 футов. Тьма огибает углы. Существа с тёмным зрением не могут видеть сквозь эту тьму, и немагический свет не может её осветить."
            }
          ],
          "id": "p285-13",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Если выбранная вами точка находится на предмете, который вы держите, несёте или носите, тьма исходит из предмета и перемещается вместе с ним. Если полностью накрыть источник тьмы непрозрачным предметом, например, чашей или шлемом, тьма будет заблокирована."
            }
          ],
          "id": "p285-14",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Если часть зоны этого заклинания накрывает зону света, созданного заклинанием с уровнем не выше 2, заклинание, создавшее свет, рассеивается."
            }
          ],
          "id": "p285-15",
          "sourcePage": 285
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "У"
            },
            {
              "text": "БЕЖИЩЕ"
            },
            {
              "text": ""
            }
          ],
          "id": "p285-16",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "1 уровень, ограждение",
              "italic": true
            }
          ],
          "id": "p285-17",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Время накладывания: 1 бонусное действие"
            }
          ],
          "style": "attribute",
          "id": "p285-18",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Дистанция: 30 футов"
            }
          ],
          "style": "attribute",
          "id": "p285-19",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Компоненты: В, С, М (маленькое серебряное зеркало)"
            }
          ],
          "style": "attribute",
          "id": "p285-20",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Длительность: 1 минута"
            }
          ],
          "style": "attribute",
          "id": "p285-21",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Вы защищаете одно существо в пределах дистанции от атаки. Пока заклинание активно, все существа, нацеливающиеся на защищённое существо атаками или вредоносными заклинаниями, должны вначале совершить спасбросок Мудрости. При провале существо должно выбрать новую цель или потеряет атаку или заклинание. Это заклинание не защищает от эффектов, действующих на площадь, таких как взрыв огненного шара."
            }
          ],
          "id": "p285-22",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Если защищённое существо совершает атаку или накладывает заклинание, оказывающее действие на враждебное существо, это заклинание оканчивается."
            }
          ],
          "id": "p285-23",
          "sourcePage": 285
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "У"
            },
            {
              "text": "ВЕЛИЧЕНИЕ"
            },
            {
              "text": "/"
            },
            {
              "text": "УМЕНЬШЕНИЕ"
            },
            {
              "text": ""
            }
          ],
          "id": "p285-24",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "2 уровень, преобразование",
              "italic": true
            }
          ],
          "id": "p285-25",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Время накладывания: 1 действие"
            }
          ],
          "style": "attribute",
          "id": "p285-26",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Дистанция: 30 футов"
            }
          ],
          "style": "attribute",
          "id": "p285-27",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Компоненты: В, С, М (щепотка толчёного железа)"
            }
          ],
          "style": "attribute",
          "id": "p285-28",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Длительность: Концентрация, вплоть до 1 минуты"
            }
          ],
          "style": "attribute",
          "id": "p285-29",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Вы увеличиваете или уменьшаете существо или предмет, видимый вами в пределах дистанции, на время действия заклинания. Выберите или существо или предмет, который никто не несёт и не носит. Если цель хочет, она может совершить спасбросок Телосложения. В случае успеха заклинание не оказывает на неё никакого влияния."
            }
          ],
          "id": "p285-30",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Если цель — существо, всё, что она носит и несёт, изменяет размер вместе с ней. Всё, что это существо бросит, тут же обретает свой естественный размер."
            }
          ],
          "id": "p285-31",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Увеличение.",
              "italic": true
            },
            {
              "text": " Размеры цели удваиваются по всем измерениям, а вес увеличивается в восемь раз. Это увеличивает размер на одну категорию — от Среднего до Большого, например. Если для цели не хватает пространства, она приобретает максимально возможный размер. Пока заклинание активно, цель совершает с преимуществом проверки и спасброски Силы. Оружие цели тоже увеличивается. Атаки увеличенным оружием причиняют дополнительный урон 1к4."
            }
          ],
          "id": "p285-32",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Уменьшение.",
              "italic": true
            },
            {
              "text": " Размеры цели уменьшаются вдвое по всем измерениям, а вес уменьшается до одной восьмой от обычного. Это уменьшает размер на одну категорию — от Среднего до Маленького, например. Пока заклинание активно, цель совершает с помехой проверки и спасброски Силы. Оружие цели тоже уменьшается. Атаки уменьшенным оружием причиняют на 1к4 меньше урона (урон не может быть меньше 1)."
            }
          ],
          "id": "p285-33",
          "sourcePage": 285
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "У"
            },
            {
              "text": "ДЕРЖАНИЕ ЛИЧНОСТИ"
            },
            {
              "text": ""
            }
          ],
          "id": "p285-34",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "2 уровень, очарование",
              "italic": true
            }
          ],
          "id": "p285-35",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Время накладывания: 1 действие"
            }
          ],
          "style": "attribute",
          "id": "p285-36",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Дистанция: 60 футов"
            }
          ],
          "style": "attribute",
          "id": "p285-37",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Компоненты: В, С, М (небольшой прямой кусочек железа)"
            }
          ],
          "style": "attribute",
          "id": "p285-38",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Длительность: Концентрация, вплоть до 1 минуты"
            }
          ],
          "style": "attribute",
          "id": "p285-39",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Выберите гуманоида, которого видите в пределах дистанции. Цель должна преуспеть в спасброске Мудрости, иначе станет парализованной на период действия заклинания. В конце каждого своего хода цель может совершать новые спасброски Мудрости. В случае успеха заклинание на этой цели оканчивается."
            }
          ],
          "id": "p285-40",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "На больших уровнях:",
              "italic": true
            },
            {
              "text": " Если вы накладываете это заклинание, используя ячейку 3 уровня или выше, вы можете сделать целью одно дополнительное существо за каждый уровень ячейки выше 2. Эти гуманоиды должны находиться в пределах 30 футов друг от друга, когда вы нацеливаетесь на них."
            }
          ],
          "id": "p285-41",
          "sourcePage": 285
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "У"
            },
            {
              "text": "ДЕРЖАНИЕ ЧУДОВИЩА"
            },
            {
              "text": ""
            }
          ],
          "id": "p285-42",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "5 уровень, очарование",
              "italic": true
            }
          ],
          "id": "p285-43",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Время накладывания: 1 действие"
            }
          ],
          "style": "attribute",
          "id": "p285-44",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Дистанция: 90 футов"
            }
          ],
          "style": "attribute",
          "id": "p285-45",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Компоненты: В, С, М (небольшой прямой кусочек железа)"
            }
          ],
          "style": "attribute",
          "id": "p285-46",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Длительность: Концентрация, вплоть до 1 минуты"
            }
          ],
          "style": "attribute",
          "id": "p285-47",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Выберите существо, которое видите в пределах дистанции. Цель должна преуспеть в спасброске Мудрости, иначе станет парализованной на период действия заклинания. Это заклинание не оказывает эффекта на нежить. В конце каждого своего хода цель может совершать новые спасброски Мудрости. В случае успеха заклинание на этой цели оканчивается."
            }
          ],
          "id": "p285-48",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "На больших уровнях:",
              "italic": true
            },
            {
              "text": " Если вы накладываете это заклинание, используя ячейку 6 уровня или выше, вы можете сделать целью одно дополнительное существо за каждый уровень ячейки выше пятого. Эти существа должны находиться в пределах 30 футов друг от друга, когда вы нацеливаетесь на них."
            }
          ],
          "id": "p285-49",
          "sourcePage": 285
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "У"
            },
            {
              "text": "ЖАС"
            },
            {
              "text": ""
            }
          ],
          "id": "p285-50",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "3 уровень, иллюзия",
              "italic": true
            }
          ],
          "id": "p285-51",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Время накладывания: 1 действие"
            }
          ],
          "style": "attribute",
          "id": "p285-52",
          "sourcePage": 285
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Дистанция: На себя (30-футовый конус)"
            }
          ],
          "style": "attribute",
          "id": "p285-53",
          "sourcePage": 285
        }
      ]
    },
    {
      "number": 286,
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Компоненты: В, С, М (белое перо или сердце курицы)"
            }
          ],
          "style": "attribute",
          "id": "p286-1",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Длительность: Концентрация, вплоть до 1 минуты"
            }
          ],
          "style": "attribute",
          "id": "p286-2",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Вы проецируете призрачное изображение худших кошмаров других существ. Все существа в 30-футовом конусе должны преуспеть в спасброске Мудрости, иначе они бросают всё, что держат в руках, и становятся испуганными на время действия заклинания."
            }
          ],
          "id": "p286-3",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Будучи испуганным этим заклинанием, существо должно каждый свой ход совершать действие Рывок, и перемещаться прочь от вас по самому безопасному маршруту, пока у неё есть куда перемещаться. Если существо оканчивает ход в месте, откуда у него нет линии обзора до вас, оно может совершить спасбросок Мудрости. В случае спасения заклинание перестаёт действовать на это существо."
            }
          ],
          "id": "p286-4",
          "sourcePage": 286
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "У"
            },
            {
              "text": "ЗИЛИЩЕ"
            },
            {
              "text": ""
            }
          ],
          "id": "p286-5",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "7 уровень, воплощение",
              "italic": true
            }
          ],
          "id": "p286-6",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Время накладывания: 1 действие"
            }
          ],
          "style": "attribute",
          "id": "p286-7",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Дистанция: 100 футов"
            }
          ],
          "style": "attribute",
          "id": "p286-8",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Компоненты: В, С, М (порошок рубина, стоящий 1 500 зм)"
            }
          ],
          "style": "attribute",
          "id": "p286-9",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Длительность: 1 час"
            }
          ],
          "style": "attribute",
          "id": "p286-10",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Вокруг области, выбранной вами в пределах дистанции, возникает неподвижная, невидимая тюрьма в форме куба, созданная из магической силы. Тюрьма может быть клеткой или сплошной коробкой, на ваш выбор."
            }
          ],
          "id": "p286-11",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Тюрьма в форме клетки может быть с длиной ребра до 20 футов, и состоит из сантиметровых прутьев (диаметр 1/2 дюйма), отстоящих друг от друга на 1 сантиметр (1/2 дюйма)."
            }
          ],
          "id": "p286-12",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Тюрьма в форме коробки может быть с длиной ребра до 10 футов, и она является сплошным барьером, останавливающим любую материю, и блокирующую заклинания, накладываемые как внутрь коробки, так и направленные из неё наружу."
            }
          ],
          "id": "p286-13",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Когда вы накладываете это заклинание, под его действие попадают все существа, находящиеся целиком внутри области. Существа, находящиеся в области лишь частично, или слишком большие для заточения внутри, отталкиваются от центра области, пока не окажутся снаружи."
            }
          ],
          "id": "p286-14",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Существо, находящееся в узилище, не может покинуть его без помощи магии. Если оно пытается использовать телепортацию или перемещение между планами, оно должно вначале преуспеть в спасброске Харизмы. В случае успеха существо может использовать эту магию для выхода из узилища. При провале существо не может покинуть узилище, и тратит впустую использование заклинания или эффект. Узилище простирается и на Эфирный План, запрещая перемещение через него."
            }
          ],
          "id": "p286-15",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Это заклинание нельзя рассеять "
            },
            {
              "text": "рассеиванием магии",
              "italic": true
            },
            {
              "text": "."
            }
          ],
          "id": "p286-16",
          "sourcePage": 286
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "У"
            },
            {
              "text": "КАЗАНИЕ"
            },
            {
              "text": ""
            }
          ],
          "id": "p286-17",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Заговор, прорицание",
              "italic": true
            }
          ],
          "id": "p286-18",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Время накладывания: 1 действие"
            }
          ],
          "style": "attribute",
          "id": "p286-19",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Дистанция: Касание"
            }
          ],
          "style": "attribute",
          "id": "p286-20",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Компоненты: В, С"
            }
          ],
          "style": "attribute",
          "id": "p286-21",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Длительность: Концентрация, вплоть до 1 минуты"
            }
          ],
          "style": "attribute",
          "id": "p286-22",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Вы касаетесь одного согласного существа. Один раз, пока заклинание активно, цель может бросить к4 и добавить выпавшее число к одной проверке характеристики на свой выбор. Эту кость можно бросить до или после совершения проверки. После этого заклинание оканчивается."
            }
          ],
          "id": "p286-23",
          "sourcePage": 286
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "У"
            },
            {
              "text": "ЛУЧШЕНИЕ ХАРАКТЕРИСТИКИ"
            },
            {
              "text": ""
            }
          ],
          "id": "p286-24",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "2 уровень, преобразование",
              "italic": true
            }
          ],
          "id": "p286-25",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Время накладывания: 1 действие"
            }
          ],
          "style": "attribute",
          "id": "p286-26",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Дистанция: Касание"
            }
          ],
          "style": "attribute",
          "id": "p286-27",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Компоненты: В, С, М (мех или перо зверя)"
            }
          ],
          "style": "attribute",
          "id": "p286-28",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Длительность: Концентрация, вплоть до 1 часа"
            }
          ],
          "style": "attribute",
          "id": "p286-29",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Вы касаетесь существа и улучшаете его при помощи магии. Выберите один из следующих эффектов; цель получает этот эффект, пока заклинание активно."
            }
          ],
          "id": "p286-30",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Бычья сила.",
              "italic": true
            },
            {
              "text": " Цель совершает с преимуществом проверки Силы, а грузоподъёмность удваивается."
            }
          ],
          "id": "p286-31",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Кошачья ловкость.",
              "italic": true
            },
            {
              "text": " Цель совершает с преимуществом проверки Ловкости. Кроме того, она не получает урон за падение с высоты 20 футов или меньше, если она дееспособна."
            }
          ],
          "id": "p286-32",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Лисья хитрость.",
              "italic": true
            },
            {
              "text": " Цель совершает с преимуществом проверки Интеллекта."
            }
          ],
          "id": "p286-33",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Медвежья выносливость.",
              "italic": true
            },
            {
              "text": " Цель совершает с преимуществом проверки Телосложения. Она также получает 2к6 временных хитов, которые исчезают в конце заклинания."
            }
          ],
          "id": "p286-34",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Орлиное великолепие.",
              "italic": true
            },
            {
              "text": " Цель совершает с преимуществом проверки Харизмы."
            }
          ],
          "id": "p286-35",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Совиная мудрость.",
              "italic": true
            },
            {
              "text": " Цель совершает с преимуществом проверки Мудрости."
            }
          ],
          "id": "p286-36",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "На больших уровнях:",
              "italic": true
            },
            {
              "text": " Если вы накладываете это заклинание, используя ячейку 3 уровня или выше, вы можете сделать целью одно дополнительное существо за каждый уровень ячейки выше второго."
            }
          ],
          "id": "p286-37",
          "sourcePage": 286
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "У"
            },
            {
              "text": "МИРОТВОРЕНИЕ"
            },
            {
              "text": ""
            }
          ],
          "id": "p286-38",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "2 уровень, очарование",
              "italic": true
            }
          ],
          "id": "p286-39",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Время накладывания: 1 действие"
            }
          ],
          "style": "attribute",
          "id": "p286-40",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Дистанция: 60 футов"
            }
          ],
          "style": "attribute",
          "id": "p286-41",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Компоненты: В, С"
            }
          ],
          "style": "attribute",
          "id": "p286-42",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Длительность: Концентрация, вплоть до 1 минуты"
            }
          ],
          "style": "attribute",
          "id": "p286-43",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Вы пытаетесь подавить сильные эмоции у группы существ. Все гуманоиды в сфере с радиусом 20 футов с центром в точке, выбранной в пределах дистанции, должны совершить спасбросок Харизмы; существо может добровольно провалить этот спасбросок, если пожелает. Если существо проваливает спасбросок, выберите один из двух описанных ниже эффектов:"
            }
          ],
          "id": "p286-44",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Вы можете подавить все эффекты, делающие цель очарованной или испуганной. Когда это заклинание оканчивается, все подавленные эффекты восстанавливаются, при условии, что за это время их действие не окончилось."
            }
          ],
          "id": "p286-45",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "В качестве альтернативы, вы можете сделать цель безразличной к выбранным вами существам, к которым она относилась враждебно. Это безразличие оканчивается, если цель атакована или ей причинён вред заклинанием, или если она станет свидетелем того, как причиняют вред её друзьям. Когда заклинание оканчивается, существо становится вновь враждебным, если Мастер не решит по-другому."
            }
          ],
          "id": "p286-46",
          "sourcePage": 286
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "У"
            },
            {
              "text": "СКОРЕНИЕ"
            },
            {
              "text": ""
            }
          ],
          "id": "p286-47",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "3 уровень, преобразование",
              "italic": true
            }
          ],
          "id": "p286-48",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Время накладывания: 1 действие"
            }
          ],
          "style": "attribute",
          "id": "p286-49",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Дистанция: 30 футов"
            }
          ],
          "style": "attribute",
          "id": "p286-50",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Компоненты: В, С, М (стружка корня лакрицы)"
            }
          ],
          "style": "attribute",
          "id": "p286-51",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Длительность: Концентрация, вплоть до 1 минуты"
            }
          ],
          "style": "attribute",
          "id": "p286-52",
          "sourcePage": 286
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Выберите согласное существо, видимое в пределах дистанции. Пока заклинание активно, скорость"
            }
          ],
          "id": "p286-53",
          "sourcePage": 286
        }
      ]
    }
  ]
}
