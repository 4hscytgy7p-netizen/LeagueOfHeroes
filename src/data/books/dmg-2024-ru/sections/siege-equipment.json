              "text": "]",
              "bold": true
            }
          ],
          "id": "p58-37",
          "sourcePage": 58
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Громадный объект",
              "italic": true
            }
          ],
          "id": "p58-38",
          "sourcePage": 58
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "КД:",
              "bold": true
            },
            {
              "text": " 15"
            }
          ],
          "id": "p58-39",
          "sourcePage": 58
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Хиты:",
              "bold": true
            },
            {
              "text": " 200 Осадная башня — это передвижная деревянная конструкция с рамой из балок и деревянными стенами из досок. Большие деревянные колёса или ролики позволяют солдатам или вьючным животным толкать или тянуть башню. Существа среднего или меньшего размера могут использовать осадную башню, чтобы подняться на стены высотой до 40 футов. Существо внутри башни имеет полное укрытие от атак и других эффектов, которые исходят извне."
            }
          ],
          "id": "p58-40",
          "sourcePage": 58
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "Подвешенный котёл [",
              "bold": true
            },
            {
              "text": "Suspended Cauldron",
              "bold": true
            },
            {
              "text": "]",
              "bold": true
            }
          ],
          "id": "p58-41",
          "sourcePage": 58
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Большой объект",
              "italic": true
