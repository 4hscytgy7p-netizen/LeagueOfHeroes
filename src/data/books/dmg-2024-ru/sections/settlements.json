              "kind": "table",
              "headers": [
                "1к12",
                "Бедствие"
              ],
              "rows": [
                [
                  "1",
                  "Монстры заполонили поселение."
                ],
                [
                  "2",
                  "Ключевая фигура умерла; подозревается убийство."
                ],
                [
                  "3",
                  "Война между гильдиями или бандами."
                ],
                [
                  "4",
                  "Беспорядки из-за чумы или голода."
                ],
                [
                  "5",
                  "Монстры нападают на любого, кто приближается к поселению или покидает его."
                ],
                [
                  "6",
                  "Торговые споры вызывают экономические трудности."
                ],
                [
                  "7",
                  "Стихийное бедствие угрожает поселению."
                ],
                [
                  "8",
                  "Страшное пророчество насторожило жителей."
                ],
                [
                  "9",
                  "Местных жителей призывают на войну."
                ],
                [
                  "10",
                  "Политическая или религиозная рознь грозит насилием."
                ],
                [
                  "11",
                  "Поселение находится в осаде."
                ],
                [
                  "12",
                  "Скандал угрожает влиятельным местным семьям."
                ]
