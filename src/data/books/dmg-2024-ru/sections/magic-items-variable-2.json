                  "text": "Рог Валгаллы, Пояс силы великана (огненный),",
                  "bold": true
                }
              ]
            },
            {
              "kind": "paragraph",
              "spans": [
                {
                  "text": "Пояс силы великана (каменный).",
                  "bold": true
                }
              ]
            },
            {
              "kind": "paragraph",
              "spans": [
                {
                  "text": "Художник: Conceptopolis",
                  "bold": true
                }
              ]
            }
