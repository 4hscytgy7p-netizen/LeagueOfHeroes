              "Гигантский кабан"
            ],
            [
              "7",
              "Лев"
            ],
            [
              "8",
              "Бурый медведь"
            ]
          ],
          "id": "p223-22",
          "sourcePage": 223
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-223-a96cc3ff2e.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 337,
          "height": 421,
          "id": "p223-23",
          "sourcePage": 223
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "Коричневая сумка фокусов",
              "bold": true
            }
          ],
          "id": "p223-24",
          "sourcePage": 223
        },
        {
          "kind": "table",
          "headers": [
            "1к8",
            "Существо"
          ],
          "rows": [
            [
              "1",
              "Шакал"
            ],
            [
              "2",
              "Обезьяна"
            ],
            [
              "3",
              "Бабуин"
            ],
            [
              "4",
              "Топороклюв"
            ],
            [
              "5",
              "Черный медведь"
            ],
            [
              "6",
              "Гигантская куница"
            ],
            [
              "7",
              "Гигантская гиена"
            ],
            [
              "8",
              "Тигр"
            ]
          ],
          "id": "p223-25",
          "sourcePage": 223
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-223-6522a2dc20.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 368,
          "height": 301,
          "id": "p223-26",
          "sourcePage": 223
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-223-de7b7f5f21.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 309,
          "height": 263,
          "id": "p223-27",
          "sourcePage": 223
        },
        {
          "kind": "callout",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "text": "Сапоги ходьбы и прыжков, Сумка фокусов,",
                  "bold": true
                }
              ]
            },
            {
              "kind": "paragraph",
              "spans": [
                {
                  "text": "Свирель канализации, Свирель ужаса.",
                  "bold": true
                }
              ]
            },
            {
              "kind": "paragraph",
              "spans": [
                {
                  "text": "Художник: Conceptopolis",
                  "bold": true
                }
              ]
            }
          ],
          "id": "p223-28",
          "sourcePage": 223
        }
      ]
    },
    {
      "number": 224,
      "blocks": [
        {
          "kind": "heading",
          "level": 3,
          "spans": [
            {
              "text": "Сумка хранения [",
              "bold": true
            },
            {
              "text": "Bag of Holding",
              "bold": true
            },
            {
              "text": "]",
              "bold": true
            }
          ],
          "id": "p224-1",
          "sourcePage": 224
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Чудесный предмет, необычный ",
              "italic": true
            },
            {
              "text": "Эта сумка внутри значительно больше, чем её внешние размеры (приблизительно 2 фута в ширину и 4 фута в глубину). Сумка может вместить до 500 фунтов, не превышающих в объёме 64 кубических фута (~1.8 кубических метра). При этом сумка всегда весит 5 фунтов, вне зависимости от её содержания. Извлечение чего-либо из сумки совершается действием использование."
            }
          ],
          "id": "p224-2",
          "sourcePage": 224
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Если сумка перегружена, проткнута или порвана, то она уничтожается, и её содержимое разбрасывается по Астральному плану. Если сумку вывернуть наизнанку, то её содержимое вываливается наружу невредимым, но прежде, чем её можно будет снова использовать, сумку необходимо вывернуть обратно. Внутри сумки достаточно воздуха для дыхания в течение 10 минут, но это время делится на количество существ внутри."
            }
          ],
          "id": "p224-3",
          "sourcePage": 224
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Помещение сумки хранения в межпространство, созданное с помощью Удобного рюкзака Хеварда, переносной дыры или подобного предмета, мгновенно уничтожат оба предмета и открывает портал, ведущий на Астральный план. Портал появляется в месте, где один предмет пытались поместить в другой. Все существа в пределах 10 футов от врат затягиваются внутрь и помещаются в случайное место место на Астральном плане. После этого врата закрываются. Врата односторонние, и повторно не открываются."
            }
          ],
          "id": "p224-4",
          "sourcePage": 224
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-224-2c100d0e4b.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 463,
          "height": 590,
          "id": "p224-5",
          "sourcePage": 224
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-224-1d9f01460d.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 565,
          "height": 600,
          "id": "p224-6",
          "sourcePage": 224
        },
        {
          "kind": "heading",
          "level": 3,
          "spans": [
            {
              "text": "Танцующая метла Бабы Яги [Baba Yaga’s Dancing Broom]",
              "bold": true
            }
          ],
          "id": "p224-7",
          "sourcePage": 224
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Чудесный предмет, необычный (требуется настройка) ",
              "italic": true
            },
            {
              "text": "Архифея Баба Яга создала множество этих волшебных метёл. Ни одна из них не выглядит точно так же, как другая. Держа метлу, вы можете действием магия превратить её в "
            },
            {
              "text": "оживлённую метлу",
              "bold": true
            },
            {
              "text": " под вашим контролем. Метла затем перемещается в незанятое пространство как можно ближе к вам. Метла действует в инициативе сразу после вас и остаётся оживлённой до тех пор, пока вы бонусным действием не произнесёте командное слово, чтобы вернуть её в неактивное состояние."
            }
          ],
          "id": "p224-8",
          "sourcePage": 224
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "В ваш ход вы можете мысленно управлять оживлённой метлой, если она находится в пределах 30 футов от вас и вы не находитесь в состоянии недееспособный (действие не требуется). Вы решаете, какое действие метла предпримет и куда она переместится в свой следующий ход, или можете отдать ей общий приказ, например, атаковать ваших врагов или охранять место."
            }
          ],
          "id": "p224-9",
          "sourcePage": 224
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Если количество хитов метлы снижается до 0, то она ломается и разрушается. Если метла возвращается в своё неактивное состояние до потери всех своих хитов, то она восстанавливает их все."
            }
          ],
          "id": "p224-10",
          "sourcePage": 224
        },
        {
          "kind": "heading",
          "level": 3,
          "spans": [
            {
              "text": "Трезубец командования рыбами [Trident of Fish Command]",
              "bold": true
            }
          ],
          "id": "p224-11",
          "sourcePage": 224
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Оружие (Трезубец), необычное (требуется настройка) ",
              "italic": true
            },
            {
              "text": "Это магическое оружие имеет 3 заряда и восстанавливает 1к3 израсходованных зарядов ежедневно на рассвете. Пока вы носите его, вы можете потратить 1 заряд, чтобы наложить заклинание Подчинение зверя (Сл. спасброска 15) на зверя, у которого есть скорость плавания."
            }
          ],
          "id": "p224-12",
          "sourcePage": 224
        },
        {
          "kind": "heading",
          "level": 3,
          "spans": [
            {
              "text": "Туфли паука [Slippers of Spider Climbing]",
              "bold": true
            }
          ],
          "id": "p224-13",
          "sourcePage": 224
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Чудесный предмет, необычный (требуется настройка) ",
              "italic": true
            },
            {
              "text": "Пока вы носите эту лёгкую обувь, вы можете перемещаться вверх, вниз и по вертикальным поверхностям, а также по потолкам, оставляя руки свободными. Ваша скорость лазания равна вашей скорости. Однако туфли не позволяют вам двигаться таким образом по скользкой поверхности, такой как покры-"
            }
          ],
          "id": "p224-14",
          "sourcePage": 224
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-224-b09138081e.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 444,
          "height": 494,
          "id": "p224-15",
          "sourcePage": 224
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "тая льдом или маслом."
            }
          ],
          "id": "p224-16",
          "sourcePage": 224
        },
        {
          "kind": "callout",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "text": "Сумка хранения, Танцующая метла Бабы Яги, Трезубец командования рыбами, Туфли паука.",
                  "bold": true
                }
              ]
            },
            {
              "kind": "paragraph",
              "spans": [
                {
                  "text": "Художник: Conceptopolis",
                  "bold": true
                }
              ]
            }
          ],
          "id": "p224-17",
          "sourcePage": 224
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-224-a24cf59973.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 1047,
          "height": 189,
          "smallSrc": "/images/books/dmg-2024-ru/page-224-a24cf59973-640.webp",
          "smallWidth": 640,
          "id": "p224-18",
          "sourcePage": 224
        }
      ]
    },
    {
      "number": 225,
      "blocks": [
        {
          "kind": "heading",
          "level": 3,
          "spans": [
            {
              "text": "Фонарь обнаружения [Lantern of Revealing]",
              "bold": true
            }
          ],
          "id": "p225-1",
          "sourcePage": 225
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Чудесный предмет, необычный ",
              "italic": true
            },
            {
              "text": "Этот закрытый фонарь во время горения потребляет 1 пинту масла за 6 часов и излучает яркий свет в пределах 30 футов и тусклый свет дополнительно на 30 футов. Невидимые существа и объекты становятся видимыми, пока находятся в зоне яркого света фонаря. Вы можете действием использование опустить крышку, уменьшая освещение до тусклого света в пределах 5 футов."
            }
          ],
          "id": "p225-2",
          "sourcePage": 225
        },
        {
          "kind": "heading",
          "level": 3,
          "spans": [
            {
              "text": "Шапка подводного дыхания [Cap of Water Breathing]",
              "bold": true
            }
          ],
          "id": "p225-3",
          "sourcePage": 225
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Чудесный предмет, необычный ",
              "italic": true
            },
            {
              "text": "Надев эту шапку под водой вы можете действием магия создать вокруг вашей головы воздушный пузырь. Этот пузырь позволит вам дышать под водой, как обычно. Пузырь остаётся до тех пор, пока шапка не будет снята или вы не окажетесь вне воды."
            }
          ],
          "id": "p225-4",
          "sourcePage": 225
        },
        {
          "kind": "heading",
          "level": 3,
          "spans": [
            {
              "text": "Шлем понимания языков [Helm of Comprehending Languages]",
              "bold": true
            }
          ],
          "id": "p225-5",
          "sourcePage": 225
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Чудесный предмет, необычный ",
              "italic": true
            },
            {
              "text": "С помощью этого шлема и пока вы его носите вы можете накладывать заклинание Понимание языков."
            }
          ],
          "id": "p225-6",
          "sourcePage": 225
        },
        {
          "kind": "heading",
          "level": 3,
          "spans": [
            {
              "text": "Шлем телепатии [",
              "bold": true
            },
            {
              "text": "Helm of Telepathy",
              "bold": true
            },
            {
              "text": "]",
              "bold": true
            }
          ],
          "id": "p225-7",
          "sourcePage": 225
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Чудесный предмет, необычный (требуется настройка) ",
              "italic": true
            },
            {
              "text": "Пока вы носите этот шлем, вы обладаете телепатией в радиусе 30 футов и можете накладывать заклинания Обнаружение мыслей или Внушение (Сл. спасброска 13) с помощью шлема. Как только одно из этих заклинаний будет наложено с помощью шлема, оно не может быть использовано снова до следующего рассвета."
            }
          ],
          "id": "p225-8",
          "sourcePage": 225
        },
        {
          "kind": "heading",
          "level": 3,
          "spans": [
            {
              "text": "Шляпа маскировки [",
              "bold": true
            },
            {
              "text": "Hat of Disguise",
              "bold": true
            },
            {
              "text": "]",
              "bold": true
            }
          ],
          "id": "p225-9",
          "sourcePage": 225
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Чудесный предмет, необычный (требуется настройка) ",
              "italic": true
            },
            {
              "text": "Пока вы носите эту шляпу, вы можете накладывать заклинание Маскировка. Это заклинание оканчивается, если снять шляпу."
            }
          ],
          "id": "p225-10",
          "sourcePage": 225
        },
        {
          "kind": "heading",
          "level": 3,
          "spans": [
            {
              "text": "Щит часового [",
              "bold": true
            },
            {
              "text": "Sentinel Shield",
              "bold": true
            },
            {
              "text": "]",
              "bold": true
            }
          ],
          "id": "p225-11",
          "sourcePage": 225
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Доспех (щит), необычный ",
              "italic": true
            },
            {
              "text": "Пока вы держите этот щит, у вас есть преимущество на броски инициативы и проверки Мудрости (Внимательность). На щите изображён символ глаза."
            }
          ],
          "id": "p225-12",
          "sourcePage": 225
        },
        {
          "kind": "heading",
          "level": 3,
          "spans": [
            {
              "text": "Эльфийские сапоги [Boots of Elvenkind]",
              "bold": true
            }
          ],
          "id": "p225-13",
          "sourcePage": 225
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Чудесный предмет, необычный ",
              "italic": true
            },
            {
              "text": "Пока вы носите эти сапоги, ваши шаги не издают звука, вне зависимости от поверхности, по которой вы идёте. Вы также получаете преимущество на проверки Ловкости (Скрытность)."
            }
          ],
          "id": "p225-14",
          "sourcePage": 225
        },
        {
          "kind": "heading",
          "level": 3,
          "spans": [
            {
              "text": "Эльфийский плащ [Cloak of Elvenkind]",
              "bold": true
            }
          ],
          "id": "p225-15",
          "sourcePage": 225
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Чудесный предмет, необычный (требуется настройка) ",
              "italic": true
            },
            {
              "text": "Пока вы носите этот плащ, проверки Мудрости (Внимательность) для обнаружения вас совершаются с"
            }
          ],
          "id": "p225-16",
          "sourcePage": 225
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-225-3c6188351c.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 291,
          "height": 336,
          "id": "p225-17",
          "sourcePage": 225
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-225-5d60227ef9.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 287,
          "height": 406,
          "id": "p225-18",
          "sourcePage": 225
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-225-5f8dc77018.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 265,
          "height": 415,
          "id": "p225-19",
          "sourcePage": 225
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-225-9dee356f17.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 373,
          "height": 414,
          "id": "p225-20",
          "sourcePage": 225
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-225-aa526214c3.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 278,
          "height": 635,
          "id": "p225-21",
          "sourcePage": 225
        },
        {
          "kind": "image",
          "src": "/images/books/dmg-2024-ru/page-225-cf2e8f476d.webp",
          "alt": "Иллюстрация к разделу «Необычные предметы · часть 3».",
          "width": 397,
          "height": 301,
          "id": "p225-22",
          "sourcePage": 225
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "помехой, а вы совершаете с преимуществом проверки Ловкости (Скрытность)."
            }
          ],
          "id": "p225-23",
          "sourcePage": 225
        },
        {
          "kind": "callout",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "text": "Шлем телепатии, Шлем понимания языков, Фонарь обнаружения, Шляпа маскировки,",
                  "bold": true
                }
              ]
            },
            {
              "kind": "paragraph",
              "spans": [
                {
                  "text": "Эльфийский плащ, Эльфийские сапоги.",
                  "bold": true
                }
              ]
            },
            {
              "kind": "paragraph",
              "spans": [
                {
                  "text": "Художник: Conceptopolis",
                  "bold": true
                }
              ]
            }
          ],
          "id": "p225-24",
          "sourcePage": 225
        }
      ]
    }
  ]
