            }
          ],
          "id": "p156-17",
          "sourcePage": 156
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Волшебная палочка обнаружения магии"
            }
          ],
          "id": "p156-18",
          "sourcePage": 156
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Волшебная палочка"
            }
          ],
          "id": "p156-19",
          "sourcePage": 156
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "снарядов"
            }
          ],
          "id": "p156-20",
          "sourcePage": 156
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Волшебная палочка"
            }
          ],
          "id": "p156-21",
          "sourcePage": 156
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "паралича"
            }
          ],
          "id": "p156-22",
          "sourcePage": 156
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Волшебная палочка"
            }
          ],
          "id": "p156-23",
          "sourcePage": 156
        },
        {
          "kind": "paragraph",
