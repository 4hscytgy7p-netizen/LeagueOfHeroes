              "Кислота"
            ]
          ],
          "id": "p159-21",
          "sourcePage": 159
        },
        {
          "kind": "heading",
          "level": 4,
          "spans": [
            {
              "text": "Д"
            },
            {
              "text": "ОСПЕХ МОРЯКА"
            },
            {
              "text": ""
            }
          ],
          "id": "p159-22",
          "sourcePage": 159
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "text": "Доспех (лёгкий, средний или тяжёлый), необычный ",
              "italic": true
            },
            {
              "text": "Пока вы носите этот доспех, вы обладаете скоростью плавания, равной скорости вашей ходьбы. Кроме того, каждый раз, когда вы начинаете ход,"
            }
          ],
          "id": "p159-23",
          "sourcePage": 159
        }
      ]
    }
  ]
