          ],
          "rows": [
            [
              "1–2",
              "Прямо по коридору на 10 фт., затем Т-образный перекрёсток уходит на 10 футов направо и налево"
            ],
            [
              "3–8",
              "20 фт. прямо по коридору"
            ],
            [
              "9–18",
              "Комната (обратитесь к таблице «комната»)"
            ],
            [
              "19",
              "Лестница (обратитесь к таблице «лестница»)"
            ],
            [
              "20",
              "Ложная дверь с ловушкой"
            ]
