---
import { publishedMaterials } from '../../data/materials';
import { leagueRules, type LeagueRuleId } from '../../data/leagueRules';
interface Props { rule: LeagueRuleId }
const { rule } = Astro.props;
const related = publishedMaterials.filter(item => item.errata.some(link => link.href === leagueRules[rule].href));
---
{related.length > 0 && <aside class="related-materials" aria-label="Связанные материалы">
  <p>Связанные материалы:</p>
  <ul>{related.map(item => <li><a href={item.href}>{item.name}{item.parent && ` · ${item.parent}`}</a></li>)}</ul>
</aside>}
<style>
  .related-materials { margin: 1rem 0; padding: .75rem 1rem; border-left: 3px solid var(--primary); }
  p { margin: 0 0 .5rem; }
  ul { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin: 0; padding-left: 1.25rem; }
</style>
