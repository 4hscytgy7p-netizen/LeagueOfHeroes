  function bedsideMannersExpertiseSkills() {
    const selectedWithoutTheory = new Set([
      ...(state.choices['class:skills'] || []),
      ...(state.choices['background:skills'] || []),
      ...(state.choices['species:skill'] || []),
      ...(state.choices['species:adaptiveSkill'] || []),
      ...(state.choices['feat:skills'] || [])
    ]);
    return bedsideMannersSkills().filter((skill) => selectedWithoutTheory.has(skill));
