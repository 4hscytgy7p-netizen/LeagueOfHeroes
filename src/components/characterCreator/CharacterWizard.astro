---
import CreatorSidebar from './CreatorSidebar.astro';
import CharacterPreview from './CharacterPreview.astro';
import NameStep from './steps/NameStep.astro';
import SpeciesStep from './steps/SpeciesStep.astro';
import ClassStep from './steps/ClassStep.astro';
import ClassFeaturesStep from './steps/ClassFeaturesStep.astro';
import BackgroundStep from './steps/BackgroundStep.astro';
import OriginFeatsStep from './steps/OriginFeatsStep.astro';
import SkillsStep from './steps/SkillsStep.astro';
import ExpertiseStep from './steps/ExpertiseStep.astro';
import LanguagesStep from './steps/LanguagesStep.astro';
import ToolsStep from './steps/ToolsStep.astro';
import AbilityStep from './steps/AbilityStep.astro';
import EquipmentStep from './steps/EquipmentShopStep.astro';
import SpellStep from './steps/SpellStep.astro';
import AlignmentStep from './steps/AlignmentStep.astro';
import SummaryStep from './steps/SummaryStep.astro';
import { backgroundsData } from '../../data/backgrounds';
import { featsData } from '../../data/feats';
import { spells } from '../../data/spells';
import { items } from '../../data/items';
import roll20TemplateRaw from '../../data/roll20/blank-2014.json?raw';
import roll20ExportClientRaw from './client/roll20Export.js?raw';
import roll20EquipmentExportClientRaw from './client/roll20EquipmentExport.js?raw';
import characterStateClientRaw from './client/characterState.js?raw';
import allRoll20SpellsRaw from '../../data/roll20/all-spells.json?raw';
import {
  ALL_SKILLS,
  ARTISAN_TOOLS,
  MUSICAL_INSTRUMENTS,
  GAMING_SETS,
  OTHER_TOOLS,
  TRANSPORT_TOOLS,
  ALL_TOOLS,
  STANDARD_LANGUAGES,
  RARE_LANGUAGES
} from './config/proficiencies.ts';
import { EQUIPMENT_PACK_CONTENTS } from './config/equipmentPacks.ts';
import { SPELL_LIMITS } from './config/spellLimits.ts';
import { CLASS_SPELL_NAME_OVERRIDES } from './config/classSpellOverrides.ts';
import { SKILL_ALIASES, CLASS_SKILL_OPTIONS } from './config/skills.ts';
import { GENERIC_BACKGROUND_CHARACTERISTICS } from './config/backgroundCharacteristics.ts';
import { EQUIPMENT_NAME_ALIASES, PACKAGED_EQUIPMENT_NAMES } from './config/equipmentAliases.ts';
import { WEAPON_MASTERY_COUNTS, WEAPON_MASTERY_DESCRIPTIONS, ROGUE_WEAPON_MASTERY_IDS } from './config/weaponMasteries.ts';
import { ROLL20_SKILLS, ROLL20_SKILL_ABILITIES } from './config/roll20Mappings.ts';
import { ALIGNMENTS } from './config/alignments.ts';
import { WEAPON_MASTERY_OPTIONS, BLOOD_CURSE_OPTIONS, buildClassFeatureOptions } from './config/classFeatures.ts';
import { CHARACTER_STORAGE_KEY, CREATOR_STEPS, ABILITY_KEYS, POINT_BUY_COSTS, DEFAULT_CHARACTER_STATE } from './config/creatorState.ts';
import {
  toolOptionsFromDescription,
  languageChoiceCount,
  languageOptionsForSource,
  isCustomLineageEligibleGeneralFeat,
  normalizeSpellName,
  normalizeSpellLevel,
  spellBelongsToClass,
  parseMoneyToCopper,
  parseWeight,
  getEquipmentCategoryGroup
} from './utils/dataPreparation.ts';
import {
  buildBackgroundOptions,
  buildFeatOptions,
  buildCustomLineageGeneralFeatOptions,
  buildFightingStyleOptions,
  buildRoll20RowsByName,
  buildClassSpellOptions,
  buildClassSpellLimits,
  buildEquipmentShopItems
} from './utils/dataBuilders.ts';

interface Props {
  speciesOptions: any[];
  classOptions: any[];
}

const { speciesOptions, classOptions } = Astro.props;
const roll20Template = JSON.parse(roll20TemplateRaw);

let allRoll20SpellsTemplate: any = { character: { attribs: [] } };
try {
  allRoll20SpellsTemplate = JSON.parse(allRoll20SpellsRaw);
} catch (error) {
  console.error('Не удалось прочитать src/data/roll20/all-spells.json. Выбор заклинаний продолжит работать, но карточки заклинаний не будут добавлены в экспорт Roll20.', error);
}




const backgroundOptions = [
  ...buildBackgroundOptions({
    backgroundsData,
    allTools: ALL_TOOLS,
    artisanTools: ARTISAN_TOOLS,
    musicalInstruments: MUSICAL_INSTRUMENTS,
    gamingSets: GAMING_SETS,
    standardLanguages: STANDARD_LANGUAGES,
    rareLanguages: RARE_LANGUAGES,
    toolOptionsFromDescription,
    languageOptionsForSource,
    languageChoiceCount
  }),
  {
    id: 'custom-background',
    name: 'Своя предыстория',
    nameEn: 'Custom Background',
    sourceBook: 'Пользовательская',
    lore: 'Запишите уникальное прошлое героя. Владения, языки и черта происхождения выбираются на следующих общих этапах конструктора.',
    feat: 'Любая черта происхождения',
    skills: '',
    tools: '',
    equipment: 'Определяется игроком и ведущим',
    skillCount: 2,
    toolCount: 1,
    languageText: '',
    languageCount: 0,
    variants: null,
    characteristics: null,
    isCustom: true
  }
];

const featOptions = buildFeatOptions(featsData);



const customLineageGeneralFeatOptions =
  buildCustomLineageGeneralFeatOptions(
    featsData,
    isCustomLineageEligibleGeneralFeat
  );

const allSelectableFeatOptions = [...featOptions, ...customLineageGeneralFeatOptions];

const backgroundSpecialFeatIds = new Set([
  'strike-of-the-giants',
  'squire-of-solamnia',
  'vampires-plaything',
  'initiate-of-high-sorcery',
  'scion-of-the-outer-planes'
]);

const backgroundSpecialFeatOptions = featsData
  .filter((item: any) => backgroundSpecialFeatIds.has(item.id))
  .map((item: any) => ({
    id: item.id,
    name: item.name,
    nameEn: item.nameEn,
    type: item.type,
    requirements: Array.isArray(item.requirements) ? item.requirements : [],
    effects: Array.isArray(item.effects) ? item.effects : [],
    abilityScoreIncrease: Array.isArray(item.abilityScoreIncrease)
      ? item.abilityScoreIncrease
      : []
  }));

const allResolvedFeatOptions = Array.from(
  new Map(
    [...allSelectableFeatOptions, ...backgroundSpecialFeatOptions]
      .map((feat: any) => [feat.id, feat])
  ).values()
);

const fightingStyleOptions = buildFightingStyleOptions(featsData);


const weaponMasteryOptions = [...WEAPON_MASTERY_OPTIONS];
const rogueWeaponMasteryIds = [...ROGUE_WEAPON_MASTERY_IDS];



const bloodCurseOptions = [...BLOOD_CURSE_OPTIONS];


const classFeatureOptions = buildClassFeatureOptions(fightingStyleOptions);

const apothecaryClass = classOptions.find((item: any) => item.id === 'apothecary');
const esotericTheories = apothecaryClass?.features?.find((feature: any) =>
  /эзотерическ.*теори/i.test(String(feature?.name || ''))
);
const firstLevelTheories = (esotericTheories?.collapsible || [])
  .filter((theory: any) => !/требования\s*:/i.test(String(theory?.description || '')))
  .map((theory: any, index: number) => ({
    id: `apothecary-theory-${index + 1}`,
    name: theory.title,
    description: theory.description,
    exportDescription: theory.description,
    href: '/classes/apothecary#feature-эзотерические-теории-1',
    effects: theory.title === 'Боевой медик'
      ? [
          { type: 'weaponProficiency', categories: ['Воинское оружие'] },
          { type: 'armorTraining', categories: ['Щиты'] }
        ]
      : []
  }));

if (firstLevelTheories.length) {
  classFeatureOptions.apothecary = [{
    id: 'esoteric-theory',
    name: 'Эзотерическая теория',
    count: 1,
    description: 'Выберите одну эзотерическую теорию, доступную Апотекарию на 1 уровне.',
    href: '/classes/apothecary#feature-эзотерические-теории-1',
    options: firstLevelTheories
  }];
}

const roll20RowsByName = buildRoll20RowsByName(
  allRoll20SpellsTemplate,
  normalizeSpellName
);



const classSpellOptions = buildClassSpellOptions({
  classOptions,
  spells,
  classSpellNameOverrides: CLASS_SPELL_NAME_OVERRIDES,
  normalizeSpellLevel,
  normalizeSpellName,
  spellBelongsToClass,
  roll20RowsByName
});

// «Посвящённый в магию» должен экспортировать те же полноценные строки
// Roll20, что и классовые заклинания. Сокращённые объекты без
// roll20Attributes оставляли карточки заклинаний почти пустыми.
const magicInitiateSpellOptions = Object.fromEntries(
  ['cleric', 'druid', 'wizard'].map((classId) => [
    classId,
    [...(classSpellOptions[classId] || [])]
  ])
);

const classSpellLimits = buildClassSpellLimits({
  classOptions,
  spellLimits: SPELL_LIMITS,
  normalizeSpellName
});





const equipmentShopItems = buildEquipmentShopItems({
  items,
  getEquipmentCategoryGroup,
  parseMoneyToCopper,
  parseWeight
});

const creatorOptions = {
  allSkills: [...ALL_SKILLS],
  allTools: [...ALL_TOOLS],
  artisanTools: [...ARTISAN_TOOLS],
  musicalTools: [...MUSICAL_INSTRUMENTS],
  transportTools: [...TRANSPORT_TOOLS],
  standardLanguages: [...STANDARD_LANGUAGES],
  rareLanguages: [...RARE_LANGUAGES]
};
---

<div class="character-wizard" id="character-wizard">
  <header class="wizard-header">
    <div>
      <span class="wizard-kicker">Кузница героев</span>
      <h1>Создание персонажа</h1>
      <p>Собери героя шаг за шагом. Черновик сохраняется автоматически.</p>
      <div class="forge-theme-status" id="forge-theme-status" aria-live="polite">
        Облик кузницы изменится вместе с героем
      </div>
    </div>
    <button type="button" class="button button-secondary" id="reset-character">
      Начать заново
    </button>
  </header>

  <div class="wizard-layout">
    <CreatorSidebar />

    <main class="wizard-main">
      <NameStep />
      <SpeciesStep speciesOptions={speciesOptions} />

      <ClassStep classOptions={classOptions} />
      <ClassFeaturesStep />
      <AlignmentStep />
      <BackgroundStep backgroundOptions={backgroundOptions} />
      <OriginFeatsStep featOptions={featOptions} />
      <SkillsStep />
      <ExpertiseStep />
      <LanguagesStep />
      <ToolsStep />
      <EquipmentStep />

      <AbilityStep />
      <SpellStep />
      <SummaryStep />

      <footer class="wizard-footer">
        <button class="button button-secondary" type="button" id="previous-step">
          ← Назад
        </button>
        <span id="step-counter">Шаг 1 из 5</span>
        <button class="button button-primary" type="button" id="next-step">
          Продолжить →
        </button>
      </footer>
    </main>

    <CharacterPreview />
  </div>
</div>

<script is:inline set:html={roll20ExportClientRaw}></script>
<script is:inline set:html={roll20EquipmentExportClientRaw}></script>
<script is:inline set:html={characterStateClientRaw}></script>

<script define:vars={{ speciesOptions, classOptions, backgroundOptions, featOptions, customLineageGeneralFeatOptions, allSelectableFeatOptions, backgroundSpecialFeatOptions, allResolvedFeatOptions, magicInitiateSpellOptions, creatorOptions, roll20Template, classSpellOptions, classSpellLimits, classFeatureOptions, weaponMasteryOptions, rogueWeaponMasteryIds, bloodCurseOptions, WEAPON_MASTERY_COUNTS, WEAPON_MASTERY_DESCRIPTIONS, equipmentShopItems, EQUIPMENT_PACK_CONTENTS, SKILL_ALIASES, CLASS_SKILL_OPTIONS, GENERIC_BACKGROUND_CHARACTERISTICS, EQUIPMENT_NAME_ALIASES, PACKAGED_EQUIPMENT_NAMES, ROLL20_SKILLS, ROLL20_SKILL_ABILITIES, ALIGNMENTS, CHARACTER_STORAGE_KEY, CREATOR_STEPS, ABILITY_KEYS, POINT_BUY_COSTS, DEFAULT_CHARACTER_STATE }}>
  const STORAGE_KEY = CHARACTER_STORAGE_KEY;
  const steps = [...CREATOR_STEPS];
  const abilityKeys = [...ABILITY_KEYS];
  const COST_TABLE = { ...POINT_BUY_COSTS };
  const defaultState = structuredClone(DEFAULT_CHARACTER_STATE);

  let state = structuredClone(defaultState);

  const $ = (selector) => document.querySelector(selector);
  const $$ = (selector) => Array.from(document.querySelectorAll(selector));

  function captureWizardScrollState() {
    const root = $('#character-wizard');
    if (!root) return null;

    const positions = [root, ...root.querySelectorAll('*')]
      .filter((element) => element.scrollTop > 0 || element.scrollLeft > 0)
      .map((element) => {
        if (element.id) {
          return { type: 'id', value: element.id, index: 0, top: element.scrollTop, left: element.scrollLeft };
        }
        const className = Array.from(element.classList || [])[0];
        if (!className) return null;
        const matches = Array.from(root.getElementsByClassName(className));
        return {
          type: 'class',
          value: className,
          index: matches.indexOf(element),
          top: element.scrollTop,
          left: element.scrollLeft
        };
      })
      .filter(Boolean);

    return { windowX: window.scrollX, windowY: window.scrollY, positions };
  }

  function restoreWizardScrollState(snapshot) {
    if (!snapshot) return;
    const root = $('#character-wizard');
    if (!root) return;

    for (const position of snapshot.positions) {
      const element = position.type === 'id'
        ? document.getElementById(position.value)
        : root.getElementsByClassName(position.value)[position.index];
      if (!element) continue;
      element.scrollTop = position.top;
      element.scrollLeft = position.left;
    }
    window.scrollTo(snapshot.windowX, snapshot.windowY);
  }

  function preserveWizardScrollAfterRender() {
    const snapshot = captureWizardScrollState();
    requestAnimationFrame(() => {
      restoreWizardScrollState(snapshot);
      requestAnimationFrame(() => restoreWizardScrollState(snapshot));
    });
  }

  const escapeHtml = (value) => String(value ?? '').replace(
    /[&<>'"]/g,
    (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;'
    }[char])
  );
  const SKILL_ABILITY_SHORT = {
    'Акробатика': 'Лов',
    'Расследование': 'Инт',
    'Атлетика': 'Сил',
    'Восприятие': 'Мдр',
    'Выживание': 'Мдр',
    'Выступление': 'Хар',
    'Запугивание': 'Хар',
    'История': 'Инт',
    'Ловкость рук': 'Лов',
    'Магия': 'Инт',
    'Медицина': 'Мдр',
    'Обман': 'Хар',
    'Природа': 'Инт',
    'Проницательность': 'Мдр',
    'Религия': 'Инт',
    'Скрытность': 'Лов',
    'Убеждение': 'Хар',
    'Уход за животными': 'Мдр'
  };
  const normalizeSkillName = (value) => ({
    'Анализ': 'Расследование',
    'Внимательность': 'Восприятие'
  })[value] || value;
  const skillDisplayName = (skill) =>
    `${normalizeSkillName(skill)} (${SKILL_ABILITY_SHORT[normalizeSkillName(skill)] || '—'})`;
  const skillListDisplay = (value) => {
    const text = String(value || '').trim();
    if (!text) return '—';
    const parts = text.split(',').map((part) => normalizeSkillName(part.trim())).filter(Boolean);
    return parts.length && parts.every((part) => creatorOptions.allSkills.includes(part))
      ? parts.map(skillDisplayName).join(', ')
      : text;
  };

  function normalizeSpellNameClient(value) {
    return String(value || '')
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е')
      .replace(/\[[^\]]*\]/g, ' ')
      .replace(/[^a-zа-я0-9]+/gi, ' ')
      .trim();
  }

  function getStateModule() {
    const stateModule = window.CharacterCreatorState;
    if (!stateModule) {
      throw new Error('Модуль состояния персонажа не загрузился.');
    }
    return stateModule;
  }

  function loadState() {
    state = getStateModule().loadState(
      STORAGE_KEY,
      defaultState,
      abilityKeys
    );
    Object.keys(state.choices || {}).forEach((key) => {
      if (Array.isArray(state.choices[key])) {
        state.choices[key] = state.choices[key].map(normalizeSkillName);
      }
    });
    if (Array.isArray(state.customBackground?.skills)) {
      state.customBackground.skills = state.customBackground.skills.map(normalizeSkillName);
    }
    if (state.background === 'custom-background' && state.customBackground) {
      const custom = state.customBackground;
      if (!custom.selectionsMigrated) {
        if (!(state.choices['background:skills'] || []).length && Array.isArray(custom.skills)) {
          state.choices['background:skills'] = custom.skills.slice(0, 2);
        }
        if (!(state.choices['background:tools'] || []).length && Array.isArray(custom.tools)) {
          state.choices['background:tools'] = custom.tools.slice(0, 1);
        }
        if (!(state.choices['languages:selected'] || []).length && Array.isArray(custom.languages)) {
          state.choices['languages:selected'] = custom.languages.slice(0, 2);
        }
        if (!(state.choices['background:originFeat'] || []).length && custom.featId) {
          state.choices['background:originFeat'] = [custom.featId];
        }
        custom.selectionsMigrated = true;
        custom.skills = [];
        custom.tools = [];
        custom.languages = [];
        custom.featId = '';
      }
    }
  }

  function saveState() {
    getStateModule().saveState(STORAGE_KEY, state);
    window.dispatchEvent(new CustomEvent('loh:character-state-changed', {
      detail: { state: structuredClone(state) }
    }));
  }

  function isCoreElfSpecies(species) {
    const identity = `${species?.id || ''} ${species?.name || ''} ${species?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
    return /(?:^|[\s_-])elf(?:$|[\s_-])|(?:^|\s)эльф(?:$|\s)/.test(identity)
      && !/eladrin|эладрин|shadar[\s_-]?kai|шадар[\s-]?кай|half[\s_-]?elf|полуэльф|horavar|хоравар/.test(identity);
  }

  function isCoreTieflingSpecies(species) {
    return /tiefling|тифлинг/.test(`${species?.id || ''} ${species?.name || ''} ${species?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е'));
  }

  function isCoreGnomeSpecies(species) {
    const identity = `${species?.id || ''} ${species?.name || ''} ${species?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
    return /(?:^|[\s_-])gnome(?:$|[\s_-])|(?:^|\s)гном(?:$|\s)/.test(identity)
      && !/deep[\s_-]?gnome|глубинн(?:ый|ого)\s+гном|svirfneblin|свирфнеблин|autognome|автогном/.test(identity);
  }


  function isCoreGithSpecies(species) {
    const identity = `${species?.id || ''} ${species?.name || ''} ${species?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
    return /(?:^|[\s_-])gith(?:$|[\s_-])|(?:^|\s)гит(?:$|[\s-])/.test(identity)
      && !/githyanki|гитъянк|githzerai|гитцера/.test(identity);
  }

  function isCoreGenasiSpecies(species) {
    const identity = `${species?.id || ''} ${species?.name || ''} ${species?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
    return /genasi|дженази/.test(identity)
      && !/air[\s_-]?genasi|воздушн|earth[\s_-]?genasi|землян|fire[\s_-]?genasi|огненн|water[\s_-]?genasi|водн/.test(identity);
  }

  function speciesRequiresVariant(species = findSpecies()) {
    return species?.variantMode === 'required'
      || isCoreElfSpecies(species)
      || isCoreTieflingSpecies(species)
      || isCoreGnomeSpecies(species)
      || isCoreGithSpecies(species)
      || isCoreGenasiSpecies(species);
  }

  function activeSpeciesFeatureText(species = findSpecies(), variant = findVariant(species)) {
    return getEffectiveAbilities(species, variant)
      .map((ability) => `${ability?.title || ''} ${ability?.description || ''}`)
      .join(' ')
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
  }

  function speciesNeedsSpellAbility(species = findSpecies(), variant = findVariant(species)) {
    if (!species || (speciesRequiresVariant(species) && !variant)) return false;
    const text = activeSpeciesFeatureText(species, variant);
    return text.includes('интеллект')
      && text.includes('мудрость')
      && text.includes('харизма')
      && /выбер|выберите/.test(text)
      && /заклинательн|базов.+характерист/.test(text);
  }

  function isDragonbornSpecies(species = findSpecies()) {
    const identity = `${species?.id || ''} ${species?.name || ''} ${species?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
    return /dragonborn|драконорожденн/.test(identity);
  }

  function dragonAncestryOptions(species = findSpecies(), variant = findVariant(species)) {
    if (!isDragonbornSpecies(species)) return [];
    const table = getEffectiveAbilities(species, variant).find((ability) =>
      /происхождени[ея]\s+драконов.*таблиц/i.test(String(ability?.title || ''))
    );
    if (!table?.description) return [];
    return String(table.description)
      .split(/\r?\n/)
      .slice(1)
      .map((row) => row.split('\t').map((cell) => cell.trim()))
      .filter((cells) => cells.length >= 2 && cells[0] && cells[1])
      .map(([name, damage]) => ({ id: `${name}:${damage}`, name, damage }));
  }

  function speciesCantripChoice(species = findSpecies(), variant = findVariant(species)) {
    const identity = `${species?.id || ''} ${species?.name || ''} ${variant?.id || ''} ${variant?.name || ''} ${variant?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
    if (/astral|астральн/.test(identity) && /elf|эльф/.test(identity)) {
      return {
        title: 'Заговор астрального эльфа',
        options: ['Пляшущие огоньки', 'Свет', 'Священное пламя']
      };
    }
    if (/halfelf|half-elf|полуэльф/.test(identity) && /lunar|solar|лунн|солнечн/.test(identity)) {
      return {
        title: 'Заговор волшебника',
        options: uniqueSpells((classSpellOptions.wizard || []).filter((spell) => spell.level === 'cantrip'))
          .map((spell) => spell.name)
      };
    }
    return null;
  }

  function isKhoravarVariant(species = findSpecies(), variant = findVariant(species)) {
    const identity = `${species?.id || ''} ${species?.name || ''} ${variant?.id || ''} ${variant?.name || ''} ${variant?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
    return /хоравар|khoravar/.test(identity);
  }

  function isWoodHalfElfVariant(species = findSpecies(), variant = findVariant(species)) {
    const identity = `${species?.id || ''} ${species?.name || ''} ${species?.nameEn || ''} ${variant?.id || ''} ${variant?.name || ''} ${variant?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
    return /halfelf|half-elf|полуэльф/.test(identity)
      && /(?:^|[\s_-])wood(?:$|[\s_-])|лесной/.test(identity);
  }

  const ADAPTIVE_WEAPONS = [
    'Боевой топор', 'Булава', 'Длинное копьё', 'Длинный лук', 'Длинный меч',
    'Дубинка', 'Кинжал', 'Короткий лук', 'Короткий меч', 'Копьё',
    'Лёгкий арбалет', 'Молот', 'Палица', 'Рапира', 'Ручной топор',
