  function bindSpeciesDetailEvents() {
    const species = findSpecies();
    if (!species) return;

    $('#change-species')?.addEventListener('click', () => {
      $('#species-picker')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    $('#species-variant-select')?.addEventListener('change', (event) => {
      const previousTop = event.currentTarget.getBoundingClientRect().top;
      state.speciesVariant = event.currentTarget.value || null;
      state.choices['species:elfTranceProficiencyType'] = [];
      state.choices['species:eladrinSeason'] = [];
      state.choices['species:skill'] = [];
      state.choices['species:tools'] = [];
      state.choices['species:spellAbility'] = [];
      state.choices['species:cantrip'] = [];
      state.choices['species:dragonAncestry'] = [];
      state.choices['species:khoravarProficiencyType'] = [];
      state.choices['species:woodHalfElfLegacy'] = [];
      state.choices['species:adaptiveSkill'] = [];
      state.choices['species:adaptiveProficiencies'] = [];
      state.physique.heightModifier = null;
      state.physique.weightMultiplier = null;
      renderSpeciesDetails();
      const nextSelect = $('#species-variant-select');
      if (nextSelect) {
        nextSelect.focus({ preventScroll: true });
        const offset = nextSelect.getBoundingClientRect().top - previousTop;
        if (Math.abs(offset) > 0.5) window.scrollBy(0, offset);
      }
    });


    $$('[name="custom-lineage-feature"]').forEach((input) => input.addEventListener('change', () => {
      if (!input.checked) return;
      state.choices['species:customLineageFeature'] = [input.value];
      if (input.value !== 'skill') state.choices['species:skill'] = [];
      saveState();
      renderSpeciesDetails();
      updatePreview();
    }));

    $$('[name="kobold-legacy"]').forEach((input) => input.addEventListener('change', () => {
      if (!input.checked) return;
      state.choices['species:koboldLegacy'] = [input.value];
      if (input.value !== 'cunning') state.choices['species:skill'] = [];
      saveState();
      renderSpeciesDetails();
      updatePreview();
    }));

    $$('[name="elf-trance-proficiency"]').forEach((input) => input.addEventListener('change', () => {
      if (!input.checked) return;
      state.choices['species:elfTranceProficiencyType'] = [input.value];
      if (input.value === 'skill') state.choices['species:tools'] = [];
      else state.choices['species:skill'] = [];
      saveState();
      renderSpeciesDetails();
      updatePreview();
    }));

    $$('[name="eladrin-season"]').forEach((input) => input.addEventListener('change', () => {
      if (!input.checked) return;
      state.choices['species:eladrinSeason'] = [input.value];
      saveState();
      renderSpeciesDetails();
      updatePreview();
    }));

    $$('[name="species-spell-ability"]').forEach((input) => input.addEventListener('change', () => {
      if (!input.checked) return;
      state.choices['species:spellAbility'] = [input.value];
      saveState();
      renderSpeciesDetails();
      updatePreview();
    }));

    $$('[name="dragon-ancestry"]').forEach((input) => input.addEventListener('change', () => {
      if (!input.checked) return;
      state.choices['species:dragonAncestry'] = [input.value];
      saveState();
      renderSpeciesDetails();
      updatePreview();
    }));

    $('#species-cantrip-select')?.addEventListener('change', (event) => {
      state.choices['species:cantrip'] = event.target.value ? [event.target.value] : [];
      saveState();
      renderSpeciesDetails();
      updatePreview();
    });

    $$('[name="khoravar-proficiency"]').forEach((input) => input.addEventListener('change', () => {
      if (!input.checked) return;
      state.choices['species:khoravarProficiencyType'] = [input.value];
      if (input.value === 'skill') state.choices['species:tools'] = [];
      else state.choices['species:skill'] = [];
      saveState();
      renderSpeciesDetails();
      updatePreview();
    }));

    $$('[name="wood-halfelf-legacy"]').forEach((input) => input.addEventListener('change', () => {
      if (!input.checked) return;
      state.choices['species:woodHalfElfLegacy'] = [input.value];
      saveState();
      renderSpeciesDetails();
      updatePreview();
    }));

    $('#adaptive-species-skill')?.addEventListener('change', (event) => {
      state.choices['species:adaptiveSkill'] = event.target.value ? [event.target.value] : [];
      saveState();
      renderSpeciesDetails();
      updatePreview();
    });

    $('#adaptive-species-flexible')?.addEventListener('change', (event) => {
      const limit = adaptiveSpeciesProficiencyConfig()?.flexibleCount || 0;
      state.choices['species:adaptiveProficiencies'] = Array.from(event.target.selectedOptions)
        .map((option) => option.value)
        .slice(0, limit);
      saveState();
      renderSpeciesDetails();
      updatePreview();
    });

    $('#size-select')?.addEventListener('change', (event) => {
      state.physique.size = event.target.value;
      state.physique.heightModifier = null;
      state.physique.weightMultiplier = null;
      renderSpeciesDetails();
    });

    function updatePhysiqueControls() {
      const heightSlider = $('#height-slider');
      const weightSlider = $('#weight-slider');
      const result = calculatePhysique(species);
      if (!result) return;

      if (heightSlider) {
        heightSlider.style.setProperty(
          '--progress',
          `${rangeProgress(
            state.physique.heightModifier,
            Number(heightSlider.min),
            Number(heightSlider.max)
          )}%`
        );
      }

      if (weightSlider) {
        weightSlider.style.setProperty(
          '--progress',
          `${rangeProgress(
            state.physique.weightMultiplier,
            Number(weightSlider.min),
            Number(weightSlider.max)
          )}%`
        );
      }

      const heightModifierValue = $('#height-modifier-value');
      const heightResultValue = $('#height-result-value');
      const heightResultNote = $('#height-result-note');
      const weightMultiplierValue = $('#weight-multiplier-value');
      const weightResultValue = $('#weight-result-value');

      if (heightModifierValue) {
        heightModifierValue.textContent = `+${state.physique.heightModifier}″`;
      }
      if (heightResultValue) {
        heightResultValue.textContent = `${result.feet}′ ${result.inches}″`;
      }
      if (heightResultNote) {
        heightResultNote.textContent = `${result.totalInches} дюймов`;
      }
      if (weightMultiplierValue) {
        weightMultiplierValue.textContent = `×${state.physique.weightMultiplier}`;
      }
      if (weightResultValue) {
        weightResultValue.textContent = `${result.weight} фун.`;
      }

      updatePreview();
      saveState();
    }

    $('#height-slider')?.addEventListener('input', (event) => {
      state.physique.heightModifier = Number(event.target.value);
      updatePhysiqueControls();
    });

    $('#weight-slider')?.addEventListener('input', (event) => {
      state.physique.weightMultiplier = Number(event.target.value);
      updatePhysiqueControls();
    });

    $('#randomise-size')?.addEventListener('click', () => {
      const current = getSizeEntry(species, state.physique.size) || {};
      const heightRange = current.heightRange || [0, 0];
      const weightRange = current.weightRange || [0, 0];

      state.physique.heightModifier =
        rollDice(current.heightDice)
        ?? (
          Math.floor(
            Math.random() *
              (Number(heightRange[1] || 0) - Number(heightRange[0] || 0) + 1)
          ) + Number(heightRange[0] || 0)
        );

      state.physique.weightMultiplier =
        rollDice(current.weightDice)
        ?? (
          Math.floor(
            Math.random() *
              (Number(weightRange[1] || 0) - Number(weightRange[0] || 0) + 1)
          ) + Number(weightRange[0] || 0)
        );

      const heightSlider = $('#height-slider');
      const weightSlider = $('#weight-slider');

      if (heightSlider) {
        heightSlider.value = String(state.physique.heightModifier);
      }
      if (weightSlider) {
        weightSlider.value = String(state.physique.weightMultiplier);
      }

      updatePhysiqueControls();
    });
  }

  function renderClassDetails() {
    const container = $('#class-details');
    const characterClass = findClass();
    if (!container) return;

    if (!characterClass) {
      container.innerHTML = `
        <div class="empty-state class-empty-state">
          <span>⚔</span>
          <h3>Выбери класс</h3>
          <p>После выбора здесь появятся описание, владения и способности первого уровня.</p>
        </div>
      `;
      return;
    }

    const level1 = characterClass.level1 || {};
    const proficiencies = characterClass.proficiencies || {};
    const tools = Array.isArray(proficiencies.tools) ? proficiencies.tools : [];
    const armor = Array.isArray(proficiencies.armor) ? proficiencies.armor : [];
    const weapons = Array.isArray(proficiencies.weapons) ? proficiencies.weapons : [];
    const saves = Array.isArray(proficiencies.savingThrows) ? proficiencies.savingThrows : [];

    container.innerHTML = `
      <article class="class-profile">
        <header class="class-hero">
          <div class="class-hero-copy">
            <div class="class-title-row">
              <div>
                <span class="source-label">${escapeHtml(characterClass.sourceBook || 'Источник не указан')}</span>
                <h2>${escapeHtml(characterClass.name)} <small>[${escapeHtml(characterClass.nameEn || '')}]</small></h2>
              </div>
              <button class="button button-secondary button-small" type="button" id="change-class">Изменить</button>
            </div>
          </div>
          <div class="class-hero-image">
            <img src="${escapeHtml(characterClass.portrait || '')}" alt="" />
            <span></span>
          </div>
        </header>

        <details class="content-section full-lore class-lore-disclosure">
          <summary>Показать описание</summary>
          <div class="full-lore-content">${loreToHtml(characterClass.description)}</div>
        </details>

        <section class="class-stats">
          <div><span>Кость хитов</span><strong>к${escapeHtml(characterClass.hitDice)}</strong></div>
          <div><span>Основная характеристика</span><strong>${escapeHtml(characterClass.primaryAbility || '—')}</strong></div>
          <div><span>Спасброски</span><strong>${escapeHtml(saves.join(', ') || '—')}</strong></div>
        </section>

        <section class="content-section class-proficiencies">
          <div class="content-section-heading">
            <span class="section-icon">◆</span>
            <div><span class="section-kicker">Подготовка</span><h3>Владения первого уровня</h3></div>
          </div>
          <div class="proficiency-grid">
            <article><span>Хиты</span><strong>${escapeHtml(characterClass.hitPoints?.level1 || '—')}</strong></article>
            <article><span>Доспехи</span><strong>${escapeHtml(armor.join(', ') || 'Нет')}</strong></article>
            <article><span>Оружие</span><strong>${escapeHtml(weapons.join(', ') || 'Нет')}</strong></article>
            <article><span>Инструменты</span><strong>${escapeHtml(tools.join(', ') || 'Нет')}</strong></article>
            <article><span>Навыки</span><strong>${escapeHtml(proficiencies.skills?.count ?? 0)} на выбор</strong></article>
            <article><span>Бонус мастерства</span><strong>${escapeHtml(level1.profBonus || '+2')}</strong></article>
