  .spell-availability-source {
    display: block;
    margin-top: .18rem;
    color: var(--wizard-gold);
    font-size: .68rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: .03em;
  }

  .spell-fixed p {
    display: grid;
    gap: .12rem;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 1340px) {
    .wizard-layout {
      grid-template-columns: 190px minmax(0, 1fr);
    }

    .character-preview {
      grid-column: 2;
      position: static;
      display: grid;
      grid-template-columns: minmax(160px, 210px) minmax(0, 1fr);
      align-items: stretch;
    }

    .character-preview .preview-portrait {
      min-height: 210px;
      height: 100%;
    }

    .character-preview .preview-content {
      align-self: center;
      margin-top: 0;
      padding: 1.1rem 1.25rem;
    }

    .character-preview .preview-content h2 {
      margin-bottom: .75rem;
    }
  }

  @media (max-width: 760px) {
    .character-wizard {
      width: 100%;
    }

    .character-wizard::before {
      opacity: .56;
    }

    .character-wizard::after {
      top: 7rem;
      right: .5rem;
      font-size: 9rem;
      opacity: .035;
    }

    .wizard-layout::after {
      opacity: .16;
      background-size: 58px 58px, 58px 58px;
    }

    .wizard-header {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
      padding: 1rem .85rem 1.25rem;
    }

    .wizard-header h1 {
      margin: .25rem 0 .55rem;
      font-size: clamp(2.15rem, 12vw, 3.35rem);
      line-height: .98;
    }

    .wizard-header p {
      font-size: .9rem;
      line-height: 1.5;
    }

    .wizard-header::before {
      inset: -.25rem -.35rem .25rem;
      opacity: .62;
    }

    .wizard-header .button {
      width: 100%;
    }

    .wizard-layout {
      display: block;
      padding: .65rem 0 0;
    }

    .creator-sidebar {
      margin-bottom: .65rem;
    }

    .wizard-main {
      border-radius: .7rem;
    }

    .wizard-step {
      min-height: 0;
      padding: 1.1rem .9rem 1.3rem;
    }

    .wizard-step > div:first-child h2 {
      max-width: 100%;
      font-size: clamp(1.75rem, 9vw, 2.3rem);
      line-height: 1.05;
      overflow-wrap: anywhere;
    }

    .wizard-step > div:first-child p {
      font-size: .88rem;
      line-height: 1.55;
    }

    .wizard-footer {
      position: sticky;
      bottom: 0;
      z-index: 30;
      gap: .45rem;
      padding: .72rem;
      background: color-mix(in srgb, var(--card-bg) 96%, var(--background));
      box-shadow: 0 -10px 24px rgba(0,0,0,.2);
    }

    .wizard-footer .button {
      min-height: 44px;
      padding: .62rem .72rem;
      font-size: .78rem;
    }

    .wizard-footer > span {
      flex: 0 0 auto;
      font-size: .68rem;
    }

    .character-preview {
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      margin-top: .75rem;
    }

    .character-preview .preview-portrait {
      min-height: 150px;
    }

    .character-preview .preview-content {
      padding: .8rem .85rem;
    }

    .character-preview .preview-kicker {
      font-size: .58rem;
    }

    .character-preview .preview-content h2 {
      margin: .2rem 0 .55rem;
      font-size: 1.12rem;
    }

    .character-preview .preview-content dl {
      gap: .3rem;
    }

    .character-preview .preview-content dl > div {
      gap: .45rem;
      padding-bottom: .28rem;
      font-size: .72rem;
    }

    .species-hero,
    .class-hero {
      grid-template-columns: 1fr;
    }

    .species-hero-image,
    .class-hero-image {
      order: -1;
      min-height: 220px;
    }

    .species-hero-image span,
    .class-hero-image span {
      background: linear-gradient(0deg, var(--card-bg), transparent 45%);
    }

    .species-title-row,
    .class-title-row {
      align-items: stretch;
      flex-direction: column;
    }

    .species-stats,
    .class-stats,
    .proficiency-grid,
    .traits-list,
    .background-stats,
    .background-reward-grid,
    .background-characteristic-grid {
      grid-template-columns: 1fr;
    }

    .class-grid {
      grid-template-columns: 1fr;
      max-height: 520px;
      padding-right: .25rem;
    }

    .class-card {
      grid-template-columns: 118px minmax(0, 1fr);
      grid-template-rows: 148px;
      min-height: 148px;
    }

    .class-card-image {
      height: 148px;
    }

    .class-card-copy {
      align-content: center;
      border-top: 0;
      border-left: 1px solid color-mix(in srgb, var(--wizard-gold) 20%, var(--card-border));
    }

    .class-card-meta {
      align-items: flex-start;
      gap: .3rem;
    }

    .class-card-meta small {
      max-width: 100%;
      text-align: left;
      white-space: normal;
    }

    .ability-grid,
    .alignment-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .65rem;
    }

    .ability-card {
      padding: .85rem .6rem;
    }

    .points-summary {
      gap: .55rem;
    }

    .points-summary strong {
      flex: 1 1 150px;
      padding: .6rem .7rem;
      font-size: .8rem;
    }

    .content-section-heading.size-heading {
      align-items: stretch;
      flex-direction: column;
    }

    .background-hero { grid-template-columns: 1fr; }
    .background-rune { justify-self: start; width: 72px; height: 72px; font-size: 2.5rem; }
    .custom-background-grid { grid-template-columns: 1fr; }
    .custom-background-wide { grid-column: auto; }
    .custom-characteristic-grid { grid-template-columns: 1fr; }

    .result-row {
      grid-template-columns: 1fr;
    }

    .result-row strong {
      grid-row: auto;
      grid-column: auto;
      margin-top: 0.2rem;
    }

    .spell-table-list p {
      grid-template-columns: 1fr;
      gap: .25rem;
    }

    .characteristic-option-row {
      grid-template-columns: auto 1.75rem minmax(0, 1fr);
      gap: .55rem;
    }

    .alignment-requirement,
    .characteristic-option-row small {
      grid-column: 3;
      justify-self: start;
      white-space: normal;
    }

    .final-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .final-stats div:nth-child(3n) {
      border-right: 0;
    }

    .final-resource-heading,
    .final-resource-grid article,
    .final-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .final-actions .button {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .character-preview {
      grid-template-columns: 88px minmax(0, 1fr);
    }

    .character-preview .preview-portrait {
      height: auto;
      min-height: 145px;
    }

    .ability-grid,
    .alignment-grid {
      grid-template-columns: 1fr;
    }

    .final-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .final-stats div:nth-child(3n) {
      border-right: 1px solid var(--card-border);
    }

    .final-stats div:nth-child(2n) {
      border-right: 0;
    }
  }

