  function preferredRequiredVariantId(species) {
    const variants = Array.isArray(species?.variants) ? species.variants : [];
    if (!variants.length) return null;

    const findByIdentity = (patterns) => {
      const found = variants.find((variant) => {
        const identity = `${variant?.id || ''} ${variant?.name || ''} ${variant?.nameEn || ''}`
          .toLocaleLowerCase('ru')
          .replace(/ё/g, 'е');
        return patterns.some((pattern) => pattern.test(identity));
      });
      return found?.id || null;
    };

    if (isCoreGithSpecies(species)) {
      return findByIdentity([/githyanki/, /гитъянк/]) || variants[0]?.id || null;
    }
    if (isCoreGenasiSpecies(species)) {
      return findByIdentity([/air[\s_-]?genasi/, /воздушн(?:ый|ого)?\s+дженази/, /дженази\s+воздух/]) || variants[0]?.id || null;
    }
    return null;
  }

