  function ensureSpeciesResourceState() {
    if (!state.resources || typeof state.resources !== 'object') state.resources = {};
    const resources = getSpeciesResources();
    for (const resource of resources) {
      const value = Number(state.resources[resource.id]);
      if (!Number.isFinite(value)) state.resources[resource.id] = resource.maximum;
      else state.resources[resource.id] = Math.max(0, Math.min(resource.maximum, value));
    }
    return resources;
  }

  function bindSummaryResourceControls() {
    $$('[data-resource-action]').forEach((button) => button.addEventListener('click', () => {
      const resource = ensureSpeciesResourceState().find((item) => item.id === button.dataset.resourceId);
      if (!resource) return;
      const change = button.dataset.resourceAction === 'spend' ? -1 : 1;
      state.resources[resource.id] = Math.max(0, Math.min(resource.maximum, Number(state.resources[resource.id]) + change));
      saveState();
      renderSummary();
    }));
    $$('[data-rest-type]').forEach((button) => button.addEventListener('click', () => {
      const rest = button.dataset.restType;
      for (const resource of ensureSpeciesResourceState()) {
        if (rest === 'long' || resource.rest === 'short') state.resources[resource.id] = resource.maximum;
      }
      saveState();
      renderSummary();
    }));
  }

