  function downloadJson(payload, suffix = '') {
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${safeFileName(state.name)}${suffix}.json`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 0);
  }

  function ageDescription(value) {
    const age = Number(value);
    if (!Number.isFinite(age) || age <= 0) return 'не указан';
    const lastTwo = age % 100;
    const last = age % 10;
    const unit = lastTwo >= 11 && lastTwo <= 14
      ? 'лет'
      : last === 1
        ? 'год'
        : last >= 2 && last <= 4
          ? 'года'
          : 'лет';
    return `${age} ${unit}`;
  }

  function createCharacterDescription() {
    const species = findSpecies();
    const variant = findVariant(species);
    const characterClass = findClass();
    const background = findBackground();
    const name = String(state.name || 'Безымянный герой').trim() || 'Безымянный герой';
    const speciesName = [species?.name, variant?.name].filter(Boolean).join(' — ') || 'не указана';
    const traits = (state.choices['background:traits'] || [])
      .map((value) => String(value || '').trim())
      .filter(Boolean)
      .join(' ');
    const ideal = String(state.choices['background:ideal']?.[0] || '').trim();
    const bond = String(state.choices['background:bond']?.[0] || '').trim();
    const flaw = String(state.choices['background:flaw']?.[0] || '').trim();
    const backstory = String(state.profile?.backstory || '').trim();

    return `(День 00, на пороге гильдии появляется ${name}.

1) Раса: ${speciesName}

2) Класс: ${characterClass?.name || 'не указан'}

3) Предыстория: ${background?.name || 'не указана'}

4) Возраст: ${ageDescription(state.profile?.age)}

5) Мировоззрение: ${ALIGNMENTS[state.alignment] || 'не указано'}

6) Кратко о характере:

**Черта характера** - ${traits || 'не указана'}
**Идеал** - ${ideal || 'не указан'}
**Привязанность** - ${bond || 'не указана'}
**Слабость** - ${flaw || 'не указана'}

7) Краткая предыстория: ${backstory || 'отсутствует.'}

8) Токен персонажа: )`;
  }

  async function copyText(value) {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return;
    }
    const field = document.createElement('textarea');
    field.value = value;
    field.style.position = 'fixed';
    field.style.opacity = '0';
    document.body.appendChild(field);
    field.select();
    const copied = document.execCommand('copy');
    field.remove();
    if (!copied) throw new Error('Браузер не разрешил доступ к буферу обмена.');
  }

  function createDraftPayload() {
    const finalAbilities = Object.fromEntries(
      abilityKeys.map((key) => [key, {
        ...state.abilities[key],
        total: totalScore(key),
        modifier: modifier(totalScore(key))
      }])
    );

    return {
      schema: 'league-character-draft-v6',
      createdAt: new Date().toISOString(),
      ...state,
      abilities: finalAbilities
    };
  }

  function extractNumber(value, fallback = 0) {
    if (typeof value === 'number' && Number.isFinite(value)) return value;
    const match = String(value ?? '').match(/-?\d+/);
    return match ? Number(match[0]) : fallback;
  }

  function getHitDieSize(characterClass) {
    const source = characterClass?.hitDice ?? characterClass?.hitPoints ?? '';

    // В данных классов hitDice чаще всего хранится числом: 6, 8, 10 или 12.
    if (typeof source === 'number' && Number.isFinite(source)) {
      return source;
    }

    const text = String(source).trim();
    const diceMatch = text.match(/d\s*(\d+)/i);
    if (diceMatch) return Number(diceMatch[1]);

    const numericMatch = text.match(/^(6|8|10|12)$/);
    if (numericMatch) return Number(numericMatch[1]);

    return 8;
  }

  function getSpeciesSpeed(species) {
    const selectedVariant = findVariant(species);
    if (isCoreElfSpecies(species) && selectedVariant?.id === 'wood-elf') return '35';
    if (isWoodHalfElfVariant(species, selectedVariant)) {
      return (state.choices['species:woodHalfElfLegacy'] || [])[0] === 'Быстрые ноги'
        ? '35'
        : String(species?.speed || 30);
    }
    const variantSpeed = selectedVariant?.speed;
    const source = variantSpeed ?? species?.speed;
    if (typeof source === 'number') return String(source);
    if (source && typeof source === 'object') {
      const walking = source.walk ?? source.walking ?? source.speed ?? Object.values(source)[0];
      const parsed = extractNumber(walking, 30);
      return String(parsed || 30);
    }
    return String(extractNumber(source, 30) || 30);
  }

  function getSpeciesMovementLabel(species) {
    const selectedVariant = findVariant(species);
    const source = selectedVariant?.speed;
    if (!source || typeof source !== 'object') return `${getSpeciesSpeed(species)} фт.`;
    const parts = [];
    const walking = source.walk ?? source.walking ?? source.speed ?? species?.speed;
    if (walking) parts.push(`${extractNumber(walking, 30)} фт.`);
    if (source.swimming) parts.push(`плавание ${extractNumber(source.swimming, 0)} фт.`);
    if (source.flying) parts.push(`полёт ${extractNumber(source.flying, 0)} фт.`);
    return parts.join(' · ') || `${getSpeciesSpeed(species)} фт.`;
  }



  function buildRoll20Payload() {
    const exporter = window.CharacterCreatorRoll20;
    if (!exporter?.buildPayload) {
      throw new Error('Модуль экспорта Roll20 не загрузился.');
    }

    return exporter.buildPayload({
      roll20Template,
      state,
      findSpecies,
      findVariant,
      findClass,
      findBackground,
      ALIGNMENTS,
      modifier,
      totalScore,
      getHitDieSize,
      getSpeciesSpeed,
      selectedOriginFeats,
      selectedOriginFeatEntries,
      getEffectiveAbilities,
      normalizeEquipmentName,
      equipmentShopItems,
      abilityKeys,
      ROLL20_SKILLS,
      ROLL20_SKILL_ABILITIES,
      creatorOptions,
      getClassFeatureGroups,
      WEAPON_MASTERY_DESCRIPTIONS,
      EQUIPMENT_PACK_CONTENTS,
      getClassSpells,
      getSpellSources
    });
  }

  window.LeagueCharacterCreator = {
    getState: () => structuredClone(state),
    createDraftPayload,
    buildRoll20Payload
  };

  $('#download-draft')?.addEventListener('click', () => {
    downloadJson(createDraftPayload(), '-draft');
  });

  $('#download-roll20')?.addEventListener('click', () => {
    try {
      downloadJson(buildRoll20Payload());
    } catch (error) {
      console.error(error);
      const details = error instanceof Error ? `\n\n${error.message}` : '';
      alert(`Не удалось подготовить файл Roll20.${details}`);
    }
  });

  $('#copy-character-description')?.addEventListener('click', async (event) => {
    const button = event.currentTarget;
    const originalText = button.textContent || 'Копировать описание';
    try {
      await copyText(createCharacterDescription());
      button.textContent = 'Описание скопировано ✓';
    } catch (error) {
      console.error(error);
      button.textContent = 'Не удалось скопировать';
    }
    window.setTimeout(() => {
      button.textContent = originalText;
    }, 1800);
  });

  function resetTransientInterfaceState() {
    weaponMasterySearch = '';
    weaponMasteryCategory = 'all';
    weaponMasteryRange = 'all';
    faithSearch = '';

    Object.keys(spellSearchQueries).forEach((sourceId) => delete spellSearchQueries[sourceId]);
    Object.keys(spellScrollPositions).forEach((sourceId) => delete spellScrollPositions[sourceId]);

    $$('#character-wizard input[type="search"]').forEach((input) => {
      input.value = '';
    });

    const equipmentCategory = $('#equipment-category');
    if (equipmentCategory) equipmentCategory.value = 'all';

    $$('.species-card, .class-card, .background-card').forEach((card) => {
      card.hidden = false;
    });
  }

  $('#character-wizard')?.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest('a, input, button, label, select, textarea, details, summary')) return;

    const cell = event.target.closest('td');
    const row = event.target.closest('tr');
    if (!row || row.closest('thead')) return;

    const enabledChoices = (scope) => [...scope.querySelectorAll('input[type="checkbox"], input[type="radio"]')]
      .filter((input) => !input.disabled);
    const cellChoices = cell ? enabledChoices(cell) : [];
    const choices = cellChoices.length === 1 ? cellChoices : enabledChoices(row);

    // Если в строке несколько источников выбора, клик по названию неоднозначен.
    // В этом случае переключается только ячейка, содержащая одну конкретную галочку.
    if (choices.length !== 1) return;
    choices[0].click();
  });

  $('#reset-character')?.addEventListener('click', () => {
    localStorage.removeItem(STORAGE_KEY);
    state = structuredClone(defaultState);
    resetTransientInterfaceState();

    if (nameInput) nameInput.value = '';
    $$('[data-character-profile]').forEach((field) => {
      field.value = '';
    });

    renderSpeciesDetails();
    renderClassDetails();
    renderBackgroundDetails();
    renderProfileClassRelationships();
    updatePreview();
    showStep(0);
  });

  updatePreview();
  showStep(Number.isInteger(state.step) ? state.step : 0);
</script>

