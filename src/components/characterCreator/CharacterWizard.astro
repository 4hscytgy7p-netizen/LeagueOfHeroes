  function effectiveSpeciesAbilities(species, variant) {
    return getEffectiveAbilities(species, variant)
      .filter((ability) => {
        const title = String(ability?.title || '').toLocaleLowerCase('ru').replace(/ё/g, 'е');
        if (isCoreElfSpecies(species) && isCoreElfVariant(variant) && /происхождени[ея]\s+эльфов.*таблиц/.test(title)) return false;
        if (isCoreTieflingSpecies(species) && isCoreTieflingVariant(variant) && /происхождени[ея]\s+исчадия.*таблиц/.test(title)) return false;
        if (
          isCoreGnomeSpecies(species)
          && isCoreGnomeVariant(variant)
          && /гномь[ея]\s+происхождени[ея]/.test(title)
          && /лесной\s+гном[\s\S]*скальный\s+гном/i.test(String(ability?.description || ''))
        ) return false;
        return true;
      })
      .map((originalAbility) => {
      const ability = lineageTableAbilityToCard(originalAbility, variant);
      const title = String(ability?.title || '').toLocaleLowerCase('ru').replace(/ё/g, 'е');
      if (isCoreElfSpecies(species) && variant?.id === 'drow' && /темн(?:ое|ого)\s+зрени|darkvision/.test(title)) {
        return {
          ...ability,
          description: String(ability.description || '').replace(/60\s*фут(?:ов|а)?/gi, '120 футов')
        };
      }
      if (isDragonbornSpecies(species) && /сопротивление\s+урону/.test(title)) {
        const ancestry = (state.choices['species:dragonAncestry'] || [])[0];
        const [name, damage] = String(ancestry || '').split(':');
        if (!name || !damage) return ability;
        return {
          ...ability,
          description: `Ваш драконий предок — ${name}. Вы обладаете сопротивлением урону типа «${damage}».`
        };
      }
      if (isEladrinSpecies(species) && /шаг\s+фей|fey\s+step/.test(title)) {
        const season = ELADRIN_SEASONS[selectedEladrinSeason()];
        if (!season) return ability;
        return {
          ...ability,
          description: `${ability.description || ''}\n\nСезон — ${season.name}. ${season.description}`
        };
      }
      if (isShadarKaiSpecies(species) && /благословение\s+королевы\s+воронов|blessing\s+of\s+the\s+raven\s+queen/.test(title)) {
        return {
          ...ability,
          description: 'Бонусным действием вы телепортируетесь на расстояние до 30 футов в свободное место, которое видите. Вы можете использовать эту особенность количество раз, равное бонусу мастерства, и восстанавливаете все использования после продолжительного отдыха. Начиная с 3 уровня после телепортации вы получаете сопротивление всему урону до начала своего следующего хода.'
        };
      }
      return ability;
    });
  }

