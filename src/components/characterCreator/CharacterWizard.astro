                    ['skill', 'Навык', 'Навык выбирается на шаге «Навыки».'],
                    ['tool', 'Инструмент', 'Инструмент выбирается на шаге «Инструменты».']
                  ].map(([id, name, description]) => `
                    <label class="custom-lineage-option">
                      <input type="radio" name="khoravar-proficiency" value="${id}" ${(state.choices['species:khoravarProficiencyType'] || [])[0] === id ? 'checked' : ''} />
                      <span><strong>${name}</strong><small>${description}</small></span>
                    </label>
                  `).join('')}
