  function classForgeTheme(characterClass) {
    const identity = forgeIdentity(characterClass?.id, characterClass?.name, characterClass?.nameEn);
    const key = FORGE_CLASS_ALIASES.find(([pattern]) => pattern.test(identity))?.[1];
    return CLASS_FORGE_THEMES[key] || DEFAULT_FORGE_CLASS_THEME;
  }

  function speciesForgeTheme(species, variant) {
    const identity = forgeIdentity(species?.id, species?.name, species?.nameEn, variant?.id, variant?.name, variant?.nameEn);
    const match = [
      [/огненн.*дженази|fire.?genasi/, { color: '#fb7185', glow: '#f97316', ancestry: 'elemental' }],
      [/водн.*дженази|water.?genasi/, { color: '#22d3ee', glow: '#0ea5e9', ancestry: 'elemental' }],
      [/воздушн.*дженази|air.?genasi/, { color: '#bae6fd', glow: '#38bdf8', ancestry: 'elemental' }],
      [/земл.*дженази|earth.?genasi/, { color: '#a3e635', glow: '#a16207', ancestry: 'elemental' }],
      [/драконорожден|dragonborn/, { color: '#f97316', glow: '#ef4444', ancestry: 'draconic' }],
      [/тифлинг|tiefling/, { color: '#fb7185', glow: '#7c3aed', ancestry: 'infernal' }],
      [/эльф|elf|эладрин|eladrin/, { color: '#a78bfa', glow: '#22d3ee', ancestry: 'fey' }],
      [/дварф|гном|dwarf|gnome/, { color: '#f59e0b', glow: '#78716c', ancestry: 'stone' }],
      [/дженази|genasi/, { color: '#38bdf8', glow: '#0ea5e9', ancestry: 'elemental' }],
      [/аасимар|aasimar/, { color: '#fde68a', glow: '#f8fafc', ancestry: 'celestial' }],
      [/орк|orc/, { color: '#84cc16', glow: '#365314', ancestry: 'savage' }],
      [/полурослик|halfling/, { color: '#fbbf24', glow: '#84cc16', ancestry: 'smallfolk' }],
      [/гит|gith/, { color: '#22d3ee', glow: '#a3e635', ancestry: 'astral' }],
      [/человек|human/, { color: '#94a3b8', glow: '#e2e8f0', ancestry: 'mortal' }]
    ].find(([pattern]) => pattern.test(identity));
    return match?.[1] || { color: '#9b74ff', glow: '#6366f1', ancestry: 'unknown' };
  }

  function backgroundForgeSymbol(background, classSymbol) {
    const identity = forgeIdentity(background?.id, background?.name, background?.nameEn);
    const match = [
      [/солдат|рыцар|воен|soldier|knight/, '⚔'],
      [/моряк|пират|sailor|pirate/, '⚓'],
      [/ремесл|купец|guild|artisan|merchant/, '⚒'],
      [/учен|мудрец|студент|sage|student|scholar/, '✧'],
      [/благород|дворян|noble|court/, '♜'],
      [/преступ|беспризор|criminal|urchin/, '◆'],
      [/отшельник|служитель|acolyte|hermit/, '☼'],
      [/великан|giant/, 'ᛉ'],
      [/вампир|vampire/, '♢']
    ].find(([pattern]) => pattern.test(identity));
    return match?.[1] || classSymbol;
  }

  function updateForgeTheme() {
    const root = $('#character-wizard');
    if (!root) return;

    const species = findSpecies();
    const variant = findVariant(species);
    const characterClass = findClass();
    const background = findBackground();
    const classTheme = classForgeTheme(characterClass);
    const speciesTheme = speciesForgeTheme(species, variant);
    const alignment = String(state.alignment || '');
    const alignmentColor = alignment.includes('good')
      ? '#fde68a'
      : alignment.includes('evil')
        ? '#991b1b'
        : alignment.includes('chaotic')
          ? '#c084fc'
          : alignment.includes('lawful')
            ? '#60a5fa'
            : '#64748b';

    root.style.setProperty('--wizard-gold', classTheme.primary);
    root.style.setProperty('--wizard-gold-light', classTheme.light);
    root.style.setProperty('--forge-class-deep', classTheme.deep);
    root.style.setProperty('--forge-secondary', speciesTheme.color);
    root.style.setProperty('--forge-secondary-glow', speciesTheme.glow);
    root.style.setProperty('--forge-alignment', alignmentColor);
    root.dataset.forgeSymbol = backgroundForgeSymbol(background, classTheme.symbol);
    root.dataset.forgeAura = classTheme.aura;
    root.dataset.forgeAncestry = speciesTheme.ancestry;
    root.dataset.forgeTemper = alignment.includes('evil')
      ? 'shadow'
      : alignment.includes('good')
        ? 'radiant'
        : alignment.includes('chaotic')
          ? 'wild'
          : 'balanced';

    const status = $('#forge-theme-status');
    if (status) {
      const parts = [
        characterClass?.name && `Стиль: ${characterClass.name}`,
        species?.name && `искра: ${species.name}`,
        state.alignment && `путь: ${ALIGNMENTS[state.alignment]}`
      ].filter(Boolean);
      status.textContent = parts.length ? parts.join(' · ') : 'Облик кузницы изменится вместе с героем';
    }

    $$('.class-card').forEach((card) => {
      const theme = classForgeTheme({ id: card.dataset.classId });
      card.style.setProperty('--choice-accent', theme.primary);
      card.style.setProperty('--choice-accent-light', theme.light);
    });
  }

  function isCustomBackground() {
    return Boolean(getStateModule().findBackground(state, backgroundOptions)?.isCustom);
  }

  function getCustomBackground() {
    if (!state.customBackground || typeof state.customBackground !== 'object') {
      state.customBackground = {};
    }
    return state.customBackground;
  }

  function getEffectiveAbilities(species, variant) {
    const abilities = getStateModule().getEffectiveAbilities(species, variant);
    if (!isWoodHalfElfVariant(species, variant)) return abilities;
    const selectableTitles = new Set([
      'Владение эльфийским оружием',
      'Быстрые ноги',
      'Маскировка в дикой местности'
    ]);
    const selectedTitle = (state.choices['species:woodHalfElfLegacy'] || [])[0];
    return abilities.filter((ability) =>
      !selectableTitles.has(String(ability?.title || ''))
      || String(ability?.title || '') === selectedTitle
    );
  }

  function loreToHtml(value, limit = null) {
    const lines = String(value || '')
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean);

    const selected = limit ? lines.slice(0, limit) : lines;

    return selected
      .map((line) =>
        line.startsWith('- ')
          ? `<li>${escapeHtml(line.slice(2))}</li>`
          : `<p>${escapeHtml(line)}</p>`
      )
      .join('');
  }

  function getActiveSizeCalculator(species) {
    if (!species?.sizeCalculator) return null;

    return species.sizeCalculator.variants?.[state.speciesVariant]
      || species.sizeCalculator;
  }

  function getSizeEntry(species, sizeKey) {
    const calculator = getActiveSizeCalculator(species);
    if (!calculator) return null;

    const raw = calculator.raw || {};
    if (raw.sizeOptions?.length && sizeKey && raw[sizeKey]) {
      return raw[sizeKey];
    }

    return calculator.base || null;
  }

  function initialisePhysique(species) {
    const calculator = getActiveSizeCalculator(species);
    if (!calculator) return;

    const raw = calculator.raw || {};
    const base = calculator.base || {};
    const savedSize = String(state.physique.size || '');
    const normalizedSavedSize = raw.sizeOptions?.find(
      (option) => String(option).toLocaleLowerCase('ru-RU') === savedSize.toLocaleLowerCase('ru-RU')
    );
    const defaultSize =
      normalizedSavedSize ||
      (!raw.sizeOptions?.length ? state.physique.size : null) ||
      base.size ||
      raw.sizeOptions?.[0] ||
      species.size ||
      null;

    const entry = getSizeEntry(species, defaultSize) || base;
    const heightRange = entry.heightRange || [0, 0];
    const weightRange = entry.weightRange || [0, 0];

    state.physique.size = defaultSize;

    if (state.physique.heightModifier === null) {
      state.physique.heightModifier = Math.round(
        (Number(heightRange[0] || 0) + Number(heightRange[1] || 0)) / 2
      );
    } else {
      state.physique.heightModifier = Math.min(
        Number(heightRange[1] || 0),
        Math.max(Number(heightRange[0] || 0), Number(state.physique.heightModifier))
      );
    }

    if (state.physique.weightMultiplier === null) {
      state.physique.weightMultiplier = Math.round(
        (Number(weightRange[0] || 0) + Number(weightRange[1] || 0)) / 2
      );
    } else {
      state.physique.weightMultiplier = Math.min(
        Number(weightRange[1] || 0),
        Math.max(Number(weightRange[0] || 0), Number(state.physique.weightMultiplier))
      );
    }
  }

  function calculatePhysique(species) {
    const entry = getSizeEntry(species, state.physique.size);
    if (!entry) return null;

    const baseHeight = entry.baseHeight || { 'футов': 4, 'дюймов': 8 };
    const baseWeight = Number(entry.baseWeight || 0);
    const extraHeight = Number(state.physique.heightModifier || 0);
    const weightMultiplier = Number(state.physique.weightMultiplier || 0);

    const totalInches =
      Number(baseHeight['футов'] || 0) * 12 +
      Number(baseHeight['дюймов'] || 0) +
      extraHeight;

    const feet = Math.floor(totalInches / 12);
    const inches = totalInches % 12;
    const weight = baseWeight + extraHeight * weightMultiplier;

    state.physique.heightInches = totalInches;
    state.physique.weightPounds = weight;

    return {
      entry,
      feet,
      inches,
      totalInches,
      weight
    };
  }

  function rangeProgress(value, min, max) {
    const span = Math.max(1, Number(max) - Number(min));
    return ((Number(value) - Number(min)) / span) * 100;
  }

  function rollDice(expression) {
    const match = String(expression || '').trim().match(/^(\d+)d(\d+)$/i);
    if (!match) return null;

    const count = Number(match[1]);
    const sides = Number(match[2]);
    if (!count || !sides) return null;

    let total = 0;
    for (let index = 0; index < count; index += 1) {
      total += Math.floor(Math.random() * sides) + 1;
    }
    return total;
  }

  function normalizedSpeciesIdentity(species = findSpecies()) {
    return `${species?.id || ''} ${species?.name || ''} ${species?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
  }

  function isEladrinSpecies(species = findSpecies()) {
    const variant = findVariant(species);
    const identity = `${normalizedSpeciesIdentity(species)} ${variant?.id || ''} ${variant?.name || ''} ${variant?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
    return /(?:^|[\s_-])eladrin(?:$|[\s_-])|эладрин/.test(identity);
  }

  function isShadarKaiSpecies(species = findSpecies()) {
    const variant = findVariant(species);
    const identity = `${normalizedSpeciesIdentity(species)} ${variant?.id || ''} ${variant?.name || ''} ${variant?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
    return /shadar[\s_-]?kai|шадар[\s-]?кай/.test(identity);
  }

