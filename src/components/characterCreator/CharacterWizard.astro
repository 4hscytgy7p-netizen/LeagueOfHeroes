  function adaptiveSpeciesProficiencyConfig(species = findSpecies(), variant = findVariant(species)) {
    const identity = `${species?.id || ''} ${species?.name || ''} ${species?.nameEn || ''} ${variant?.id || ''} ${variant?.name || ''} ${variant?.nameEn || ''}`
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
    const speciesLabel = [species?.name, variant?.name].filter(Boolean).join(' — ');
    if (/astral|астральн/.test(identity) && /elf|эльф/.test(identity)) {
      return {
        title: 'Астральный транс',
        speciesLabel,
        skillCount: 1,
        flexibleCount: 1,
        description: 'После каждого продолжительного отдыха выберите один навык и одно оружие или инструмент. Владения действуют до окончания следующего продолжительного отдыха.'
      };
    }
    if (/githyanki|гитъянк/.test(identity)) {
      return {
        title: 'Астральное знание',
        speciesLabel,
        skillCount: 1,
        skillSelectionStep: 'skills',
        flexibleCount: 1,
        description: 'После каждого продолжительного отдыха выберите один навык и одно оружие или инструмент. Владения действуют до окончания следующего продолжительного отдыха.'
      };
    }
    if (
      /shadar[\s_-]?kai|шадар[\s-]?кай|eladrin|эладрин/.test(identity)
      || (/sea|морск/.test(identity) && /elf|эльф/.test(identity))
    ) {
      return {
        title: 'Транс',
        speciesLabel,
        skillCount: 0,
        flexibleCount: 2,
        description: 'После каждого продолжительного отдыха выберите два владения оружием или инструментами, которых у персонажа ещё нет. Их можно заменить после следующего продолжительного отдыха.'
      };
    }
    return null;
  }

  function adaptiveSpeciesClassFeatureChoicesComplete() {
    const config = adaptiveSpeciesProficiencyConfig();
    if (!config) return true;
    if (config.skillSelectionStep === 'skills') return true;
    const skillCount = (state.choices['species:adaptiveSkill'] || []).filter(Boolean).length;
    return skillCount === config.skillCount;
  }

  function selectedAdaptiveWeapons() {
    return (state.choices['species:adaptiveProficiencies'] || [])
      .filter((value) => value.startsWith('Оружие: '));
  }

  function syncAdaptiveSpeciesToolChoices({ migrateLegacy = false } = {}) {
    const config = adaptiveSpeciesProficiencyConfig();
    if (!config) return;

    const weapons = selectedAdaptiveWeapons().slice(0, config.flexibleCount);
    const legacyTools = (state.choices['species:adaptiveProficiencies'] || [])
      .filter((value) => value.startsWith('Инструмент: '))
      .map((value) => value.replace(/^Инструмент:\s*/, ''));
    const currentTools = Array.isArray(state.choices['species:tools'])
      ? state.choices['species:tools']
      : [];
    const toolLimit = Math.max(0, config.flexibleCount - weapons.length);
    const tools = [...new Set([...currentTools, ...(migrateLegacy ? legacyTools : [])])]
      .filter((tool) => creatorOptions.allTools.includes(tool))
      .slice(0, toolLimit);

    state.choices['species:tools'] = tools;
    state.choices['species:adaptiveProficiencies'] = [
      ...weapons,
      ...tools.map((tool) => `Инструмент: ${tool}`)
    ];
  }

  function adaptiveProficiencyItem(value) {
    const name = String(value || '').replace(/^(?:Оружие|Инструмент):\s*/, '');
    const normalized = normalizeEquipmentName(name);
    return equipmentShopItems.find((item) => normalizeEquipmentName(item.name) === normalized) || null;
  }

