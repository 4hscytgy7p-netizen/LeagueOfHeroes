        <section class="background-stats"><div><span>Навыки</span><strong>${escapeHtml(skillListDisplay(background.skills))}</strong></div><div><span>Инструменты</span><strong>${escapeHtml(background.tools || '—')}</strong></div><div><span>Черта</span><strong>Выбирается на следующем этапе</strong></div></section>
        <section class="content-section background-rewards"><div class="content-section-heading"><span class="section-icon">✦</span><div><span class="section-kicker">Наследие прошлого</span><h3>Снаряжение и особенности</h3></div></div><div class="background-reward-grid"><article><span>Снаряжение</span><strong>${escapeHtml(background.equipment || '—')}</strong></article><article><span>Выбранные варианты</span><strong>${escapeHtml((state.choices['background:variant'] || []).join(', ') || '—')}</strong></article></div></section>
        ${background.spellTable ? `<section class="content-section background-spells"><div class="content-section-heading"><span class="section-icon">✺</span><div><span class="section-kicker">Магия</span><h3>${escapeHtml(background.spellTable.name || 'Заклинания')}</h3></div></div><p>${escapeHtml(background.spellTable.description || '')}</p><div class="spell-table-list">${(background.spellTable.spells || []).map((row)=>`<p><strong>${escapeHtml(row.level || '')}</strong><span>${escapeHtml((row.spells || []).join(', '))}</span></p>`).join('')}</div></section>` : ''}
        <section class="content-section background-choices-section"><div id="background-rule-choices"></div></section>
      </article>`;

    renderBackgroundChoiceCards($('#background-rule-choices'), choices);
    $('#change-background')?.addEventListener('click', () => $('#background-picker')?.scrollIntoView({ behavior:'smooth', block:'start' }));
    updatePreview();
    saveState();
