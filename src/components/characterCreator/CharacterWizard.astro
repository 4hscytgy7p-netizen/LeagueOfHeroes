  function normalizeOptions(options) {
    return (options || []).map((option) =>
      typeof option === 'string' ? { value: option, label: option } : option
    );
  }

  const REPEATABLE_ORIGIN_FEATS = new Set(['skilled', 'magic-initiate']);

  function isRepeatableOriginFeat(id) {
    return REPEATABLE_ORIGIN_FEATS.has(String(id || '').toLowerCase());
  }

  function selectedOriginFeatEntries() {
    return getStateModule().selectedOriginFeatEntries(
      state,
      allResolvedFeatOptions
    ).filter((entry) => entry.source !== 'background' || backgroundGrantsOriginFeat());
  }

  function clearOriginFeatSourceChoices(source) {
    const prefix = `feat:${source}:`;
    Object.keys(state.choices).forEach((key) => {
      if (key.startsWith(prefix)) delete state.choices[key];
    });
  }

  function selectedOriginFeats() {
    const ids = selectedOriginFeatEntries().map((entry) => entry.id);
    return ids
      .map((id) => allResolvedFeatOptions.find((feat) => feat.id === id))
      .filter(Boolean);
  }

  function selectedOriginFeat() {
    return selectedOriginFeats()[0] || null;
  }

  function isHumanSpecies() {
    return getStateModule().isHumanSpecies(state, findSpecies());
  }

  function isCustomLineageSpecies() {
    return getStateModule().isCustomLineageSpecies(
      state,
      findSpecies()
    );
  }

  function speciesGrantsExtraFeat() {
    return isHumanSpecies() || isCustomLineageSpecies();
  }


  function normalizeRuleText(value) {
    return String(value || '')
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е')
      .replace(/[^a-zа-я0-9]+/gi, ' ')
      .trim();
  }

  const BACKGROUND_SPECIAL_FEAT_RULES = [
    { background: /резчик\s+рун|rune\s+carver/i, featIds: ['rune-shaper'] },
    { background: /великаний\s+подкидыш|найденыш\s+великанов|giant\s+foundling/i, featIds: ['strike-of-the-giants'] },
    { background: /соламнийск(?:ий|ого)\s+рыцар|рыцарь\s+соламнии|knight\s+of\s+solamnia/i, featIds: ['squire-of-solamnia'] },
    { background: /вампирск(?:ий|ого)\s+посвящ[её]нн|vampire\s+devotee/i, featIds: ['vampires-plaything'] },
    { background: /маг\s+высшего\s+волшебства|mage\s+of\s+high\s+sorcery/i, featIds: ['initiate-of-high-sorcery'] },
    { background: /планарн(?:ый|ого)\s+философ|planar\s+philosopher/i, featIds: ['scion-of-the-outer-planes'] },
    { background: /студент.*(?:лорхолд|призмари|квандрикс|сильверквилл|визерблум)|(?:lorehold|prismari|quandrix|silverquill|witherbloom)\s+student/i, featIds: ['strixhaven-initiate'] }
  ];

  function backgroundFeatRuleText(background = findBackground()) {
    if (!background) return '';
    const values = [
      background.feat,
      background.originFeat,
      background.proficiencies?.feat,
      background.proficiencies?.originFeat
    ];
    return values.map((value) => {
      if (Array.isArray(value)) return value.join(' ');
      if (value && typeof value === 'object') return Object.values(value).join(' ');
      return String(value || '');
    }).join(' ');
  }

  function backgroundGrantsOriginFeat(background = findBackground()) {
    // В конструкторе каждая предыстория предоставляет одну стандартную
    // черту происхождения. Явное правило предыстории может расширить список
    // особой чертой, но не отменяет двенадцать основных вариантов.
    return Boolean(background);
  }

  function getBackgroundOriginFeatOptions() {
    const background = findBackground();
    if (!background) return [];
    const ruleText = backgroundFeatRuleText(background);
    const normalizedRule = normalizeRuleText(ruleText);
    const options = new Map(
      featOptions.map((feat) => [feat.id, feat])
    );

    // Устаревшие и сеттинговые предыстории могут прямо называть особую черту,
    // которая не входит в стандартный список черт происхождения.
    for (const feat of allResolvedFeatOptions) {
      const names = [feat.name, feat.nameEn, feat.id].map(normalizeRuleText).filter(Boolean);
      if (names.some((name) => name.length > 3 && normalizedRule.includes(name))) {
        options.set(feat.id, feat);
      }
    }

    for (const rule of BACKGROUND_SPECIAL_FEAT_RULES) {
      if (!rule.background.test(ruleText)) continue;
      for (const featId of rule.featIds) {
        const feat = allResolvedFeatOptions.find((item) => item.id === featId);
        if (feat) options.set(feat.id, feat);
      }
    }

    return [...options.values()];
  }

  function originFeatEligibility(feat) {
    const requirements = Array.isArray(feat?.requirements)
      ? feat.requirements.filter(Boolean)
      : [];
    if (!requirements.length) return true;

    const background = findBackground();
    const characterClass = findClass();
    const backgroundId = String(background?.id || state.background || '').toLocaleLowerCase('ru');
    const classId = String(characterClass?.id || state.class || '').toLocaleLowerCase('ru');
    const classWeapons = (characterClass?.proficiencies?.weapons || [])
      .map((weapon) => String(weapon || ''))
      .join(' ')
      .toLocaleLowerCase('ru');
    const hasBackground = (...ids) => ids.includes(backgroundId);

    switch (String(feat?.id || '')) {
      case 'squire-of-solamnia':
        return ['fighter', 'paladin'].includes(classId)
          || hasBackground('knight of solamnia');
      case 'strike-of-the-giants':
        return /воинск.*оруж/.test(classWeapons)
          || hasBackground('giantfoundling');
      case 'initiate-of-high-sorcery':
        return hasBackground('mage of high sorcery');
      case 'scion-of-the-outer-planes':
        return hasBackground('gate warden');
      case 'rune-shaper':
        return hasBackground('rune carver');
      case 'strixhaven-initiate':
        return hasBackground(
          'witherbloom student',
          'quandrix student',
          'lorehold student',
          'prismari student',
          'silverquill student'
        );
      case 'vampire-hunter':
        return hasBackground('vampire survivor');
      case 'vampires-plaything':
        return hasBackground('vampire devotee');
      case 'spellfire-spark':
        return hasBackground('spellfire-initiate');
      default:
        return true;
    }
  }

  function getClassFeatureGroups() {
    const characterClass = findClass();
    const classId = String(characterClass?.id || state.class || '').toLocaleLowerCase('ru');
    const className = `${characterClass?.name || ''} ${characterClass?.nameEn || ''}`.toLocaleLowerCase('ru');
    const groups = [...(classFeatureOptions[state.class] || [])];

    if (classId === 'paladin' && Array.isArray(characterClass?.subclasses)) {
      groups.unshift({
        id: 'paladin-oath',
        name: 'Священная клятва',
        count: 1,
        description: 'Выберите идеал и будущий подкласс паладина. Клятва определяет путь персонажа уже сейчас, а её механические умения открываются на 3 уровне.',
        href: '/classes/paladin#feature-подкласс-паладина-3',
        options: characterClass.subclasses.map((subclass) => ({
          id: subclass.id,
          name: subclass.name,
          detail: subclass.id === 'oathbreaker'
            ? `${subclass.nameEn} · только с разрешения Мастера`
            : subclass.nameEn,
          description: subclass.description || '',
          href: `/classes/paladin?subclass=${encodeURIComponent(subclass.id)}`
        }))
      });
    }

    if (classId === 'warlock' && Array.isArray(characterClass?.subclasses)) {
      groups.unshift({
        id: 'warlock-patron-path',
        name: 'Вид потустороннего покровителя',
        count: 1,
        description: 'Выберите будущий подкласс колдуна. Затем конструктор отметит конкретных сущностей, подходящих этому виду договора.',
        href: '/classes/warlock#feature-подкласс-колдуна-3',
        options: characterClass.subclasses.map((subclass) => ({
          id: subclass.id,
          name: subclass.name,
          detail: subclass.nameEn,
          description: subclass.description || '',
          href: `/classes/warlock?subclass=${encodeURIComponent(subclass.id)}`
        }))
      });
    }

    const masteryEntry = Object.entries(WEAPON_MASTERY_COUNTS).find(([key]) =>
      classId === key || classId.includes(key) || className.includes(key)
    );

    if (masteryEntry) {
      const isRogue = classId === 'rogue' || classId.includes('rogue') || /плут/.test(className);
      const allowedMasteryOptions = isRogue
        ? weaponMasteryOptions.filter((option) => rogueWeaponMasteryIds.includes(option.id))
        : weaponMasteryOptions;

      groups.push({
        id: 'weapon-mastery',
        name: 'Оружейные приёмы',
        count: masteryEntry[1],
        description: isRogue
          ? 'Выберите 2 типа оружия, которыми плут владеет: простое оружие либо воинское оружие со свойством «Фехтовальное» или «Лёгкое».'
          : 'Выберите оружие, к которому привязан доступный персонажу оружейный приём.',
        href: '/faq',
        options: allowedMasteryOptions
      });
    }

    const isBloodHunter =
      classId === 'bloodhunter' ||
      /blood[-_\s]?hunter/.test(classId) ||
      /blood[-_\s]?hunter/.test(className) ||
      /кровав(?:ый|ого)\s+охотник/.test(className);

    if (isBloodHunter) {
      groups.push({
        id: 'blood-curse',
        name: 'Проклятая кровь',
        count: 1,
        description: 'Выберите одно известное Проклятие крови.',
        href: '/classes/bloodhunter#feature-проклятая-кровь-1',
        options: bloodCurseOptions
      });
    }

    return groups.map((group) => {
      if (group.id === 'warlock-patron') {
        const custom = getCustomPatron();
        return {
          ...group,
          options: group.options.map((option) => {
            const resolved = option.id === 'patron-custom'
              ? {
                ...option,
                name: String(custom.name || '').trim() || option.name,
                type: custom.type || option.type,
                alignment: custom.alignment || option.alignment,
                realm: custom.realm || option.realm,
                source: custom.source || option.source,
                description: custom.description || option.description,
                pactIdeas: [
                  custom.pactTerms ? `Цена и условия: ${custom.pactTerms}` : '',
                  custom.manifestation ? `Способ общения: ${custom.manifestation}` : '',
                  custom.goals ? `Цели: ${custom.goals}` : ''
                ].filter(Boolean).join(' ')
              }
              : option;
            return {
              ...resolved,
              exportDescription: [
                resolved.description,
                `Вид: ${resolved.type}.`,
                `Мировоззрение: ${resolved.alignment}.`,
                `Обитель: ${resolved.realm}.`,
                resolved.pactIdeas ? `Идеи и условия договора: ${resolved.pactIdeas}` : '',
                resolved.source ? `Источник: ${resolved.source}.` : ''
              ].filter(Boolean).join('\n\n')
            };
          })
        };
      }
      if (group.id !== 'faith') return group;
      const custom = getCustomDeity();
      return {
        ...group,
        options: group.options.map((option) => option.id === 'faith-other-deity'
          ? {
              ...option,
              name: String(custom.name || '').trim() || option.name,
              description: [
                custom.title ? `${custom.name || 'Божество'} — ${custom.title}` : custom.name,
                custom.alignment ? `Мировоззрение: ${custom.alignment}` : '',
                custom.domains ? `Домены: ${custom.domains}` : '',
                custom.portfolio ? `Сфера влияния: ${custom.portfolio}` : '',
                custom.pantheon ? `Пантеон или мир: ${custom.pantheon}` : '',
                custom.symbol ? `Священный символ: ${custom.symbol}` : '',
                custom.description,
                custom.tenets ? `Заповеди и требования:\n${custom.tenets}` : ''
              ].filter(Boolean).join('\n\n')
            }
          : option)
      };
    });
  }

  function getSelectedClassFeatureEffects() {
    const effects = [];
    for (const group of getClassFeatureGroups()) {
      const selected = state.choices[`classFeature:${group.id}`] || [];
      for (const optionId of selected) {
        const option = group.options.find((item) => item.id === optionId);
        if (Array.isArray(option?.effects)) effects.push(...option.effects);
      }
    }
    return effects;
  }

  function getClassFeatureEffects(type) {
    return getSelectedClassFeatureEffects().filter((effect) => effect.type === type);
  }

  function classFeatureExtraCantrips(spellList) {
    return getClassFeatureEffects('extraCantrip')
      .filter((effect) => !effect.spellList || effect.spellList === spellList)
      .reduce((sum, effect) => sum + Number(effect.count || 0), 0);
  }

  function selectedClassFeatureOption(groupId) {
    return state.choices[`classFeature:${groupId}`]?.[0] || null;
  }

  function selectedClassFeatureOptionRecord(groupId) {
    const selectedId = selectedClassFeatureOption(groupId);
    const group = getClassFeatureGroups().find((item) => item.id === groupId);
    return group?.options?.find((option) => option.id === selectedId) || null;
  }

  function hasApothecaryTheory(theoryName) {
    const selectedTheory = selectedClassFeatureOptionRecord('esoteric-theory');
    return String(selectedTheory?.name || '').trim() === theoryName;
  }

