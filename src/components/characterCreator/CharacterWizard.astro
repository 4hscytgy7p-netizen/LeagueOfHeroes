  function lineageTableAbilityToCard(ability, variant) {
    const title = String(ability?.title || '');
    const description = String(ability?.description || '').trim();
    if (!/таблиц/i.test(title) || !description.includes('\t')) return ability;

    const lines = description.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
    const dataLine = lines.find((line, index) => index > 0 && line.includes('\t')) || lines[lines.length - 1] || '';
    const cells = dataLine.split('\t').map((cell) => cell.trim());
    if (cells.length < 2) return ability;

    const lineageName = cells[0] || variant?.name || 'Происхождение';
    const level1 = cells[1] && cells[1] !== '-' ? `1 уровень. ${cells[1]}` : '';
    const level3 = cells[2] && cells[2] !== '-' ? `3 уровень. Вы получаете заклинание ${cells[2]}.` : '';
    const level5 = cells[3] && cells[3] !== '-' ? `5 уровень. Вы получаете заклинание ${cells[3]}.` : '';

    return {
      ...ability,
      title: `Происхождение — ${lineageName}`,
      description: [level1, level3, level5].filter(Boolean).join('\n\n')
    };
  }

  function mergeCoreVariants(species, coreVariants) {
    const existingVariants = Array.isArray(species?.variants) ? species.variants : [];
    const coreIds = new Set(coreVariants.map((variant) => String(variant.id || '').toLocaleLowerCase('ru')));
    const coreNames = new Set(coreVariants.flatMap((variant) => [variant.name, variant.nameEn])
      .filter(Boolean)
      .map((value) => String(value).toLocaleLowerCase('ru').replace(/ё/g, 'е').trim()));

    const preservedVariants = existingVariants.filter((variant) => {
      const id = String(variant?.id || '').toLocaleLowerCase('ru');
      const names = [variant?.name, variant?.nameEn]
        .filter(Boolean)
        .map((value) => String(value).toLocaleLowerCase('ru').replace(/ё/g, 'е').trim());
      return !coreIds.has(id) && !names.some((name) => coreNames.has(name));
    });

    species.variants = [
      ...coreVariants.map((variant) => structuredClone(variant)),
      ...preservedVariants
    ];
  }

  function ensureCoreSpeciesVariants() {
    for (const species of speciesOptions) {
      if (isCoreElfSpecies(species)) {
        mergeCoreVariants(species, CORE_ELF_VARIANTS);
      }
      if (isCoreTieflingSpecies(species)) {
        mergeCoreVariants(species, CORE_TIEFLING_VARIANTS);
      }
      if (isCoreGnomeSpecies(species)) {
        mergeCoreVariants(species, CORE_GNOME_VARIANTS);
      }
    }
  }

  ensureCoreSpeciesVariants();

