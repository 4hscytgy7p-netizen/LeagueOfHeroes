        <label><span>Вид *</span><select data-custom-patron="type"><option value="">Выберите…</option>${types.map((type) => `<option value="${type}" ${custom.type === type ? 'selected' : ''}>${type}</option>`).join('')}</select></label>
        <label><span>Мировоззрение *</span><select data-custom-patron="alignment"><option value="">Выберите…</option>${alignments.map((alignment) => `<option value="${alignment}" ${custom.alignment === alignment ? 'selected' : ''}>${alignment}</option>`).join('')}</select></label>
        <label><span>Обитель или план *</span><input data-custom-patron="realm" value="${escapeHtml(custom.realm)}" placeholder="Дальний предел, Девять Преисподних…"></label>
        <label><span>Источник</span><input data-custom-patron="source" value="${escapeHtml(custom.source)}" placeholder="Собственный мир или книга"></label>
        <label class="custom-deity-wide"><span>Краткое описание *</span><textarea data-custom-patron="description" rows="3" placeholder="Кто эта сущность и чем она могущественна?">${escapeHtml(custom.description)}</textarea></label>
        <label class="custom-deity-wide"><span>Цена и условия договора *</span><textarea data-custom-patron="pactTerms" rows="3" placeholder="Что колдун отдал или обещал?">${escapeHtml(custom.pactTerms)}</textarea></label>
        <label class="custom-deity-wide"><span>Способ общения *</span><textarea data-custom-patron="manifestation" rows="2" placeholder="Сны, знакомый, голос в клинке, письмена в огне…">${escapeHtml(custom.manifestation)}</textarea></label>
        <label class="custom-deity-wide"><span>Цели покровителя *</span><textarea data-custom-patron="goals" rows="3" placeholder="Чего он хочет от колдуна сейчас и в будущем?">${escapeHtml(custom.goals)}</textarea></label>
      </div>
    </section>`;
  }

  function renderCustomDeityForm() {
    const custom = getCustomDeity();
    const alignmentOptions = [
      ['ЗД', 'Законно-доброе'],
      ['НД', 'Нейтрально-доброе'],
      ['ХД', 'Хаотично-доброе'],
      ['ЗН', 'Законно-нейтральное'],
      ['Н', 'Нейтральное'],
      ['ХН', 'Хаотично-нейтральное'],
      ['ЗЗ', 'Законно-злое'],
      ['НЗ', 'Нейтрально-злое'],
      ['ХЗ', 'Хаотично-злое']
    ];

    return `<section class="custom-deity-panel" aria-labelledby="custom-deity-title">
      <div class="custom-deity-heading">
        <div>
          <span>Собственный вариант</span>
          <h4 id="custom-deity-title">Опишите божество или пантеон</h4>
        </div>
        <small>* обязательные поля</small>
      </div>
      <div class="custom-deity-grid">
        <label>
          <span>Имя *</span>
          <input data-custom-deity="name" value="${escapeHtml(custom.name)}" placeholder="Например, Хранитель Пепла">
        </label>
        <label>
          <span>Титул или прозвище</span>
          <input data-custom-deity="title" value="${escapeHtml(custom.title)}" placeholder="Владыка угасших костров">
        </label>
        <label>
          <span>Мировоззрение *</span>
          <select data-custom-deity="alignment">
            <option value="">Выберите…</option>
            ${alignmentOptions.map(([value, label]) => `<option value="${value}" ${custom.alignment === value ? 'selected' : ''}>${label} (${value})</option>`).join('')}
          </select>
        </label>
        <label>
          <span>Домены *</span>
          <input data-custom-deity="domains" value="${escapeHtml(custom.domains)}" placeholder="Свет, Жизнь">
        </label>
        <label>
          <span>Сфера влияния *</span>
          <input data-custom-deity="portfolio" value="${escapeHtml(custom.portfolio)}" placeholder="Огонь, память и возрождение">
        </label>
        <label>
          <span>Пантеон или мир</span>
          <input data-custom-deity="pantheon" value="${escapeHtml(custom.pantheon)}" placeholder="Собственный сеттинг">
        </label>
        <label class="custom-deity-wide">
          <span>Священный символ *</span>
          <input data-custom-deity="symbol" value="${escapeHtml(custom.symbol)}" placeholder="Серебряная чаша с негаснущим углём">
        </label>
        <label class="custom-deity-wide">
          <span>Краткое описание *</span>
          <textarea data-custom-deity="description" rows="3" placeholder="Кто это божество и чему оно покровительствует?">${escapeHtml(custom.description)}</textarea>
        </label>
        <label class="custom-deity-wide">
          <span>Заповеди и требования</span>
          <textarea data-custom-deity="tenets" rows="3" placeholder="Каких принципов придерживаются последователи?">${escapeHtml(custom.tenets)}</textarea>
        </label>
      </div>
    </section>`;
  }

  function renderClassFeatures(message = '') {
    const masteryGroup = getClassFeatureGroups().find((group) => group.id === 'weapon-mastery');
    if (masteryGroup) {
      const allowedIds = new Set(masteryGroup.options.map((option) => option.id));
      const choiceKey = 'classFeature:weapon-mastery';
      const selected = state.choices[choiceKey] || [];
      const validSelected = selected.filter((id) => allowedIds.has(id)).slice(0, masteryGroup.count);
      if (validSelected.length !== selected.length) state.choices[choiceKey] = validSelected;
    }

    const list = $('#class-features-list');
    const empty = $('#class-features-empty');
    const warning = $('#class-features-warning');
    if (!list || !empty || !warning) return;

    const groups = getClassFeatureGroups();
    const adaptiveSpeciesGroup = renderAdaptiveSpeciesProficiencyGroup();
    const hasChoices = groups.length > 0 || Boolean(adaptiveSpeciesGroup);
    empty.hidden = hasChoices;
    list.hidden = !hasChoices;

    list.innerHTML = adaptiveSpeciesGroup + groups.map((group) => {
      const key = `classFeature:${group.id}`;
      if (
        (group.id === 'paladin-oath' || group.id === 'warlock-patron-path')
        && !(state.choices[key] || []).length
        && (state.choices['class:subclass'] || []).length
      ) {
        state.choices[key] = state.choices['class:subclass'].slice(0, 1);
      }
      const selected = Array.isArray(state.choices[key]) ? state.choices[key] : [];
      state.choices[key] = selected
        .filter((id) => group.options.some((option) => option.id === id))
        .slice(0, group.count);

      const inputType = group.count === 1 ? 'radio' : 'checkbox';
      let visibleOptions = group.options.filter((option) => {
          if (group.id !== 'weapon-mastery') return true;

            const searchText = `${option.name || ''} ${option.detail || ''}`
              .toLocaleLowerCase('ru');
            return (
              (!weaponMasterySearch || searchText.includes(weaponMasterySearch))
              && (weaponMasteryCategory === 'all' || option.category === weaponMasteryCategory)
              && (weaponMasteryRange === 'all' || option.rangeType === weaponMasteryRange)
            );
          });

      if (group.id === 'faith') {
        const recommendedIds = recommendedDeityIds();
        const specialOptions = group.options.filter((option) => option.kind !== 'deity');
        const deityOptions = group.options
          .filter((option) => option.kind === 'deity')
          .filter((option) => {
            const searchText = [
              option.name,
              option.portfolio,
              option.description,
              ...(option.domains || [])
            ].filter(Boolean).join(' ').toLocaleLowerCase('ru');

            return (
              (!faithSearch || searchText.includes(faithSearch))
              && (faithAlignment === 'all' || option.alignment === faithAlignment)
              && (faithDomain === 'all' || option.domains?.includes(faithDomain))
            );
          })
          .sort((left, right) => {
            const recommendationOrder =
              Number(recommendedIds.has(right.id)) - Number(recommendedIds.has(left.id));
            if (recommendationOrder) return recommendationOrder;
            if (faithSort === 'alignment') {
              return String(left.alignment).localeCompare(String(right.alignment), 'ru')
                || left.name.localeCompare(right.name, 'ru');
            }
            if (faithSort === 'domain') {
              return String(left.domains?.[0] || '').localeCompare(String(right.domains?.[0] || ''), 'ru')
                || left.name.localeCompare(right.name, 'ru');
            }
            return left.name.localeCompare(right.name, 'ru');
          });

        visibleOptions = [...specialOptions, ...deityOptions];
      }

      if (group.id === 'warlock-patron') {
        const selectedPath = selectedWarlockPatronPath();
        visibleOptions = group.options
          .filter((option) => {
            if (option.id === 'patron-custom') return true;
            const searchText = [
              option.name, option.type, option.realm, option.description,
              option.pactIdeas, option.source
            ].filter(Boolean).join(' ').toLocaleLowerCase('ru');
            return (
              (!patronSearch || searchText.includes(patronSearch))
              && (patronType === 'all' || option.type === patronType)
              && (patronAlignment === 'all' || option.alignment === patronAlignment)
            );
          })
          .sort((left, right) => {
            if (left.id === 'patron-custom') return -1;
            if (right.id === 'patron-custom') return 1;
            const suitableOrder =
              Number(right.subclassIds?.includes(selectedPath)) - Number(left.subclassIds?.includes(selectedPath));
            if (suitableOrder) return suitableOrder;
            if (patronSort === 'type') {
              return String(left.type).localeCompare(String(right.type), 'ru')
                || left.name.localeCompare(right.name, 'ru');
            }
            if (patronSort === 'alignment') {
              return String(left.alignment).localeCompare(String(right.alignment), 'ru')
                || left.name.localeCompare(right.name, 'ru');
            }
            return left.name.localeCompare(right.name, 'ru');
          });
      }

      return `<section class="class-feature-group">
        <div class="class-feature-summary">
          <div>
            <span>Умение класса</span>
            <h3>${group.href ? `<a class="class-feature-group-link" href="${escapeHtml(group.href)}" target="_blank" rel="noopener">${escapeHtml(group.name)} ↗</a>` : escapeHtml(group.name)}</h3>
            ${group.description ? `<p>${escapeHtml(group.description)}</p>` : ''}
          </div>
          <strong>${state.choices[key].length}/${group.count}</strong>
        </div>

        <div class="class-feature-table-wrap">
          ${group.id === 'weapon-mastery' ? `
            <div class="weapon-mastery-toolbar">
              <label>
                <span>Поиск</span>
                <input id="weapon-mastery-search" type="search" placeholder="Оружие или приём…" value="${escapeHtml(weaponMasterySearch)}">
              </label>
              <label>
                <span>Категория</span>
                <select id="weapon-mastery-category">
                  <option value="all" ${weaponMasteryCategory === 'all' ? 'selected' : ''}>Все</option>
                  <option value="simple" ${weaponMasteryCategory === 'simple' ? 'selected' : ''}>Простое</option>
                  <option value="martial" ${weaponMasteryCategory === 'martial' ? 'selected' : ''}>Воинское</option>
                </select>
              </label>
              <label>
                <span>Дистанция</span>
                <select id="weapon-mastery-range">
                  <option value="all" ${weaponMasteryRange === 'all' ? 'selected' : ''}>Все</option>
                  <option value="melee" ${weaponMasteryRange === 'melee' ? 'selected' : ''}>Ближнее</option>
                  <option value="ranged" ${weaponMasteryRange === 'ranged' ? 'selected' : ''}>Дальнее</option>
                </select>
              </label>
            </div>
          ` : ''}
          ${group.id === 'faith' ? `
            ${state.class === 'paladin' ? (
              selectedPaladinOath()
                ? `<div class="faith-oath-recommendation">
                    <strong>Рекомендации для выбранной клятвы</strong>
                    <span>${group.options
                      .filter((option) => recommendedDeityIds().has(option.id))
                      .map((option) => option.name)
                      .join(' · ') || 'Для этой клятвы нет прямых рекомендаций — выберите покровителя по истории персонажа.'}</span>
                    <small>Это подсказка, а не ограничение: можно выбрать любое божество или служить только клятве.</small>
                  </div>`
                : `<div class="faith-oath-recommendation is-pending">
                    <strong>Сначала выберите священную клятву</strong>
                    <small>После выбора подходящие божества будут отмечены и подняты в начало списка.</small>
                  </div>`
            ) : ''}
            <div class="faith-toolbar">
              <label>
                <span>Поиск</span>
                <input id="faith-search" type="search" placeholder="Имя, сфера или описание…" value="${escapeHtml(faithSearch)}">
              </label>
              <label>
                <span>Мировоззрение</span>
                <select id="faith-alignment">
                  <option value="all">Все</option>
                  ${[...new Set(group.options.filter((option) => option.kind === 'deity').map((option) => option.alignment))]
                    .sort((left, right) => left.localeCompare(right, 'ru'))
                    .map((alignment) => `<option value="${escapeHtml(alignment)}" ${faithAlignment === alignment ? 'selected' : ''}>${escapeHtml(alignment)}</option>`)
                    .join('')}
                </select>
              </label>
              <label>
                <span>Домен</span>
                <select id="faith-domain">
                  <option value="all">Все</option>
                  ${[...new Set(group.options.filter((option) => option.kind === 'deity').flatMap((option) => option.domains || []))]
                    .sort((left, right) => left.localeCompare(right, 'ru'))
                    .map((domain) => `<option value="${escapeHtml(domain)}" ${faithDomain === domain ? 'selected' : ''}>${escapeHtml(domain)}</option>`)
                    .join('')}
                </select>
              </label>
              <label>
                <span>Сортировка</span>
                <select id="faith-sort">
                  <option value="name" ${faithSort === 'name' ? 'selected' : ''}>По имени</option>
                  <option value="alignment" ${faithSort === 'alignment' ? 'selected' : ''}>По мировоззрению</option>
                  <option value="domain" ${faithSort === 'domain' ? 'selected' : ''}>По домену</option>
                </select>
              </label>
            </div>
          ` : ''}
          ${group.id === 'warlock-patron' ? `
            <div class="faith-oath-recommendation ${selectedWarlockPatronPath() ? '' : 'is-pending'}">
              <strong>${selectedWarlockPatronPath() ? 'Подходящие покровители подняты вверх' : 'Сначала выберите вид покровителя'}</strong>
              <small>${selectedWarlockPatronPath()
                ? 'Совместимость — сюжетная подсказка, а не запрет. С разрешения Мастера можно выбрать любую сущность.'
                : 'После выбора подкласса подходящие сущности будут отмечены и отсортированы первыми.'}</small>
              <small>Источники: <a href="${escapeHtml(group.href)}" target="_blank" rel="noopener">официальное описание колдуна ↗</a> · <a href="${escapeHtml(group.secondaryHref)}" target="_blank" rel="noopener">D&D.su ↗</a></small>
            </div>
            <div class="faith-toolbar">
              <label><span>Поиск</span><input id="patron-search" type="search" placeholder="Имя, вид, обитель или описание…" value="${escapeHtml(patronSearch)}"></label>
              <label><span>Вид</span><select id="patron-type"><option value="all">Все</option>${[...new Set(group.options.map((option) => option.type))].sort((a, b) => a.localeCompare(b, 'ru')).map((type) => `<option value="${escapeHtml(type)}" ${patronType === type ? 'selected' : ''}>${escapeHtml(type)}</option>`).join('')}</select></label>
              <label><span>Мировоззрение</span><select id="patron-alignment"><option value="all">Все</option>${[...new Set(group.options.map((option) => option.alignment))].sort((a, b) => a.localeCompare(b, 'ru')).map((alignment) => `<option value="${escapeHtml(alignment)}" ${patronAlignment === alignment ? 'selected' : ''}>${escapeHtml(alignment)}</option>`).join('')}</select></label>
              <label><span>Сортировка</span><select id="patron-sort"><option value="name" ${patronSort === 'name' ? 'selected' : ''}>По имени</option><option value="type" ${patronSort === 'type' ? 'selected' : ''}>По виду</option><option value="alignment" ${patronSort === 'alignment' ? 'selected' : ''}>По мировоззрению</option></select></label>
            </div>
          ` : ''}
          ${group.id === 'faith' || group.id === 'warlock-patron' ? '<div class="faith-table-scroll">' : group.id === 'paladin-oath' || group.id === 'warlock-patron-path' ? '<div class="oath-table-scroll">' : ''}
          <table class="class-feature-table ${group.id === 'faith' || group.id === 'warlock-patron' ? 'faith-table' : group.id === 'paladin-oath' || group.id === 'warlock-patron-path' ? 'oath-table' : ''}">
            <thead>
              <tr>
                <th>${escapeHtml(group.name)}</th>
                <th>Выбор</th>
              </tr>
            </thead>
            <tbody>
              ${visibleOptions.map((option) => {
                const checked = state.choices[key].includes(option.id);
                const optionTitle = option.href
                  ? `<a href="${escapeHtml(option.href)}" target="_blank" rel="noopener">${escapeHtml(option.name)} ↗</a>`
                  : `<span>${escapeHtml(option.name)}</span>`;
                const detailLabel = option.detail
                  ? group.id === 'weapon-mastery'
                    ? `<small><a class="class-feature-detail-link" href="/faq" target="_blank" rel="noopener">${escapeHtml(option.detail)} ↗</a></small>`
                    : `<small>${escapeHtml(option.detail)}</small>`
                  : '';
                const label = group.id === 'paladin-oath' || group.id === 'warlock-patron-path'
                  ? `<details class="oath-disclosure">
                      <summary>
                        <span>${escapeHtml(option.name)}</span>
                        <small>${escapeHtml(option.detail || '')}</small>
                      </summary>
                      <p>${escapeHtml(option.description || '')}</p>
                    </details>`
                  : group.id === 'faith' && option.kind === 'deity'
                    ? `<details class="faith-disclosure">
                      <summary>
                        <span>${escapeHtml(option.name)}</span>
                        <span class="faith-badges">
                          ${recommendedDeityIds().has(option.id) ? '<em class="faith-recommended">Подходит к клятве</em>' : ''}
                          <em>${escapeHtml(option.alignment)}</em>
                          ${(option.domains || []).map((domain) => `<em>${escapeHtml(domain)}</em>`).join('')}
                        </span>
                      </summary>
                      <div class="faith-description">
                        <p>${escapeHtml(option.description)}</p>
                        <dl>
                          <div><dt>Сфера</dt><dd>${escapeHtml(option.portfolio)}</dd></div>
                          <div><dt>Домены</dt><dd>${escapeHtml((option.domains || []).join(', '))}</dd></div>
                        </dl>
                      </div>
                    </details>`
                    : group.id === 'warlock-patron' && option.kind === 'patron'
                      ? `<details class="faith-disclosure">
                        <summary>
                          <span>${escapeHtml(option.name)}</span>
                          <span class="faith-badges">
                            ${option.subclassIds?.includes(selectedWarlockPatronPath()) ? '<em class="faith-recommended">Подходит к виду</em>' : ''}
                            <em>${escapeHtml(option.type)}</em>
                            <em>${escapeHtml(option.alignment)}</em>
                          </span>
                        </summary>
                        <div class="faith-description">
                          <p>${escapeHtml(option.description)}</p>
                          <dl>
                            <div><dt>Обитель</dt><dd>${escapeHtml(option.realm)}</dd></div>
                            <div><dt>Источник</dt><dd>${escapeHtml(option.source)}</dd></div>
                          </dl>
                          <p><strong>Идеи договора:</strong> ${escapeHtml(option.pactIdeas)}</p>
                          ${option.href ? `<p><a href="${escapeHtml(option.href)}" target="_blank" rel="noopener">Открыть карточку на D&D.su ↗</a></p>` : ''}
                        </div>
                      </details>`
                    : `${optionTitle}${detailLabel}`;

                return `<tr class="class-feature-choice-row">
                  <td class="class-feature-name">${label}</td>
                  <td>
                    <input
                      class="class-feature-check"
                      type="${inputType}"
                      name="${escapeHtml(key)}"
                      data-class-feature="${escapeHtml(group.id)}"
                      value="${escapeHtml(option.id)}"
                      ${checked ? 'checked' : ''}
                      aria-label="${escapeHtml(option.name)}"
                    >
                  </td>
                </tr>`;
              }).join('') || '<tr><td colspan="2" class="class-feature-empty-filter">Ничего не найдено.</td></tr>'}
            </tbody>
          </table>
          ${group.id === 'faith' || group.id === 'paladin-oath' || group.id === 'warlock-patron' || group.id === 'warlock-patron-path' ? '</div>' : ''}
          ${group.id === 'faith' && state.choices[key].includes('faith-other-deity') ? renderCustomDeityForm() : ''}
          ${group.id === 'warlock-patron' && state.choices[key].includes('patron-custom') ? renderCustomPatronForm() : ''}
        </div>
      </section>`;
    }).join('');

    warning.textContent = message;
    warning.hidden = !message;

    $('#weapon-mastery-search')?.addEventListener('input', (event) => {
      weaponMasterySearch = event.target.value.trim().toLocaleLowerCase('ru');
      renderClassFeatures();
      const search = $('#weapon-mastery-search');
      if (search) {
        search.focus();
        search.setSelectionRange(search.value.length, search.value.length);
      }
    });
    $('#weapon-mastery-category')?.addEventListener('change', (event) => {
      weaponMasteryCategory = event.target.value;
      renderClassFeatures();
    });
    $('#weapon-mastery-range')?.addEventListener('change', (event) => {
      weaponMasteryRange = event.target.value;
      renderClassFeatures();
    });
    $('#faith-search')?.addEventListener('input', (event) => {
      faithSearch = event.target.value.trim().toLocaleLowerCase('ru');
      renderClassFeatures();
      const search = $('#faith-search');
      if (search) {
        search.focus();
        search.setSelectionRange(search.value.length, search.value.length);
      }
    });
    $('#faith-alignment')?.addEventListener('change', (event) => {
      faithAlignment = event.target.value;
      renderClassFeatures();
    });
    $('#faith-domain')?.addEventListener('change', (event) => {
      faithDomain = event.target.value;
      renderClassFeatures();
    });
    $('#faith-sort')?.addEventListener('change', (event) => {
      faithSort = event.target.value;
      renderClassFeatures();
    });
    $('#patron-search')?.addEventListener('input', (event) => {
      patronSearch = event.target.value.trim().toLocaleLowerCase('ru');
      renderClassFeatures();
      const search = $('#patron-search');
      if (search) {
        search.focus();
        search.setSelectionRange(search.value.length, search.value.length);
      }
    });
    $('#patron-type')?.addEventListener('change', (event) => {
      patronType = event.target.value;
      renderClassFeatures();
    });
    $('#patron-alignment')?.addEventListener('change', (event) => {
      patronAlignment = event.target.value;
      renderClassFeatures();
    });
    $('#patron-sort')?.addEventListener('change', (event) => {
      patronSort = event.target.value;
      renderClassFeatures();
    });
    $('#adaptive-species-skill')?.addEventListener('change', (event) => {
      state.choices['species:adaptiveSkill'] = event.target.value ? [event.target.value] : [];
      saveState();
      renderClassFeatures();
      updatePreview();
    });
    $$('[data-adaptive-proficiency]').forEach((input) => input.addEventListener('change', () => {
      const limit = adaptiveSpeciesProficiencyConfig()?.flexibleCount || 0;
      syncAdaptiveSpeciesToolChoices({ migrateLegacy: true });
      const selected = selectedAdaptiveWeapons();
      if (input.checked && selected.length >= limit) {
        renderClassFeatures(`Уже выбрано максимальное количество оружия: ${limit}.`);
        return;
      }
      state.choices['species:adaptiveProficiencies'] = input.checked
        ? [...selected, input.value]
        : selected.filter((value) => value !== input.value);
      syncAdaptiveSpeciesToolChoices();
      saveState();
      renderClassFeatures();
      updatePreview();
    }));

    $$('[data-custom-deity]').forEach((field) => {
      field.addEventListener('input', () => {
        const key = field.dataset.customDeity;
        if (!key) return;
        getCustomDeity()[key] = field.value;
        saveState();
        updateNavigationChrome();
        renderProfileClassRelationships();
      });
    });
    $$('[data-custom-patron]').forEach((field) => {
      field.addEventListener('input', () => {
        const key = field.dataset.customPatron;
        if (!key) return;
        getCustomPatron()[key] = field.value;
        saveState();
        updateNavigationChrome();
        renderProfileClassRelationships();
      });
    });

    $$('[data-class-feature]').forEach((input) => input.addEventListener('change', () => {
      const group = groups.find((item) => item.id === input.dataset.classFeature);
      if (!group) return;

      const key = `classFeature:${group.id}`;

      if (group.count === 1) {
        state.choices[key] = input.checked ? [input.value] : [];
      } else {
        const selected = state.choices[key] || [];

        if (input.checked && selected.length >= group.count) {
          renderClassFeatures(`Для умения «${group.name}» уже выбрано максимальное количество.`);
          return;
        }

        state.choices[key] = input.checked
          ? [...selected, input.value]
          : selected.filter((value) => value !== input.value);
      }

      if (group.id === 'paladin-oath' || group.id === 'warlock-patron-path') {
        state.choices['class:subclass'] = [...state.choices[key]];
        state.subclass = state.choices[key][0] || null;
      }

      saveState();
      renderClassFeatures();
      renderProfileClassRelationships();
    }));

  }

  function renderOriginFeats(message = '') {
    const body = $('#origin-feats-table-body');
    const summary = $('#origin-feats-summary');
    const warning = $('#origin-feats-warning');
    const backgroundHeader = $('#origin-feats-background-header');
    const raceHeader = $('#origin-feats-race-header');
    const description = $('#origin-feats-description');
    const customSection = $('#custom-lineage-feats');
    const customBody = $('#custom-lineage-feat-table-body');
    const customSearch = $('#custom-lineage-feat-search');
    const customCounter = $('#custom-lineage-feat-counter');
    if (!body || !summary || !warning) return;

    const speciesBonusFeat = speciesGrantsExtraFeat();
    const customLineage = isCustomLineageSpecies();
    const backgroundFeatGrant = backgroundGrantsOriginFeat();
    const backgroundSelected = backgroundFeatGrant
      ? (state.choices['background:originFeat'] || []).slice(0, 1)
      : [];
    const speciesSelected = speciesBonusFeat ? (state.choices['species:originFeat'] || []).slice(0, 1) : [];

    if (backgroundSelected[0]) {
      const selectedFeat = allResolvedFeatOptions.find((feat) => feat.id === backgroundSelected[0]);
      if (!selectedFeat || !originFeatEligibility(selectedFeat)) backgroundSelected.length = 0;
    }
    if (speciesSelected[0]) {
      const selectedFeat = allResolvedFeatOptions.find((feat) => feat.id === speciesSelected[0]);
      if (!selectedFeat || !originFeatEligibility(selectedFeat)) speciesSelected.length = 0;
    }

    // Старые сохранения могли содержать одну и ту же неповторяемую черту
    // одновременно от предыстории и от вида. Сохраняем выбор предыстории,
    // а конфликтующий дополнительный выбор сбрасываем.
    if (
      backgroundSelected[0] &&
      speciesSelected[0] &&
      backgroundSelected[0] === speciesSelected[0] &&
      !isRepeatableOriginFeat(backgroundSelected[0])
    ) {
      speciesSelected.length = 0;
    }

    state.choices['background:originFeat'] = backgroundSelected;
    state.choices['species:originFeat'] = speciesSelected;

    summary.innerHTML = `
      ${backgroundFeatGrant ? `<div class="origin-feats-summary-card"><span>Предыстория</span><strong>${backgroundSelected.length}/1</strong></div>` : ''}
      ${speciesBonusFeat && !customLineage ? `<div class="origin-feats-summary-card"><span>Вид</span><strong>${speciesSelected.length}/1</strong></div>` : ''}
    `;

    if (backgroundHeader) backgroundHeader.hidden = !backgroundFeatGrant;

    if (raceHeader) {
      raceHeader.hidden = !speciesBonusFeat || customLineage;
      raceHeader.textContent = 'От вида';
      raceHeader.title = '';
    }

    if (description) {
      description.textContent = isCustomBackground()
        ? '«Своя предыстория» предоставляет одну на выбор из 12 основных черт происхождения.'
        : backgroundFeatGrant
        ? (speciesBonusFeat
          ? 'Предыстория предоставляет одну из 12 стандартных черт происхождения. Вид также даёт дополнительную черту; неповторяемую черту нельзя выбрать из двух источников одновременно.'
          : 'Выберите одну из 12 стандартных черт происхождения, предоставленных предысторией.')
        : speciesBonusFeat
          ? 'Выбранная предыстория не предоставляет черту. Здесь показана только дополнительная черта от вида.'
          : 'Выбранные предыстория и вид не предоставляют черту. Этап можно продолжить без выбора.';
    }

    const backgroundFeatOptions = getBackgroundOriginFeatOptions();
    const tableFeatOptions = Array.from(new Map([
      ...backgroundFeatOptions,
      ...(speciesBonusFeat && !customLineage ? featOptions : [])
    ].map((feat) => [feat.id, feat])).values())
      .filter((feat) => originFeatEligibility(feat));
    body.innerHTML = tableFeatOptions.map((feat) => {
      const fromBackground = backgroundSelected.includes(feat.id);
      const fromSpecies = speciesSelected.includes(feat.id);
      const repeatable = isRepeatableOriginFeat(feat.id);
      const backgroundDisabled = fromSpecies && !repeatable;
      const speciesDisabled = fromBackground && !repeatable;
      const selectedSpeciesName = findSpecies()?.name || 'выбранный вид';
      const speciesSelectionLabel = customLineage
        ? 'Уже выбрана видом «Своё происхождение»'
        : `Уже выбрана видом «${selectedSpeciesName}»`;
      const backgroundAlreadySelectedLabel = backgroundDisabled
        ? `<small class="origin-feat-already-selected">${escapeHtml(speciesSelectionLabel)}</small>`
        : '';
      return `<tr class="${backgroundDisabled ? 'is-disabled' : ''} ${speciesDisabled ? 'is-cross-source-blocked' : ''}">
        <td class="origin-feat-name"><a href="/feats/${encodeURIComponent(feat.id)}" target="_blank" rel="noopener">${escapeHtml(feat.name)}</a><small>${escapeHtml(feat.nameEn || '')}</small>${backgroundAlreadySelectedLabel}</td>
        ${backgroundFeatGrant ? `<td><input class="origin-feat-check" type="checkbox" autocomplete="off" data-origin-feat-source="background" value="${escapeHtml(feat.id)}" ${fromBackground ? 'checked' : ''} ${backgroundDisabled ? `disabled title="${escapeHtml(speciesSelectionLabel)}"` : ''} aria-label="${escapeHtml(feat.name)}: от предыстории"></td>` : ''}
        ${speciesBonusFeat && !customLineage ? `<td><input class="origin-feat-check" type="checkbox" autocomplete="off" data-origin-feat-source="species" value="${escapeHtml(feat.id)}" ${fromSpecies ? 'checked' : ''} ${speciesDisabled ? 'disabled title="Уже выбрана в другой таблице"' : ''} aria-label="${escapeHtml(feat.name)}: от вида"></td>` : ''}
      </tr>`;
    }).join('') || '<tr><td class="origin-feat-empty">Выбранная предыстория и вид не предоставляют черту на этом этапе.</td></tr>';

    const renderCustomLineageTable = () => {
      if (!customSection || !customBody) return;
      customSection.hidden = !customLineage;
      if (!customLineage) return;
      const query = String(customSearch?.value || '').trim().toLocaleLowerCase('ru');
      const normalizeRequirements = (requirements) => {
        if (Array.isArray(requirements)) return requirements.join(' ');
        if (requirements == null) return '';
        return String(requirements);
      };
      const originFeatIds = new Set(featOptions.map((feat) => feat.id));
      const options = allSelectableFeatOptions.filter((feat) => {
        if (feat.type === 'origin' && !originFeatEligibility(feat)) return false;
        const haystack = `${feat.name || ''} ${feat.nameEn || ''} ${normalizeRequirements(feat.requirements)}`.toLocaleLowerCase('ru');
        return !query || haystack.includes(query);
      });
      if (customCounter) customCounter.textContent = `${speciesSelected.length}/1`;
      customBody.innerHTML = options.map((feat) => {
        const selected = speciesSelected.includes(feat.id);
        const repeatable = isRepeatableOriginFeat(feat.id);
        const selectedByBackground = backgroundSelected.includes(feat.id);
        const disabled = selectedByBackground && !repeatable;
        const isOriginFeat = originFeatIds.has(feat.id);
        const typeBadge = isOriginFeat
          ? '<small class="origin-feat-type origin-feat-type-origin">Черта происхождения</small>'
          : '<small class="origin-feat-type origin-feat-type-general">Общая черта</small>';
        const requirements = normalizeRequirements(feat.requirements);
        const requirementsLabel = requirements
          ? `<small class="origin-feat-requirements">Требования: ${escapeHtml(requirements)}</small>`
          : '';
        const alreadySelectedLabel = disabled
          ? '<small class="origin-feat-already-selected">Уже выбрана от предыстории</small>'
          : '';
        return `<tr class="${selected ? 'is-selected' : ''} ${disabled ? 'is-disabled' : ''}">
          <td class="origin-feat-name"><a href="/feats/${encodeURIComponent(feat.id)}" target="_blank" rel="noopener">${escapeHtml(feat.name)}</a><small>${escapeHtml(feat.nameEn || '')}</small>${typeBadge}${requirementsLabel}${alreadySelectedLabel}</td>
          <td><input class="origin-feat-check" type="checkbox" autocomplete="off" data-origin-feat-source="species" value="${escapeHtml(feat.id)}" ${selected ? 'checked' : ''} ${disabled ? 'disabled title="Уже выбрана в другой таблице"' : ''} aria-label="${escapeHtml(feat.name)}: от Своего происхождения"></td>
        </tr>`;
      }).join('') || '<tr><td colspan="2" class="origin-feat-empty">По вашему запросу ничего не найдено.</td></tr>';
      bindOriginFeatInputs();
    };

    const selectOriginFeat = (source, value) => {
      const key = source === 'species' ? 'species:originFeat' : 'background:originFeat';
      const otherKey = source === 'species' ? 'background:originFeat' : 'species:originFeat';
      const current = state.choices[key]?.[0] || '';
      const feat = allResolvedFeatOptions.find((item) => item.id === value);

      if (!feat || !originFeatEligibility(feat)) {
        renderOriginFeats('Эта черта недоступна: необходимые условия не выполнены.');
        return;
      }

      if ((state.choices[otherKey] || []).includes(value) && !isRepeatableOriginFeat(value)) {
        renderOriginFeats('Одну и ту же черту нельзя выбрать дважды. Исключение: «Одарённый» и «Посвящённый в магию».');
        return;
      }

      if (current) clearOriginFeatSourceChoices(source);

      // Единственный источник истины — state. DOM никогда не переключаем вручную.
      // Повторный клик по уже выбранной черте снимает выбор; клик по другой заменяет его.
      state.choices[key] = current === value ? [] : [value];
      state.choices['feat:skills'] = [];
      state.choices['feat:tools'] = [];
      state.choices['feat:languages'] = [];

      saveState();
      renderOriginFeats();
      updatePreview();
    };

    const bindOriginFeatContainer = (container) => {
      if (!container) return;

      // Используем click + preventDefault, чтобы браузер не успевал сам
      // поставить несколько галочек до перерисовки. Выбор вычисляется только из state.
      container.onclick = (event) => {
        const target = event.target;
        const input = target instanceof Element
          ? target.closest('[data-origin-feat-source]')
          : null;
        if (!(input instanceof HTMLInputElement)) return;

        event.preventDefault();
        event.stopPropagation();
        selectOriginFeat(input.dataset.originFeatSource, input.value);
      };

      container.onchange = null;
    };

    const bindOriginFeatInputs = () => {
      bindOriginFeatContainer(body);
      bindOriginFeatContainer(customBody);
    };

    warning.textContent = message;
    warning.hidden = !message;
    bindOriginFeatInputs();
    renderCustomLineageTable();
    if (customSearch) {
      // По той же причине не сохраняем старое замыкание поиска.
      customSearch.oninput = renderCustomLineageTable;
    }
    renderOriginFeatExtraChoices();
  }

  function renderOriginFeatExtraChoices() {
    const container = $('#origin-feats-extra-choices');
    if (!container) return;
    const magicEntries = selectedOriginFeatEntries().filter((entry) => entry.id === 'magic-initiate');
    const scionEntries = selectedOriginFeatEntries().filter((entry) => entry.id === 'scion-of-the-outer-planes');
    const giantStrikeEntries = selectedOriginFeatEntries().filter((entry) => entry.id === 'strike-of-the-giants');
    const activeMagicSources = new Set(magicEntries.map((entry) => entry.source));
    const activeScionSources = new Set(scionEntries.map((entry) => entry.source));
    const activeGiantStrikeSources = new Set(giantStrikeEntries.map((entry) => entry.source));
    ['background', 'species'].forEach((source) => {
      if (!activeMagicSources.has(source)) {
        delete state.choices[`feat:${source}:magic-list`];
        delete state.choices[`feat:${source}:spell-ability`];
      }
      if (!activeScionSources.has(source)) {
        delete state.choices[`feat:${source}:scion-plane`];
        delete state.choices[`feat:${source}:scion-spell-ability`];
      }
      if (!activeGiantStrikeSources.has(source)) {
        delete state.choices[`feat:${source}:giant-strike`];
      }
    });
    if (!magicEntries.length && !scionEntries.length && !giantStrikeEntries.length) {
      container.innerHTML = '';
      return;
    }
    const sourceNames = { background: 'от предыстории', species: 'от расы' };
    const choices = [];
    for (const entry of magicEntries) {
      const otherEntry = magicEntries.find((candidate) => candidate.source !== entry.source);
      const otherList = otherEntry
        ? (state.choices[`feat:${otherEntry.source}:magic-list`] || [])[0]
        : '';
      choices.push({
        id:`feat:${entry.source}:magic-list`,
        title:'Список заклинаний',
        description:'Выберите список Жреца, Друида или Волшебника. При повторном получении черты нужно выбрать другой список.',
        count:1,
        options:[
          {value:'cleric',label:'Жрец'},
          {value:'druid',label:'Друид'},
          {value:'wizard',label:'Волшебник'}
        ].map((option) => ({
          ...option,
          disabled: option.value === otherList,
          reason: option.value === otherList ? 'Этот список уже выбран для второго «Посвящённого в магию».' : ''
        })),
        source:`Черта: ${entry.feat.name} (${sourceNames[entry.source]})`
      });
      choices.push({ id:`feat:${entry.source}:spell-ability`, title:'Заклинательная характеристика', description:'Выберите характеристику для заклинаний этой черты.', count:1, options:['Интеллект','Мудрость','Харизма'], source:`Черта: ${entry.feat.name} (${sourceNames[entry.source]})` });
    }
    for (const entry of scionEntries) {
      choices.push({
        id: `feat:${entry.source}:scion-plane`,
        title: 'Планарное влияние',
        description: 'Выбранный план определяет сопротивление урону и автоматически получаемый заговор.',
        count: 1,
        options: SCION_PLAN_OPTIONS.map((plan) => ({
          value: plan.value,
          label: `${plan.label} — ${plan.resistance} — ${plan.cantrip}`
        })),
        source: `Черта: ${entry.feat.name} (${sourceNames[entry.source]})`
      });
      choices.push({
        id: `feat:${entry.source}:scion-spell-ability`,
        title: 'Заклинательная характеристика',
        description: 'Выберите характеристику для заговора, полученного от выбранного плана.',
        count: 1,
        options: ['Интеллект', 'Мудрость', 'Харизма'],
        source: `Черта: ${entry.feat.name} (${sourceNames[entry.source]})`
      });
    }
    for (const entry of giantStrikeEntries) {
      choices.push({
        id: `feat:${entry.source}:giant-strike`,
        title: 'Преимущество великана',
        description: 'Выберите один удар. Выбранный вариант определяет дополнительный урон и эффект черты.',
        count: 1,
        options: GIANT_STRIKE_OPTIONS.map((strike) => ({
          value: strike.value,
          label: `${strike.label} — ${strike.summary}`
        })),
        source: `Черта: ${entry.feat.name} (${sourceNames[entry.source]})`
      });
    }
    renderBackgroundChoiceCards(container, choices);
  }

  function originFeatsComplete() {
    const backgroundFeatGrant = backgroundGrantsOriginFeat();
    const backgroundId = state.choices['background:originFeat']?.[0];
    const speciesId = state.choices['species:originFeat']?.[0];
    const basicComplete = (!backgroundFeatGrant || Boolean(backgroundId))
      && (!speciesGrantsExtraFeat() || Boolean(speciesId))
      && !(backgroundId && speciesId && backgroundId === speciesId && !isRepeatableOriginFeat(backgroundId));
    if (!basicComplete) return false;
    const magicEntries = selectedOriginFeatEntries().filter((entry) => entry.id === 'magic-initiate');
    const magicLists = magicEntries.map((entry) => (state.choices[`feat:${entry.source}:magic-list`] || [])[0]).filter(Boolean);
    const magicComplete = new Set(magicLists).size === magicLists.length
      && magicEntries.every((entry) =>
        (state.choices[`feat:${entry.source}:magic-list`] || []).length === 1
        && (state.choices[`feat:${entry.source}:spell-ability`] || []).length === 1
      );
    const scionEntries = selectedOriginFeatEntries().filter((entry) => entry.id === 'scion-of-the-outer-planes');
    const scionComplete = scionEntries.every((entry) =>
      (state.choices[`feat:${entry.source}:scion-plane`] || []).length === 1
      && (state.choices[`feat:${entry.source}:scion-spell-ability`] || []).length === 1
    );
    const giantStrikeEntries = selectedOriginFeatEntries().filter((entry) => entry.id === 'strike-of-the-giants');
    const giantStrikeComplete = giantStrikeEntries.every((entry) =>
      (state.choices[`feat:${entry.source}:giant-strike`] || []).length === 1
    );
    return magicComplete && scionComplete && giantStrikeComplete;
  }

  function renderBackgroundChoiceCards(container, choices) {
    if (!container) return;
    if (!choices.length) {
      container.innerHTML = '';
      return;
    }

    const characteristicConfigs = {
      'background:traits': {
        key: 'traits',
        labels: ['Своя черта характера 1', 'Своя черта характера 2'],
        help: 'Черты характера — заметные привычки, манеры речи и повторяющиеся особенности поведения героя. Для персонажа нужны две разные черты.'
      },
      'background:ideal': {
        key: 'ideal',
        labels: ['Свой идеал'],
        help: 'Идеал — главный принцип или убеждение героя: то, чем он руководствуется, когда принимает важные решения.'
      },
      'background:bond': {
        key: 'bond',
        labels: ['Своя привязанность'],
        help: 'Привязанность — человек, место, организация, предмет или цель, ради которых герой готов рисковать и действовать.'
      },
      'background:flaw': {
        key: 'flaw',
        labels: ['Своя слабость'],
        help: 'Слабость — страх, порок или недостаток, который способен осложнить жизнь герою и повлиять на его решения.'
      }
    };
    const ensureCustomCharacteristics = () => {
      state.backgroundCharacteristics = {
        ...structuredClone(defaultState.backgroundCharacteristics || {}),
        ...(state.backgroundCharacteristics || {})
      };
      Object.values(characteristicConfigs).forEach((config) => {
        const current = state.backgroundCharacteristics[config.key];
        state.backgroundCharacteristics[config.key] = Array.from(
          { length: config.labels.length },
          (_, index) => String(Array.isArray(current) ? current[index] || '' : '')
        );
      });
    };
    const syncCustomCharacteristicChoice = (choice) => {
      const config = characteristicConfigs[choice.id];
      if (!config) return;
      ensureCustomCharacteristics();
      const predefined = new Set(normalizeOptions(choice.options).map((option) => option.value));
      const selectedPredefined = (state.choices[choice.id] || [])
        .filter((value) => predefined.has(value));
      const customValues = state.backgroundCharacteristics[config.key]
        .map((value) => String(value || '').trim())
        .filter(Boolean);
      const availablePredefinedSlots = Math.max(0, choice.count - customValues.length);
      state.choices[choice.id] = [
        ...selectedPredefined.slice(0, availablePredefinedSlots),
        ...customValues
      ].slice(0, choice.count);
    };
    ensureCustomCharacteristics();
    choices.forEach(syncCustomCharacteristicChoice);

    container.innerHTML = `
      <div class="inline-choice-title">
        <span class="section-kicker">Детали прошлого</span>
        <h3>Настрой особенности предыстории</h3>
        <p>Черты характера, идеал, привязанность и слабость обязательны. Остальные таблицы можно пропустить.</p>
      </div>
      <div class="pending-choices">
        ${choices.map((choice) => {
          const selected = Array.isArray(state.choices[choice.id]) ? state.choices[choice.id] : [];
          const options = normalizeOptions(choice.options);
          const isCharacteristicChoice = ['background:traits','background:ideal','background:bond','background:flaw'].includes(choice.id);
          const characteristicConfig = characteristicConfigs[choice.id];
          return `
            <section class="pending-choice-card ${isCharacteristicChoice ? 'is-characteristic-list' : ''} ${choice.optional ? 'is-optional' : ''}">
              <div class="pending-choice-head">
                <div><span>${escapeHtml(choice.source)}</span><h3>${escapeHtml(choice.title)}</h3></div>
                <div class="choice-head-actions">
                  ${choice.randomizable ? `<button type="button" class="choice-random-button" data-random-choice="${escapeHtml(choice.id)}">Случайно</button>` : ''}
                  ${choice.optional ? '<em class="optional-choice-badge">Необязательно</em>' : ''}
                  <strong>${selected.length}/${choice.count}</strong>
                </div>
              </div>
              <p>${escapeHtml(choice.description || '')}</p>
              <div class="${isCharacteristicChoice ? 'characteristic-option-list' : 'dynamic-option-grid'}">
                ${options.map((option, optionIndex) => {
                  const alignmentMarker = choice.id === 'background:ideal'
                    ? String(option.label || '').match(/\(([^)]+)\)\s*$/)?.[1] || ''
                    : '';
                  return `
                  <label class="${isCharacteristicChoice ? 'characteristic-option-row' : 'dynamic-option'} ${option.disabled ? 'is-disabled' : ''}" ${option.reason ? `title="${escapeHtml(option.reason)}"` : ''}>
                    <input type="${choice.count > 1 || choice.optional ? 'checkbox' : 'radio'}"
                      name="${escapeHtml(choice.id)}"
                      value="${escapeHtml(option.value)}"
                      data-background-choice="${escapeHtml(choice.id)}"
                      ${selected.includes(option.value) ? 'checked' : ''}
                      ${option.disabled ? 'disabled' : ''}>
                    ${isCharacteristicChoice ? `<span class="characteristic-number">${optionIndex + 1}</span>` : ''}
                    <span class="characteristic-option-copy">${escapeHtml(option.label)}</span>
                    ${alignmentMarker ? `<em class="alignment-requirement">${escapeHtml(alignmentMarker)}</em>` : ''}
                    ${option.disabled ? '<small>Недоступно</small>' : ''}
                  </label>`;
                }).join('')}
              </div>
              ${characteristicConfig ? `
                <div class="custom-characteristic-fields">
                  <div>
                    <strong>Или напишите свой вариант</strong>
                    <p>${escapeHtml(characteristicConfig.help)}</p>
                  </div>
                  <div class="custom-characteristic-grid">
                    ${characteristicConfig.labels.map((label, index) => `
                      <label>
                        <span>${escapeHtml(label)}</span>
                        <textarea
                          rows="2"
                          maxlength="800"
                          data-custom-characteristic="${escapeHtml(characteristicConfig.key)}"
                          data-custom-characteristic-index="${index}"
                          placeholder="${escapeHtml(label)}">${escapeHtml(state.backgroundCharacteristics[characteristicConfig.key][index] || '')}</textarea>
                      </label>
                    `).join('')}
                  </div>
                </div>
              ` : ''}
              <div class="choice-error" data-choice-error="${escapeHtml(choice.id)}"></div>
            </section>
          `;
        }).join('')}
      </div>`;

    $$('[data-random-choice]').forEach((button) => button.addEventListener('click', () => {
      const id = button.dataset.randomChoice;
      const choice = choices.find((item) => item.id === id);
      if (!choice) return;
      const customConfig = characteristicConfigs[id];
      if (customConfig) {
        state.backgroundCharacteristics[customConfig.key] = customConfig.labels.map(() => '');
      }
      const available = normalizeOptions(choice.options).filter((option) => !option.disabled);
      const shuffled = [...available].sort(() => Math.random() - 0.5);
      state.choices[id] = shuffled.slice(0, choice.count).map((option) => option.value);
      saveState();
      renderBackgroundDetails();
    }));

    $$('[data-background-choice]').forEach((input) => input.addEventListener('change', () => {
      const id = input.dataset.backgroundChoice;
      const choice = choices.find((item) => item.id === id);
      let selected = Array.isArray(state.choices[id]) ? [...state.choices[id]] : [];
      const customConfig = characteristicConfigs[id];
      if (input.checked && customConfig && choice.count === 1) {
        state.backgroundCharacteristics[customConfig.key] = customConfig.labels.map(() => '');
      }

      if (input.type === 'radio') selected = input.checked ? [input.value] : [];
      else if (input.checked) {
        if (selected.length >= choice.count) {
          input.checked = false;
          const error = $(`[data-choice-error="${id}"]`);
          if (error) error.textContent = `Можно выбрать только ${choice.count}.`;
          return;
        }
        if (!selected.includes(input.value)) selected.push(input.value);
      } else selected = selected.filter((value) => value !== input.value);

      state.choices[id] = selected;
      saveState();
      if (input.closest('#origin-feats-extra-choices')) renderOriginFeats();
      else renderBackgroundDetails();
    }));

    $$('[data-custom-characteristic]').forEach((field) => field.addEventListener('input', () => {
      const key = field.dataset.customCharacteristic;
      const index = Number(field.dataset.customCharacteristicIndex);
      const choice = choices.find((item) => characteristicConfigs[item.id]?.key === key);
      if (!choice || !Number.isInteger(index)) return;
      state.backgroundCharacteristics[key][index] = field.value;
      syncCustomCharacteristicChoice(choice);
      const selectedNow = new Set(state.choices[choice.id]);
      $$(`[data-background-choice="${choice.id}"]`).forEach((input) => {
        input.checked = selectedNow.has(input.value);
      });
      const counter = field.closest('.pending-choice-card')?.querySelector('.choice-head-actions > strong');
      if (counter) counter.textContent = `${state.choices[choice.id].length}/${choice.count}`;
      saveState();
      updateNavigationChrome();
    }));
  }


  function characteristicText(item, labelKey) {
    if (typeof item === 'string') return item;
    return item?.[labelKey] || item?.trait || item?.ideal || item?.bond || item?.flaw || item?.result || String(item || '');
  }

  function hasUsefulCharacteristics(items, labelKey) {
    return Array.isArray(items) && items.some((item) => {
      const text = characteristicText(item, labelKey).trim();
      return text && text !== '-';
    });
  }

  function characteristicOptions(background, key, labelKey) {
    const own = background?.characteristics?.[key] || [];
    const source = hasUsefulCharacteristics(own, labelKey)
      ? own.filter((item) => characteristicText(item, labelKey).trim() !== '-')
      : GENERIC_BACKGROUND_CHARACTERISTICS[key] || [];
    return source.map((item) => {
      const text = characteristicText(item, labelKey);
      return { value: text, label: text };
    });
  }

  function backgroundVariantChoiceLimit(background) {
    const description = String(background?.variants?.description || '')
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е');
    const numericMaximum = description.match(/(?:до|от\s+\d+\s+до)\s+(\d+)/)?.[1];
    if (numericMaximum) return Math.max(1, Number(numericMaximum));
    if (/до\s+трех|от\s+одного\s+до\s+трех/.test(description)) return 3;
    if (/до\s+двух|от\s+одного\s+до\s+двух/.test(description)) return 2;
    return 1;
  }


