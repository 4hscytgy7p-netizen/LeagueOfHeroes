  function selectedSpeciesAgeRange() {
    const species = findSpecies();
    if (!species) return null;
    const range = SPECIES_AGE_RANGES[species.id];
    return Array.isArray(range) ? { min: range[0], max: range[1] } : null;
  }

  function updateAgeInputBounds({ normalize = true } = {}) {
    const input = $('#character-age');
    const hint = $('#character-age-range');
    if (!input) return;

    const range = selectedSpeciesAgeRange();
    if (!range) {
      input.removeAttribute('min');
      input.removeAttribute('max');
      input.placeholder = state.species ? 'Укажите возраст' : 'Сначала выберите вид';
      input.setCustomValidity('');
      if (hint) hint.textContent = state.species
        ? 'Для этого вида возрастные пределы не указаны.'
        : 'Сначала выберите вид.';
      return;
    }

    input.min = String(range.min);
    input.max = String(range.max);
    input.placeholder = `${range.min}–${range.max} лет`;
    if (hint) hint.textContent = `Допустимый возраст: от ${range.min} до ${range.max} лет.`;

    if (input.value === '') {
      input.setCustomValidity('');
      return;
    }

    const value = Number(input.value);
    if (!Number.isFinite(value)) return;
    if (normalize && (value < range.min || value > range.max)) {
      const normalized = Math.min(range.max, Math.max(range.min, Math.round(value)));
      input.value = String(normalized);
      state.profile.age = String(normalized);
      saveState();
    }
    const current = Number(input.value);
    input.setCustomValidity(
      current < range.min || current > range.max
        ? `Укажите возраст от ${range.min} до ${range.max} лет.`
        : ''
    );
  }

