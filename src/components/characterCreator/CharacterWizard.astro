  function fullAlignmentName(value) {
    const alignmentNames = {
      'ЗД': 'Законно-доброе',
      'НД': 'Нейтрально-доброе',
      'ХД': 'Хаотично-доброе',
      'ЗН': 'Законно-нейтральное',
      'Н': 'Нейтральное',
      'ХН': 'Хаотично-нейтральное',
      'ЗЗ': 'Законно-злое',
      'НЗ': 'Нейтрально-злое',
      'ХЗ': 'Хаотично-злое',
      'Любое': 'Любое'
    };
    const normalized = String(value || '').trim();
    return alignmentNames[normalized] || normalized;
  }

  function renderProfileClassRelationships() {
    const container = $('#profile-class-relationships');
    if (!container) return;
    const section = $('#automatic-class-relationships');
    const alliesLabel = $('#profile-allies-label');
    const alliesHelp = $('#profile-allies-help');

    const groups = getClassFeatureGroups();
    const configs = [
      { groupId: 'paladin-oath', label: 'Священная клятва', fallback: 'class:subclass' },
      { groupId: 'faith', label: 'Божество или духовный путь' },
      { groupId: 'warlock-patron', label: 'Потусторонний покровитель' }
    ];

    const relationships = configs.flatMap((config) => {
      const group = groups.find((item) => item.id === config.groupId);
      if (!group) return [];

      const selectedId =
        state.choices[`classFeature:${config.groupId}`]?.[0]
        || (config.fallback ? state.choices[config.fallback]?.[0] : '')
        || '';
      const option = group.options?.find((item) => item.id === selectedId);
      if (!option) return [];

      const details = [
        option.detail,
        option.type ? `Вид: ${option.type}` : '',
        option.alignment ? `Мировоззрение: ${fullAlignmentName(option.alignment)}` : '',
        Array.isArray(option.domains) && option.domains.length
          ? `Домены: ${option.domains.join(', ')}`
          : '',
        option.realm ? `Обитель: ${option.realm}` : '',
        option.description
      ].filter(Boolean);

      return [{
        label: config.label,
        name: option.name || selectedId,
        description: details.join('\n')
      }];
    });

    if (!relationships.length) {
      if (section) section.hidden = true;
      container.innerHTML = '';
      if (alliesLabel) alliesLabel.textContent = 'Союзники и организации';
      if (alliesHelp) {
        alliesHelp.textContent = 'Опишите организации, группы и отдельных союзников персонажа.';
      }
      return;
    }

    if (section) section.hidden = false;
    if (alliesLabel) alliesLabel.textContent = 'Дополнительные союзники и организации';
    if (alliesHelp) {
      alliesHelp.textContent = 'Этот текст будет добавлен к выбранным выше связям и не заменит их.';
    }
    container.innerHTML = relationships.map((relationship) => `
      <article class="profile-relationship-card">
        <span>${escapeHtml(relationship.label)}</span>
        <strong>${escapeHtml(relationship.name)}</strong>
        ${relationship.description ? `<p>${escapeHtml(relationship.description)}</p>` : ''}
      </article>
    `).join('');
  }

  function classFeaturesComplete() {
    return adaptiveSpeciesClassFeatureChoicesComplete() && getClassFeatureGroups().every((group) => {
      const selected = group.id === 'paladin-oath' || group.id === 'warlock-patron-path'
        ? (state.choices[`classFeature:${group.id}`] || state.choices['class:subclass'] || [])
        : (state.choices[`classFeature:${group.id}`] || []);
      if (selected.length !== group.count) return false;
      if (group.id === 'faith' && selected.includes('faith-other-deity')) {
        const custom = getCustomDeity();
        return ['name', 'alignment', 'domains', 'portfolio', 'symbol', 'description']
          .every((key) => String(custom[key] || '').trim());
      }
      if (group.id === 'warlock-patron' && selected.includes('patron-custom')) {
        const custom = getCustomPatron();
        return ['name', 'type', 'alignment', 'realm', 'description', 'pactTerms', 'manifestation', 'goals']
          .every((key) => String(custom[key] || '').trim());
      }
      return true;
    });
  }

