<section class="wizard-step" data-step="equipment">
  <div class="equipment-heading">
    <span class="wizard-kicker">Глава девятая</span>
    <h2>Закупи снаряжение</h2>
    <p>Выберите готовый набор класса или получите стартовое золото и закупитесь самостоятельно.</p>
  </div>

  <div class="equipment-toolbar">
    <div class="equipment-summary">
      <article><span>Осталось денег</span><strong id="equipment-gold">0 зм</strong></article>
      <article><span>Общий вес</span><strong id="equipment-weight">0 фнт.</strong></article>
    </div>

    <div id="equipment-actions" class="equipment-actions">
      <button id="equipment-sell-all" class="equipment-action equipment-action-secondary" type="button">Продать всё</button>
      <button id="equipment-confirm-purchase" class="equipment-action equipment-action-primary" type="button" hidden>Подтвердить закупку</button>
      <button id="equipment-repurchase" class="equipment-action equipment-action-primary" type="button" hidden>Перезакупиться</button>
    </div>
  </div>

  <p id="equipment-warning" class="equipment-warning" hidden></p>
  <div id="equipment-mode-note" class="equipment-mode-note"></div>

  <section id="equipment-variant-section" class="equipment-variant-section" hidden>
    <div class="equipment-variant-heading">
      <span>Стартовое снаряжение класса</span>
      <h3>Выберите набор</h3>
    </div>
    <div id="equipment-variants" class="equipment-variants"></div>
  </section>

  <div id="equipment-layout" class="equipment-layout">
    <section class="equipment-panel">
      <div class="equipment-panel-head">
        <div><span>Персонаж</span><h3>Инвентарь</h3></div>
      </div>
      <div id="equipment-inventory" class="equipment-inventory"></div>
    </section>

    <section id="equipment-shop-panel" class="equipment-panel">
      <div class="equipment-panel-head equipment-shop-head">
        <div><span>Торговец</span><h3>Магазин</h3></div>
        <label><span>Поиск</span><input id="equipment-search" type="search" placeholder="Название предмета…" /></label>
        <label><span>Категория</span><select id="equipment-category">
          <option value="all">Все</option>
          <option value="gear">Снаряжение приключенца</option>
          <option value="ammo">Боеприпасы</option>
          <option value="focus">Фокусировки</option>
          <option value="weapon">Оружие</option>
          <option value="armor">Доспехи и щиты</option>
          <option value="tools">Инструменты</option>
        </select></label>
      </div>
      <div class="equipment-shop-wrap">
        <table class="equipment-shop-table"><thead><tr><th>Предмет</th><th>Цена</th><th>Вес</th><th></th></tr></thead><tbody id="equipment-shop"></tbody></table>
      </div>
    </section>
  </div>
</section>

