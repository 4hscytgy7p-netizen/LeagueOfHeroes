<section class="wizard-step" data-step="tools">
  <div class="choice-heading"><span class="wizard-kicker">Глава восьмая</span><h2>Выбери владения инструментами</h2><p>Любая предыстория даёт одно владение любым инструментом. Класс, вид и черты могут давать дополнительные владения. Один инструмент нельзя получить дважды.</p></div>
  <div class="tools-class-note" id="tools-class-note" hidden></div>
  <div class="choice-warning" id="tools-warning" hidden></div>
  <div class="choice-wrap"><div class="choice-inner">
    <div class="choice-summary-row"><div class="choice-summary-spacer"></div><div class="choice-summary" id="tools-summary"></div></div>
    <table class="choice-table"><thead><tr><th>Инструмент</th><th>От класса</th><th>От предыстории</th><th>От вида</th><th>От черты</th></tr></thead><tbody id="tools-table-body"></tbody></table>
  </div></div>
</section>

<style>
  .choice-heading{margin-bottom:1.15rem}.choice-heading h2{margin:.35rem 0 .55rem;font-family:Georgia,serif;font-size:clamp(1.9rem,3.5vw,3rem)}.choice-heading p{margin:0;max-width:780px;opacity:.68}
  .tools-class-note{margin:-.25rem 0 1rem;padding:.85rem 1rem;border-left:4px solid var(--wizard-gold);border-radius:.45rem;background:color-mix(in srgb,var(--wizard-gold) 9%,var(--card-bg));line-height:1.45}.tools-class-note :global(strong){display:block;margin-bottom:.25rem;color:var(--wizard-gold-light);font-family:Georgia,serif;font-size:1.05rem}.tools-class-note :global(p){margin:0;opacity:.82}.tools-class-note :global(p+p){margin-top:.4rem}
  .choice-warning{margin-bottom:.8rem;padding:.75rem .9rem;border:1px solid color-mix(in srgb,#ef4444 55%,var(--card-border));border-radius:.6rem;background:color-mix(in srgb,#ef4444 10%,transparent)}
  .choice-warning.is-info{border-color:color-mix(in srgb,var(--wizard-gold) 55%,var(--card-border));background:color-mix(in srgb,var(--wizard-gold) 10%,transparent)}
  .choice-wrap{box-sizing:border-box;width:100%;max-width:100%;min-width:0;overflow-x:auto;overflow-y:hidden;overscroll-behavior-inline:contain;scrollbar-gutter:stable;border:1px solid color-mix(in srgb,var(--wizard-gold) 35%,var(--card-border));border-radius:.8rem;background:color-mix(in srgb,var(--background) 92%,#000)}
  .choice-inner{min-width:720px}.choice-summary-row{display:grid;grid-template-columns:26% 74%;border-bottom:1px solid color-mix(in srgb,var(--wizard-gold) 30%,var(--card-border));background:color-mix(in srgb,var(--card-bg) 88%,#000)}
  .choice-summary-spacer{min-height:72px;border-right:1px solid color-mix(in srgb,var(--card-border) 55%,transparent)}.choice-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
  :global(.choice-summary-card){min-width:0;min-height:72px;padding:.6rem .35rem;display:flex;flex-direction:column;align-items:center;justify-content:center;border-right:1px solid color-mix(in srgb,var(--card-border) 55%,transparent);text-align:center}
  :global(.choice-summary-card span){max-width:100%;font-size:.64rem;line-height:1.15;text-transform:uppercase;letter-spacing:.055em;opacity:.72;overflow-wrap:anywhere}:global(.choice-summary-card strong){margin-top:.3rem;color:var(--wizard-gold-light);font-family:Georgia,serif;font-size:1.1rem}:global(.choice-summary-card small){max-width:100%;margin-top:.2rem;font-size:.58rem;line-height:1.2;opacity:.62;text-align:center;overflow-wrap:anywhere}
  .choice-table{width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed}.choice-table th,.choice-table :global(td){height:42px;padding:.48rem .45rem;border-bottom:1px solid color-mix(in srgb,var(--card-border) 72%,transparent);border-right:1px solid color-mix(in srgb,var(--card-border) 55%,transparent);text-align:center}
  .choice-table th:first-child,.choice-table :global(td:first-child){width:26%;text-align:left}.choice-table th:last-child,.choice-table :global(td:last-child){border-right:0}.choice-table th{background:color-mix(in srgb,var(--card-bg) 88%,#000);color:var(--wizard-gold-light);font-size:.7rem;line-height:1.15;text-transform:uppercase;overflow-wrap:anywhere}
  .choice-table :global(tbody tr:nth-child(odd)){background:color-mix(in srgb,var(--card-bg) 34%,transparent)}.choice-table :global(tbody tr:nth-child(even)){background:color-mix(in srgb,var(--card-bg) 14%,transparent)}.choice-table :global(tbody tr:hover){background:color-mix(in srgb,var(--wizard-gold) 13%,var(--card-bg));box-shadow:inset 4px 0 0 var(--wizard-gold)}
  .choice-table :global(.tool-group-row),.choice-table :global(.tool-group-row:hover){background:color-mix(in srgb,var(--wizard-gold) 16%,var(--card-bg));box-shadow:none}.choice-table :global(.tool-group-row td){height:34px;padding:.42rem 1rem;border-right:0;color:var(--wizard-gold-light);font-family:Georgia,serif;font-size:.82rem;font-weight:800;letter-spacing:.055em;text-align:left;text-transform:uppercase}
  .choice-table :global(.choice-name){font-weight:800;padding-left:1rem}.choice-table :global(input){width:1.25rem;height:1.25rem;accent-color:var(--wizard-gold);cursor:pointer}.choice-table :global(input:disabled){cursor:not-allowed;opacity:.34}.choice-table :global(input:checked:disabled:not(.is-selected-elsewhere)){opacity:1}.choice-table :global(.choice-selected-elsewhere){background:color-mix(in srgb,#050914 34%,transparent)}.choice-table :global(input.is-selected-elsewhere){opacity:.24;filter:grayscale(1) brightness(.68)}.choice-table :global(.choice-unavailable){opacity:.35}
  @media(max-width:760px){.choice-inner{min-width:640px}.choice-summary-row{grid-template-columns:34% 66%}.choice-table th:first-child,.choice-table :global(td:first-child){width:34%}}
</style>
