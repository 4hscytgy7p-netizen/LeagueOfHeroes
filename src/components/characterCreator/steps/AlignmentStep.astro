<section class="wizard-step" data-step="alignment">
  <div class="step-heading"><span>Глава четвёртая</span><h2>Выбери мировоззрение</h2><p>Мировоззрение определяет, какие идеалы и варианты предыстории подходят персонажу. Оно не запрещает отдельные решения в игре.</p></div>
  <div class="alignment-grid">
    {[['lawful-good','Законно-добрый','Порядок, долг и помощь другим.'],['neutral-good','Нейтрально-добрый','Добрые поступки важнее законов и традиций.'],['chaotic-good','Хаотично-добрый','Свобода и сострадание важнее установленного порядка.'],['lawful-neutral','Законно-нейтральный','Кодекс, закон или традиция стоят на первом месте.'],['true-neutral','Истинно нейтральный','Равновесие, прагматизм или отсутствие крайностей.'],['chaotic-neutral','Хаотично-нейтральный','Личная свобода и независимость прежде всего.'],['lawful-evil','Законно-злой','Власть и личная выгода через порядок и систему.'],['neutral-evil','Нейтрально-злой','Собственная выгода без привязанности к порядку или хаосу.'],['chaotic-evil','Хаотично-злой','Разрушительная свобода, жестокость и отсутствие ограничений.']].map(([id,name,description]) => (
      <button type="button" class="alignment-card" data-alignment={id}><strong>{name}</strong><small>{description}</small></button>
    ))}
  </div>
</section>
