  .spell-search-field input { width:100%; padding:.82rem .95rem; border:1px solid var(--card-border); border-radius:.62rem; background:var(--background); color:var(--text); font:inherit; outline:none; }
  .spell-search-field input:focus { border-color:var(--wizard-gold); box-shadow:0 0 0 3px color-mix(in srgb,var(--wizard-gold) 16%,transparent); }

  .spell-columns { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .spell-columns.is-single { grid-template-columns:minmax(0,1fr); }
  .spell-section { min-width:0; overflow:hidden; border:1px solid var(--card-border); border-radius:.82rem; background:color-mix(in srgb,var(--card-bg) 91%,var(--background)); }
  .spell-section-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1rem 1rem .85rem; border-bottom:1px solid var(--card-border); background:color-mix(in srgb,var(--wizard-gold) 5%,transparent); }
  .spell-section-heading span { color:var(--wizard-gold); font-size:.66rem; font-weight:900; letter-spacing:.1em; text-transform:uppercase; }
