  .spell-grid { display:grid; gap:.4rem; max-height:480px; overflow-y:auto; padding:.65rem; scrollbar-gutter:stable; }
  .spell-card { display:grid; grid-template-columns:24px minmax(0,1fr) 26px; align-items:center; gap:.55rem; min-height:48px; padding:.55rem .62rem; border:1px solid transparent; border-radius:.58rem; background:var(--background); cursor:pointer; transition:border-color .15s ease,background .15s ease,transform .15s ease; }
