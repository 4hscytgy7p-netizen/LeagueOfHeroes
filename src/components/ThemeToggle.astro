---
import PaletteEditor from './PaletteEditor.astro';
---

<button id="theme-toggle" type="button" aria-label="Включить светлую тему" title="Включить светлую тему" class="theme-toggle">
  <svg class="sun-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <svg class="moon-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<PaletteEditor />

<style>
  .theme-toggle {
    position: fixed;
    z-index: 1101;
    bottom: 1.5rem;
    left: 1rem;
    background: var(--theme-toggle-bg);
    border: 1px solid var(--theme-toggle-border);
    padding: 0.5rem;
    border-radius: 0.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--theme-toggle-color);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .theme-toggle:hover {
    background: var(--theme-toggle-hover-bg);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  :global(.test-account-body) .theme-toggle {
    width: 2.5rem;
    height: 2.5rem;
  }

  .sun-icon {
    display: none;
  }

  .moon-icon {
    display: block;
  }

  :global(.dark) .sun-icon {
    display: block;
  }

  :global(.dark) .moon-icon {
    display: none;
  }

  @media (max-width: 760px) {
    .theme-toggle {
      top: .72rem;
      right: 4.25rem;
      bottom: auto;
      left: auto;
      z-index: 1101;
      width: 2.25rem;
      height: 2.25rem;
      padding: .42rem;
    }

    :global(.test-account-body) .theme-toggle {
      right: 1rem;
    }
  }
</style>

<script is:inline>
  (() => {
    const button = document.getElementById('theme-toggle');
    const root = document.documentElement;
    const updateLabel = () => {
      const label = root.classList.contains('dark')
        ? 'Включить светлую тему'
        : 'Включить тёмную тему';
      button?.setAttribute('aria-label', label);
      button?.setAttribute('title', label);
    };

    updateLabel();
    button?.addEventListener('click', () => {
      const isDark = root.classList.toggle('dark');
      updateLabel();
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch { /* Switching still works when persistence is unavailable. */ }
    });

    window.addEventListener('storage', (event) => {
      if (event.key === 'theme' || event.key === null) {
        root.classList.toggle('dark', event.newValue !== 'light');
        updateLabel();
      }
    });
    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      try {
        root.classList.toggle('dark', localStorage.getItem('theme') !== 'light');
      } catch { /* Keep the current theme when storage is unavailable. */ }
      updateLabel();
    });
  })();
</script>
