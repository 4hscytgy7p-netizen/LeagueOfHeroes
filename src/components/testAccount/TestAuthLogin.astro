<section class="auth-shell" aria-labelledby="test-auth-title">
  <div class="auth-copy">
    <span class="eyebrow">Закрытое тестирование</span>
    <h1 id="test-auth-title">Вход в инструменты Лиги героев</h1>
    <p>Войдите через Discord, чтобы пользоваться закрытыми инструментами сайта.</p>
    <ul>
      <li>Создайте персонажа по шагам.</li>
      <li>Экспортируйте готовый файл для Roll20.</li>
      <li>Личный кабинет пока остаётся в разработке.</li>
    </ul>
  </div>

  <div class="auth-card">
    <div class="discord-mark" aria-hidden="true">Discord</div>
    <h2>Вход и регистрация</h2>
    <p>Новый профиль будет создан автоматически после первого входа.</p>
    <button id="discord-sign-in" class="discord-button" type="button">
      Продолжить через Discord
    </button>
    <p class="privacy-note">Запрашивается только базовый профиль Discord. Доступ к сообщениям и серверам не требуется.</p>
    <div id="auth-status" class="account-notice" hidden></div>
  </div>
</section>

<script>
  import { isTestAccountConfigured, testAccountSupabase } from '../../utils/testAccount';

  const button = document.querySelector<HTMLButtonElement>('#discord-sign-in');
  const status = document.querySelector<HTMLElement>('#auth-status');

  function showStatus(message: string, kind: 'info' | 'error' = 'info') {
    if (!status) return;
    status.textContent = message;
    status.dataset.kind = kind;
    status.hidden = false;
  }

  function requestedPage() {
    const next = new URLSearchParams(window.location.search).get('next') || '/tools/character-creator/';
    return next.startsWith('/') && !next.startsWith('//') ? next : '/tools/character-creator/';
  }

  async function initializeLogin() {
    if (!isTestAccountConfigured || !testAccountSupabase) {
      if (button) button.disabled = true;
      showStatus('Авторизация ещё не подключена: добавьте PUBLIC_SUPABASE_URL и PUBLIC_SUPABASE_ANON_KEY.', 'error');
      return;
    }

    const { data } = await testAccountSupabase.auth.getSession();
    if (data.session) {
      window.location.replace(requestedPage());
    }
  }

  button?.addEventListener('click', async () => {
    if (!testAccountSupabase) return;
    button.disabled = true;
    showStatus('Открываем безопасную страницу Discord…');

    const isEmbeddedPreview = window.self !== window.top;
    const authWindow = isEmbeddedPreview
      ? window.open('about:blank', 'loh-discord-auth')
      : null;

    const callbackUrl = new URL('/test/auth/callback/', window.location.origin);
    callbackUrl.searchParams.set('next', requestedPage());
    const redirectTo = callbackUrl.toString();
    const { data, error } = await testAccountSupabase.auth.signInWithOAuth({
      provider: 'discord',
      options: {
        redirectTo,
        scopes: 'identify',
        skipBrowserRedirect: true
      }
    });

    if (error) {
      authWindow?.close();
      button.disabled = false;
      showStatus(`Не удалось начать вход: ${error.message}`, 'error');
      return;
    }

    if (!data.url) {
      authWindow?.close();
      button.disabled = false;
      showStatus('Supabase не вернул адрес страницы входа.', 'error');
      return;
    }

    if (authWindow && !authWindow.closed) {
      authWindow.opener = null;
      authWindow.location.replace(data.url);
      showStatus('Вход через Discord открыт в новой вкладке.');
      return;
    }

    window.location.assign(data.url);
  });

  initializeLogin();
</script>

<style>
  .auth-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, .8fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: center;
    min-height: calc(100vh - 180px);
  }
  .eyebrow { color: #e2b448; font-size: .75rem; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  h1 { max-width: 760px; margin: .8rem 0 1rem; color: #b69aff; font: 800 clamp(2.6rem, 7vw, 5.4rem)/.96 Georgia, serif; }
  .auth-copy > p { max-width: 720px; color: #b9c3d4; font-size: clamp(1rem, 2vw, 1.2rem); line-height: 1.7; }
  ul { display: grid; gap: .7rem; margin: 1.6rem 0 0; padding: 0; list-style: none; }
  li { color: #dbe2ee; }
  li::before { content: "✦"; margin-right: .65rem; color: #e2b448; }
  .auth-card {
    padding: clamp(1.4rem, 4vw, 2.2rem);
    border: 1px solid rgba(163, 177, 204, .24);
    border-radius: 24px;
    background: linear-gradient(145deg, rgba(26, 40, 66, .96), rgba(11, 23, 43, .96));
    box-shadow: 0 28px 80px rgba(0, 0, 0, .3);
  }
  .discord-mark { display: inline-flex; padding: .42rem .7rem; border-radius: 8px; color: white; background: #5865f2; font-weight: 900; }
  h2 { margin: 1.1rem 0 .5rem; font: 800 1.65rem Georgia, serif; }
  .auth-card > p { color: #aeb9cb; line-height: 1.55; }
  .discord-button {
    width: 100%;
    margin: 1.4rem 0 .9rem;
    padding: .95rem 1.1rem;
    border: 0;
    border-radius: 12px;
    color: white;
    background: #5865f2;
    box-shadow: 0 10px 26px rgba(88, 101, 242, .28);
    cursor: pointer;
    font-weight: 900;
  }
  .discord-button:hover { background: #6875f5; }
  .discord-button:disabled { cursor: not-allowed; opacity: .55; }
  .privacy-note { font-size: .78rem; }
  .account-notice { margin-top: 1rem; padding: .8rem; border: 1px solid rgba(226, 180, 72, .35); border-radius: 10px; color: #f2d98f; background: rgba(226, 180, 72, .08); font-size: .85rem; }
  .account-notice[data-kind="error"] { border-color: rgba(242, 105, 119, .4); color: #ffb5bd; background: rgba(242, 105, 119, .08); }
  @media (max-width: 820px) {
    .auth-shell { grid-template-columns: 1fr; min-height: 0; }
  }
</style>
