---
import MasterWorkspace from './MasterWorkspace.astro';
import TeamWorkspace from './TeamWorkspace.astro';
import type { AccountMode } from '../../utils/testAccount';

interface Props {
  requestedMode?: 'auto' | AccountMode;
}

const { requestedMode = 'auto' } = Astro.props;
---

<section id="test-cabinet" class="cabinet-shell" data-requested-mode={requestedMode}>
  <div id="cabinet-loading" class="cabinet-loading">
    <div class="loader" aria-hidden="true"></div>
    <p>Загружаем личный кабинет…</p>
  </div>

  <div id="cabinet-error" class="cabinet-error" hidden>
    <h1>Кабинет пока недоступен</h1>
    <p id="cabinet-error-message"></p>
    <a href="/test/auth/">Перейти ко входу</a>
  </div>

  <div id="cabinet-content" hidden>
    <p id="local-account-preview-notice" class="local-preview-notice" role="status" hidden>
      Локальная разработка: профиль администратора без входа через Discord. Доступны режимы игрока, тестового мастера, мастера и администратора. Правки правил сохраняются в этом браузере; облачные данные и управление настоящими пользователями доступны после авторизации на сайте.
    </p>
    <header class="profile-header">
      <div class="profile-person">
        <img id="profile-avatar" alt="" hidden />
        <div>
          <span id="profile-role" class="role-badge"></span>
          <h1 id="profile-name">Герой</h1>
          <p id="profile-email"></p>
        </div>
      </div>
      <div class="profile-actions">
        <nav id="mode-switcher" class="mode-switcher" aria-label="Режим личного кабинета"></nav>
        <button id="account-sign-out" class="ghost-button" type="button">Выйти</button>
      </div>
    </header>

    <div id="mode-description" class="mode-description"></div>

    <TeamWorkspace />

    <section id="player-dashboard" class="dashboard-grid" hidden>
      <article class="dashboard-card dashboard-card-featured">
        <span>Персонажи</span>
        <h2>Мои герои</h2>
        <p>Продолжите сохранённого персонажа или создайте нового героя в конструкторе.</p>
        <strong id="character-slot-summary" class="slot-summary">Слоты персонажей: —</strong>
        <div class="featured-actions">
          <button id="create-character" class="primary-button" type="button">Создать персонажа</button>
              <button id="open-extension-settings" class="ghost-button" type="button">Подключить расширение Roll20</button>
        </div>
      </article>
      <article class="dashboard-card">
        <span>Игры</span>
        <h2>Мои кампании</h2>
        <p>Здесь появятся приглашения от мастеров и расписание ближайших игр.</p>
        <strong class="empty-value">Пока нет кампаний</strong>
      </article>
      <article class="dashboard-card">
        <span>Профиль</span>
        <h2 id="player-profile-title">Discord подключён</h2>
        <p id="player-profile-description">Имя и аватар синхронизируются при следующем входе через Discord.</p>
        <strong id="player-profile-status" class="success-value">Активен</strong>
      </article>
      <article class="dashboard-card character-library-card">
        <div class="admin-heading">
          <div>
            <span>Облачное хранилище</span>
            <h2>Персонажи Лиги</h2>
          </div>
          <button id="refresh-characters" class="ghost-button" type="button">Обновить</button>
        </div>
        <p>JSON конструктора и готовый экспорт Roll20 сохраняются в Supabase.</p>
        <div id="character-list" class="character-list">
          <div class="empty-value">Загрузка персонажей…</div>
        </div>
        <div id="character-status" class="inline-status" hidden></div>
      </article>
      <article id="roll20-extension-card" class="dashboard-card extension-card" tabindex="-1">
        <span>Roll20</span>
        <h2>Расширение Лиги и ключ доступа</h2>
        <p>Установите расширение, затем подключите его одной кнопкой. Адрес Supabase, публичный ключ и личный ключ синхронизации будут переданы автоматически.</p>
        <div class="extension-actions">
          <button id="connect-extension" class="primary-button" type="button">Подключить расширение</button>
        </div>
        <a class="extension-download" href="/downloads/league-roll20-sync.zip" download>Скачать расширение для Chrome / Яндекс Браузера</a>
        <div id="sync-token-list" class="sync-token-list"></div>
        <div id="extension-status" class="inline-status" hidden></div>
      </article>
    </section>

    <section id="master-dashboard" hidden>
      {requestedMode === 'master' && <MasterWorkspace />}
    </section>

    <section id="test_master-dashboard" hidden>
      {requestedMode === 'test_master' && <MasterWorkspace />}
    </section>

    <section id="admin-dashboard" class="admin-dashboard" hidden>
      <div id="admin-stats" class="admin-stats"></div>
      <article class="dashboard-card admin-users-card">
        <div class="admin-heading">
          <div>
            <span>Администрирование</span>
            <h2>Пользователи и роли</h2>
          </div>
          <button id="refresh-users" class="ghost-button" type="button">Обновить</button>
        </div>
        <p class="admin-help">Тестовый мастер сохраняет кабинет игрока и читает доступные ему мастерские правила. Мастер получает полный мастерский режим, администратор — все четыре режима. Роль тестового мастера назначается по запросу в Discord; роль мастера — после тестовой игры.</p>
        <div class="admin-table-wrap">
          <table>
            <thead><tr><th>Пользователь</th><th>Discord ID</th><th>Роль</th><th>Слоты героев</th><th>Создан</th></tr></thead>
            <tbody id="admin-users-body"></tbody>
          </table>
        </div>
        <div id="admin-status" class="inline-status" hidden></div>
      </article>
    </section>
  </div>
</section>

<script>
  import {
    accountModePath,
    accountRoles,
    accountRoleLabels,
    accountModeStorageKey,
    availableAccountModes,
    defaultAccountMode,
    isLocalAuthBypassEnabled,
    isTestAccountConfigured,
    localAccountPreviewProfile,
    normalizeAccountRole,
    testAccountSupabase,
    type AccountMode,
    type AccountRole
  } from '../../utils/testAccount';
  import { initializeMasterWorkspace } from './masterWorkspace';
  import { initializeTeamWorkspace } from './teamWorkspace';

  const root = document.querySelector<HTMLElement>('#test-cabinet');
  const loading = document.querySelector<HTMLElement>('#cabinet-loading');
  const content = document.querySelector<HTMLElement>('#cabinet-content');
  const errorPanel = document.querySelector<HTMLElement>('#cabinet-error');
  const errorMessage = document.querySelector<HTMLElement>('#cabinet-error-message');
  const requestedMode = (root?.dataset.requestedMode || 'auto') as AccountMode | 'auto';
  let currentRole: AccountRole = 'player';
  let currentUserId = '';
  let currentCharacterSlots = 1;

  function showError(message: string) {
    if (loading) loading.hidden = true;
    if (content) content.hidden = true;
    if (errorMessage) errorMessage.textContent = message;
    if (errorPanel) errorPanel.hidden = false;
  }

  function roleLabel(role: AccountRole) {
    return accountRoleLabels[role];
  }

  function modeDescription(mode: AccountMode) {
    return ({
      player: 'Личный режим игрока: персонажи, приглашения и участие в кампаниях.',
      test_master: 'Режим тестового мастера: руководство по тестовой игре и доступные вашей роли правила открытого стола.',
      master: 'Режим мастера: правила открытого стола, подготовка игр и мастерские инструменты.',
      admin: 'Режим администратора: пользователи, роли и контроль тестового контура.'
    })[mode];
  }

  function renderModeSwitcher(role: AccountRole, activeMode: AccountMode) {
    const switcher = document.querySelector<HTMLElement>('#mode-switcher');
    if (!switcher) return;
    switcher.innerHTML = availableAccountModes(role).map((mode) => `
      <a href="${accountModePath(mode)}" class="${mode === activeMode ? 'is-active' : ''}" data-account-mode="${mode}" ${mode === activeMode ? 'aria-current="page"' : ''}>
        ${roleLabel(mode)}
      </a>
    `).join('');
  }

  function showMode(mode: AccountMode) {
    for (const candidate of accountRoles) {
      const panel = document.querySelector<HTMLElement>(`#${candidate}-dashboard`);
      if (panel) panel.hidden = candidate !== mode;
    }
    const description = document.querySelector<HTMLElement>('#mode-description');
    if (description) description.textContent = modeDescription(mode);
    window.localStorage.setItem(accountModeStorageKey, mode);
  }

  function formatDate(value: string | null) {
    if (!value) return '—';
    return new Intl.DateTimeFormat('ru-RU', { dateStyle: 'medium' }).format(new Date(value));
  }

  function escapeText(value: unknown) {
    return String(value ?? '').replace(/[&<>"']/g, (character) => {
      if (character === '&') return '&amp;';
      if (character === '<') return '&lt;';
      if (character === '>') return '&gt;';
      if (character === '"') return '&quot;';
      return '&#39;';
    });
  }

  const creatorPath = '/internal/129321041204158/character-creator/';

  function showInlineStatus(selector: string, message: string, kind: 'success' | 'error' = 'success') {
    const element = document.querySelector<HTMLElement>(selector);
    if (!element) return;
    element.textContent = message;
    element.dataset.kind = kind;
    element.hidden = false;
  }

  async function createCharacter() {
    if (isLocalAuthBypassEnabled) {
      window.location.assign(creatorPath);
      return;
    }
    if (!testAccountSupabase || !currentUserId) return;
    const button = document.querySelector<HTMLButtonElement>('#create-character');
    if (button) button.disabled = true;
    const { data, error } = await testAccountSupabase
      .rpc('create_character', { character_name: 'Безымянный герой' });
    if (button) button.disabled = false;
    if (error || !data) {
      const message = error?.message?.includes('Character slot limit reached')
        ? 'Свободных слотов нет. Администратор может увеличить лимит в своём кабинете.'
        : error?.message || 'Не удалось создать персонажа.';
      showInlineStatus('#character-status', message, 'error');
      return;
    }
    window.location.assign(`${creatorPath}?character=${encodeURIComponent(String(data))}`);
  }

  async function deleteCharacter(characterId: string, characterName: string) {
    if (!testAccountSupabase) return;
    if (!window.confirm(`Удалить персонажа «${characterName}»? Это действие нельзя отменить.`)) return;
    const { error } = await testAccountSupabase.from('characters').delete().eq('id', characterId);
    if (error) {
      showInlineStatus('#character-status', error.message, 'error');
      return;
    }
    await loadCharacters();
  }

  async function loadCharacters() {
    if (!testAccountSupabase || !currentUserId) return;
    const list = document.querySelector<HTMLElement>('#character-list');
    if (list) list.innerHTML = '<div class="empty-value">Загрузка персонажей…</div>';
    const { data, error } = await testAccountSupabase
      .from('characters')
      .select('id,name,summary,revision,created_at,updated_at')
      .order('updated_at', { ascending: false });
    if (error) {
      if (list) list.innerHTML = '<div class="empty-value">Не удалось загрузить персонажей.</div>';
      showInlineStatus('#character-status', error.message, 'error');
      return;
    }
    const characters = data || [];
    const slotSummary = document.querySelector<HTMLElement>('#character-slot-summary');
    const createButton = document.querySelector<HTMLButtonElement>('#create-character');
    const hasFreeSlot = characters.length < currentCharacterSlots;
    if (slotSummary) slotSummary.textContent = `Слоты персонажей: ${characters.length}/${currentCharacterSlots}`;
    if (createButton) {
      createButton.disabled = !hasFreeSlot;
      createButton.textContent = hasFreeSlot ? 'Создать персонажа' : 'Все слоты заняты';
      createButton.title = hasFreeSlot ? '' : 'Администратор может увеличить количество слотов.';
    }
    if (list) {
      list.innerHTML = characters.length ? characters.map((character) => {
        const summary = character.summary && typeof character.summary === 'object' ? character.summary : {};
        const details = [summary.species, summary.class, summary.background].filter(Boolean).join(' · ') || 'Черновик персонажа';
        return `<article class="character-row">
          <div><strong>${escapeText(character.name || 'Безымянный герой')}</strong><small>${escapeText(details)} · версия ${escapeText(character.revision || 1)} · ${escapeText(formatDate(character.updated_at))}</small></div>
          <div class="character-row-actions">
            <a href="${creatorPath}?character=${encodeURIComponent(character.id)}">Открыть</a>
            <button type="button" data-delete-character="${escapeText(character.id)}" data-character-name="${escapeText(character.name || 'Безымянный герой')}">Удалить</button>
          </div>
        </article>`;
      }).join('') : '<div class="empty-value">Героев пока нет. Создайте первого персонажа.</div>';
    }
    document.querySelectorAll<HTMLButtonElement>('[data-delete-character]').forEach((button) => {
      button.addEventListener('click', () => deleteCharacter(button.dataset.deleteCharacter || '', button.dataset.characterName || 'Безымянный герой'));
    });
  }

  async function loadSyncTokens() {
    if (!testAccountSupabase || !currentUserId) return;
    const list = document.querySelector<HTMLElement>('#sync-token-list');
    const { data, error } = await testAccountSupabase
      .from('character_sync_tokens')
      .select('id,label,created_at,last_used_at,revoked_at')
      .order('created_at', { ascending: false });
    if (!list) return;
    if (error) {
      list.innerHTML = `<div class="empty-value">${escapeText(error.message)}</div>`;
      return;
    }
    const tokens = data || [];
    list.innerHTML = tokens.length ? tokens.map((token) => `<div class="sync-token-row ${token.revoked_at ? 'is-revoked' : ''}">
      <div><strong>${escapeText(token.label)}</strong><small>${token.revoked_at ? 'Отозван' : token.last_used_at ? `Использован ${formatDate(token.last_used_at)}` : `Создан ${formatDate(token.created_at)}`}</small></div>
      ${token.revoked_at ? '' : `<button type="button" data-revoke-token="${escapeText(token.id)}">Отозвать</button>`}
    </div>`).join('') : '<div class="empty-value">Активных ключей пока нет.</div>';
    document.querySelectorAll<HTMLButtonElement>('[data-revoke-token]').forEach((button) => {
      button.addEventListener('click', async () => {
        if (!testAccountSupabase || !button.dataset.revokeToken) return;
        await testAccountSupabase.rpc('revoke_character_sync_token', { sync_token_id: button.dataset.revokeToken });
        await loadSyncTokens();
      });
    });
  }

  async function connectExtension() {
    if (!testAccountSupabase) return;
    const button = document.querySelector<HTMLButtonElement>('#connect-extension');
    const config = window.__LOH_TEST_ACCOUNT_CONFIG__;
    if (!config?.supabaseUrl || !config.supabaseAnonKey) {
      showInlineStatus('#extension-status', 'На сайте не настроены публичные параметры Supabase.', 'error');
      return;
    }
    if (button) button.disabled = true;
    showInlineStatus('#extension-status', 'Создаём защищённое подключение…');
    const { data, error } = await testAccountSupabase.rpc('create_character_sync_token', { token_label: 'Браузерное расширение' });
    const record = Array.isArray(data) ? data[0] : data;
    if (error || !record?.token) {
      if (button) button.disabled = false;
      showInlineStatus('#extension-status', error?.message || 'Не удалось создать ключ.', 'error');
      return;
    }

    const requestId = `loh-connect-${Date.now()}-${Math.random().toString(36).slice(2)}`;
    try {
      await new Promise<void>((resolve, reject) => {
        const timer = window.setTimeout(() => {
          window.removeEventListener('message', listener);
          reject(new Error('Расширение не найдено. Установите или перезагрузите его и нажмите кнопку ещё раз.'));
        }, 4000);
        function listener(event: MessageEvent) {
          if (event.source !== window || event.data?.source !== 'LOH_BROWSER_EXTENSION' || event.data?.requestId !== requestId) return;
          window.clearTimeout(timer);
          window.removeEventListener('message', listener);
          event.data.ok ? resolve() : reject(new Error(event.data.error || 'Расширение не приняло подключение.'));
        }
        window.addEventListener('message', listener);
        window.postMessage({
          source: 'LOH_LEAGUE_SITE',
          type: 'CONNECT_EXTENSION',
          requestId,
          config: {
            supabaseUrl: config.supabaseUrl,
            supabaseAnonKey: config.supabaseAnonKey,
            syncToken: record.token
          }
        }, window.location.origin);
      });
      showInlineStatus('#extension-status', 'Расширение подключено. Обновите открытую страницу Roll20.', 'success');
    } catch (connectionError) {
      await testAccountSupabase.rpc('revoke_character_sync_token', { sync_token_id: record.id });
      showInlineStatus('#extension-status', connectionError instanceof Error ? connectionError.message : String(connectionError), 'error');
    } finally {
      if (button) button.disabled = false;
      await loadSyncTokens();
    }
  }

  async function loadAdminUsers() {
    if (currentRole !== 'admin') return;
    const body = document.querySelector<HTMLElement>('#admin-users-body');
    const status = document.querySelector<HTMLElement>('#admin-status');
    if (status) status.hidden = true;
    if (body) body.innerHTML = '<tr><td colspan="5">Загрузка пользователей…</td></tr>';

    const result = isLocalAuthBypassEnabled
      ? { data: [localAccountPreviewProfile], error: null }
      : await testAccountSupabase?.from('user_profiles')
        .select('id,email,discord_id,display_name,avatar_url,role,character_slots,created_at')
        .order('created_at', { ascending: false });
    if (!result) return;
    const { data, error } = result;

    if (error) {
      if (body) body.innerHTML = '<tr><td colspan="5">Не удалось загрузить пользователей.</td></tr>';
      if (status) {
        status.textContent = error.message;
        status.hidden = false;
      }
      return;
    }

    const users = data || [];
    if (body) {
      body.innerHTML = users.map((profile) => `
        <tr>
          <td>
            <span class="admin-user">
              ${profile.avatar_url ? `<img src="${escapeText(profile.avatar_url)}" alt="">` : ''}
              <span><strong>${escapeText(profile.display_name || profile.email || 'Без имени')}</strong><small>${escapeText(profile.email || (isLocalAuthBypassEnabled ? 'Локальный профиль' : 'Discord OAuth'))}</small></span>
            </span>
          </td>
          <td><code>${escapeText(profile.discord_id || '—')}</code></td>
          <td>
            <select data-admin-role="${escapeText(profile.id)}" ${profile.id === currentUserId ? 'disabled title="Собственную роль изменяет другой администратор"' : ''}>
              ${accountRoles.map((role) => `<option value="${role}" ${normalizeAccountRole(profile.role) === role ? 'selected' : ''}>${roleLabel(role)}</option>`).join('')}
            </select>
          </td>
          <td><input class="slot-input" type="number" min="1" max="100" value="${escapeText(profile.character_slots || 1)}" data-character-slots="${escapeText(profile.id)}" aria-label="Количество слотов персонажей" ${isLocalAuthBypassEnabled ? 'disabled title="В локальном просмотре облачные слоты не изменяются"' : ''}></td>
          <td>${formatDate(profile.created_at)}</td>
        </tr>
      `).join('');
    }

    const counts = users.reduce((result, profile) => {
      result[normalizeAccountRole(profile.role)] += 1;
      return result;
    }, { player: 0, test_master: 0, master: 0, admin: 0 } as Record<AccountRole, number>);
    const stats = document.querySelector<HTMLElement>('#admin-stats');
    if (stats) {
      stats.innerHTML = `
        <div><span>Всего</span><strong>${users.length}</strong></div>
        <div><span>Игроки</span><strong>${counts.player}</strong></div>
        <div><span>Тестовые мастера</span><strong>${counts.test_master}</strong></div>
        <div><span>Мастера</span><strong>${counts.master}</strong></div>
        <div><span>Администраторы</span><strong>${counts.admin}</strong></div>
      `;
    }

    document.querySelectorAll<HTMLSelectElement>('[data-admin-role]').forEach((select) => {
      select.addEventListener('change', async () => {
        const profileId = select.dataset.adminRole;
        if (!profileId || !testAccountSupabase) return;
        select.disabled = true;
        const { error: updateError } = await testAccountSupabase
          .from('user_profiles')
          .update({ role: select.value })
          .eq('id', profileId);
        select.disabled = false;
        if (status) {
          status.textContent = updateError ? updateError.message : 'Роль обновлена.';
          status.dataset.kind = updateError ? 'error' : 'success';
          status.hidden = false;
        }
        if (!updateError) await loadAdminUsers();
      });
    });

    document.querySelectorAll<HTMLInputElement>('[data-character-slots]').forEach((input) => {
      input.addEventListener('change', async () => {
        const profileId = input.dataset.characterSlots;
        if (!profileId || !testAccountSupabase) return;
        const slots = Math.max(1, Math.min(100, Number.parseInt(input.value, 10) || 1));
        input.value = String(slots);
        input.disabled = true;
        const { error: updateError } = await testAccountSupabase
          .from('user_profiles')
          .update({ character_slots: slots })
          .eq('id', profileId);
        input.disabled = false;
        if (status) {
          status.textContent = updateError ? updateError.message : `Лимит изменён: ${slots}.`;
          status.dataset.kind = updateError ? 'error' : 'success';
          status.hidden = false;
        }
        if (!updateError && profileId === currentUserId) currentCharacterSlots = slots;
      });
    });
  }

  function initializeLocalPlayer() {
    const slotSummary = document.querySelector<HTMLElement>('#character-slot-summary');
    const characterList = document.querySelector<HTMLElement>('#character-list');
    const tokenList = document.querySelector<HTMLElement>('#sync-token-list');
    const profileHeading = document.querySelector<HTMLElement>('#player-profile-title');
    const profileDescription = document.querySelector<HTMLElement>('#player-profile-description');
    const profileStatus = document.querySelector<HTMLElement>('#player-profile-status');
    if (slotSummary) slotSummary.textContent = 'Локальный конструктор без облачного сохранения';
    if (characterList) characterList.innerHTML = '<div class="empty-value">Облачные персонажи доступны после входа через Discord на сайте. Конструктор и экспорт можно проверить локально.</div>';
    if (tokenList) tokenList.innerHTML = '<div class="empty-value">Ключи синхронизации доступны после авторизации на сайте.</div>';
    if (profileHeading) profileHeading.textContent = 'Локальный профиль';
    if (profileDescription) profileDescription.textContent = 'Для локальной разработки используется профиль администратора.';
    if (profileStatus) profileStatus.textContent = 'Обход авторизации';
    for (const id of ['refresh-characters', 'connect-extension']) {
      const button = document.querySelector<HTMLButtonElement>(`#${id}`);
      if (button) {
        button.disabled = true;
        button.title = 'Доступно с авторизованным аккаунтом на сайте';
      }
    }
  }

  async function initializeCabinet() {
    if (isLocalAuthBypassEnabled) {
      currentUserId = localAccountPreviewProfile.id;
      currentRole = localAccountPreviewProfile.role;
      currentCharacterSlots = localAccountPreviewProfile.character_slots;
      const mode = requestedMode === 'auto' ? defaultAccountMode(currentRole) : requestedMode;
      if (requestedMode === 'auto') {
        window.location.replace(accountModePath(mode) + window.location.search + window.location.hash);
        return;
      }
      document.documentElement.dataset.authMode = 'local-test-bypass';
      const name = document.querySelector<HTMLElement>('#profile-name');
      const role = document.querySelector<HTMLElement>('#profile-role');
      const email = document.querySelector<HTMLElement>('#profile-email');
      const signOut = document.querySelector<HTMLElement>('#account-sign-out');
      const notice = document.querySelector<HTMLElement>('#local-account-preview-notice');
      if (name) name.textContent = localAccountPreviewProfile.display_name;
      if (role) role.textContent = `Роль: ${roleLabel(currentRole)}`;
      if (email) email.textContent = 'Локальная разработка без подключения аккаунта';
      if (signOut) signOut.hidden = true;
      if (notice) notice.hidden = false;
      renderModeSwitcher(currentRole, mode);
      showMode(mode);
      if (loading) loading.hidden = true;
      if (content) content.hidden = false;
      await initializeTeamWorkspace(currentUserId, currentRole);
      if (mode === 'admin') await loadAdminUsers();
      if (mode === 'player') initializeLocalPlayer();
      if (mode === 'master' || mode === 'test_master') await initializeMasterWorkspace(currentUserId, mode === 'test_master' ? 'test_master' : currentRole);
      return;
    }
    if (!isTestAccountConfigured || !testAccountSupabase) {
      showError('Supabase не настроен. Добавьте переменные PUBLIC_SUPABASE_URL и PUBLIC_SUPABASE_ANON_KEY.');
      return;
    }

    const { data: sessionData } = await testAccountSupabase.auth.getSession();
    if (!sessionData.session) {
      const next = encodeURIComponent(window.location.pathname);
      window.location.replace(`/test/auth/?next=${next}`);
      return;
    }

    const user = sessionData.session.user;
    currentUserId = user.id;
    const { data: profile, error } = await testAccountSupabase
      .from('user_profiles')
      .select('id,email,discord_id,display_name,avatar_url,role,character_slots,created_at')
      .eq('id', user.id)
      .single();

    if (error || !profile) {
      showError('Профиль не найден. Примените обновлённый файл supabase/schema.sql и войдите через Discord ещё раз.');
      return;
    }

    currentRole = normalizeAccountRole(profile.role);
    currentCharacterSlots = Math.max(1, Number(profile.character_slots) || 1);
    const allowedModes = availableAccountModes(currentRole);
    const mode = requestedMode === 'auto' ? defaultAccountMode(currentRole) : requestedMode;
    if (!allowedModes.includes(mode)) {
      window.location.replace(accountModePath(defaultAccountMode(currentRole)) + window.location.search + window.location.hash);
      return;
    }
    if ((mode === 'master' || mode === 'test_master') && !user.identities?.some(identity => identity.provider === 'discord')
      && user.app_metadata?.provider !== 'discord' && !user.app_metadata?.providers?.includes('discord')) {
      showError('Для кабинета мастера нужен вход через Discord.');
      return;
    }
    if (requestedMode === 'auto') {
      window.location.replace(accountModePath(mode) + window.location.search + window.location.hash);
      return;
    }

    const name = profile.display_name
      || user.user_metadata?.full_name
      || user.user_metadata?.name
      || user.user_metadata?.user_name
      || 'Герой';
    const avatar = profile.avatar_url || user.user_metadata?.avatar_url || '';
    const nameElement = document.querySelector<HTMLElement>('#profile-name');
    const roleElement = document.querySelector<HTMLElement>('#profile-role');
    const emailElement = document.querySelector<HTMLElement>('#profile-email');
    const avatarElement = document.querySelector<HTMLImageElement>('#profile-avatar');
    if (nameElement) nameElement.textContent = name;
    if (roleElement) roleElement.textContent = `Роль: ${roleLabel(currentRole)}`;
    if (emailElement) emailElement.textContent = profile.email || `Discord ID: ${profile.discord_id || 'не определён'}`;
    if (avatarElement && avatar) {
      avatarElement.src = avatar;
      avatarElement.alt = `Аватар ${name}`;
      avatarElement.hidden = false;
    }

    renderModeSwitcher(currentRole, mode);
    showMode(mode);
    if (loading) loading.hidden = true;
    if (content) content.hidden = false;
    await initializeTeamWorkspace(user.id, currentRole);
    if (mode === 'player') {
      await Promise.all([loadCharacters(), loadSyncTokens()]);
    }
    if (mode === 'admin') await loadAdminUsers();
    if (mode === 'master' || mode === 'test_master') await initializeMasterWorkspace(user.id, mode === 'test_master' ? 'test_master' : currentRole);
  }

  root?.addEventListener('master-access-denied', () => {
    showError('Для справочника нужен вход через Discord и роль «Тестовый мастер», «Мастер» или «Администратор».');
  });

  document.querySelector('#account-sign-out')?.addEventListener('click', async () => {
    if (!testAccountSupabase) return;
    await testAccountSupabase.auth.signOut();
    window.localStorage.removeItem(accountModeStorageKey);
    window.location.replace('/test/auth/');
  });

  document.querySelector('#refresh-users')?.addEventListener('click', loadAdminUsers);
  document.querySelector('#create-character')?.addEventListener('click', createCharacter);
  document.querySelector('#refresh-characters')?.addEventListener('click', loadCharacters);
  document.querySelector('#connect-extension')?.addEventListener('click', connectExtension);
  document.querySelector('#open-extension-settings')?.addEventListener('click', () => {
    const card = document.querySelector<HTMLElement>('#roll20-extension-card');
    card?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    window.setTimeout(() => document.querySelector<HTMLButtonElement>('#connect-extension')?.focus(), 450);
  });
  initializeCabinet().catch(() => showError('Не удалось загрузить кабинет. Проверьте соединение и попробуйте снова.'));
</script>

