  .dashboard-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .dashboard-card { min-width: 0; padding: 1.25rem; border: 1px solid var(--account-border); border-radius: 18px; background: var(--account-panel); }
