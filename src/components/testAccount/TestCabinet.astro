  .dashboard-card > span, .admin-heading span { color: var(--account-gold); font-size: .68rem; font-weight: 900; letter-spacing: .15em; text-transform: uppercase; }
  .dashboard-card h2 { margin: .55rem 0 .65rem; color: var(--account-gold); font: 800 1.4rem Georgia, serif; }
  .dashboard-card p { color: var(--account-muted); line-height: 1.55; }
  .dashboard-card a { display: inline-block; margin-top: 1rem; color: var(--primary); font-weight: 900; text-decoration: none; }
  .primary-button { margin-top: 1rem; padding: .75rem 1rem; border: 0; border-radius: 10px; color: #11192a; background: var(--account-gold-bg); cursor: pointer; font-weight: 900; }
  .primary-button:disabled { opacity: .55; cursor: wait; }
  .slot-summary { display: block; margin-top: .8rem; color: var(--account-gold); }
  .featured-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; margin-top: 1rem; }
