<section class="callback-card" aria-live="polite">
  <div class="callback-spinner" aria-hidden="true"></div>
  <span class="eyebrow">Discord OAuth</span>
  <h1>Завершаем вход</h1>
  <p id="callback-status">Проверяем профиль и открываем выбранный инструмент…</p>
  <a id="callback-retry" href="/test/auth/" hidden>Вернуться ко входу</a>
</section>

<script>
  import { isTestAccountConfigured, testAccountSupabase } from '../../utils/testAccount';

  const status = document.querySelector<HTMLElement>('#callback-status');
  const retry = document.querySelector<HTMLAnchorElement>('#callback-retry');

  function fail(message: string) {
    if (status) status.textContent = message;
    if (retry) retry.hidden = false;
  }

  function requestedPage() {
    const next = new URLSearchParams(window.location.search).get('next') || '/tools/character-creator/';
    return next.startsWith('/') && !next.startsWith('//') ? next : '/tools/character-creator/';
  }

  async function finishDiscordLogin() {
    if (!isTestAccountConfigured || !testAccountSupabase) {
      fail('Supabase не настроен. Проверьте переменные окружения тестового сайта.');
      return;
    }

    const current = await testAccountSupabase.auth.getSession();
    if (!current.data.session) {
      const code = new URLSearchParams(window.location.search).get('code');
      if (code) {
        const { error } = await testAccountSupabase.auth.exchangeCodeForSession(code);
        if (error) {
          fail(`Discord вернул ошибку авторизации: ${error.message}`);
          return;
        }
      }
    }

    const { data, error } = await testAccountSupabase.auth.getUser();
    if (error || !data.user) {
      fail('Сессия не создана. Повторите вход через Discord.');
      return;
    }

    window.location.replace(requestedPage());
  }

  finishDiscordLogin();
</script>

<style>
  .callback-card { display: grid; justify-items: center; gap: .8rem; max-width: 620px; margin: 12vh auto 0; padding: 3rem 2rem; border: 1px solid rgba(163,177,204,.24); border-radius: 24px; text-align: center; background: rgba(14,28,51,.9); }
  .callback-spinner { width: 54px; height: 54px; border: 4px solid rgba(182,154,255,.2); border-top-color: #b69aff; border-radius: 50%; animation: spin .8s linear infinite; }
  .eyebrow { color: #e2b448; font-size: .72rem; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  h1 { margin: .25rem 0 0; color: #b69aff; font: 800 clamp(2rem, 6vw, 3.4rem) Georgia, serif; }
  p { color: #b9c3d4; line-height: 1.6; }
  a { color: #f1cf76; font-weight: 800; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
