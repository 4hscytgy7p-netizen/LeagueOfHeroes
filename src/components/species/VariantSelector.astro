---
import type { SpeciesPageVariant } from '../../utils/speciesPage';
interface Props { variants: SpeciesPageVariant[]; required?: boolean; }
const { variants, required = false } = Astro.props;
---
<div class="variant-selector" id="variant-controls" hidden>
  <label for="variant-select">{required ? 'Подраса (обязательно)' : 'Вариант вида'}</label>
  <select id="variant-select" aria-describedby="variant-status" required={required}>
    <option value="">{required ? 'Выберите подрасу' : 'Базовый вариант'}</option>
    {variants.map(variant => <option value={variant.pageId} data-legacy-name={variant.name}>{variant.name} [{variant.sourceBook}]</option>)}
  </select>
  <a id="variant-permalink" href="?">Ссылка на выбранный вариант</a>
  <p id="variant-status" role="status" aria-live="polite" aria-atomic="true"></p>
</div>
<noscript><p>Подвиды и происхождения доступны ниже: раскройте нужный вариант, чтобы прочитать его полные правила.</p></noscript>
<style>
  .variant-selector { margin: 1rem 0; display: grid; gap: 0.6rem; }
  .variant-selector[hidden] { display: none; }
  label { font-weight: 600; }
  select { min-width: 0; width: 100%; padding: 0.75rem; border: 1px solid var(--card-border); border-radius: 0.5rem; background: var(--card-bg); color: var(--text); font: inherit; }
  select:focus-visible, a:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  a, p { font-size: 0.9rem; margin: 0; overflow-wrap: anywhere; }
</style>
<script>
  import { resolveSpeciesVariant, speciesViewUrl } from '../../utils/speciesPage';

  function initVariantSelector() {
    const select = document.querySelector<HTMLSelectElement>('#variant-select');
    const root = select?.closest<HTMLElement>('.species-page');
    if (!select || !root) return;
    const views = [...root.querySelectorAll<HTMLElement>('[data-species-view]')];
    const variants = [...select.options].filter(option => option.value).map(option => ({ pageId: option.value, name: option.dataset.legacyName || '' }));
    const permalink = root.querySelector<HTMLAnchorElement>('#variant-permalink')!;
    const status = root.querySelector<HTMLElement>('#variant-status')!;
    root.classList.add('species-enhanced');
    root.querySelector<HTMLElement>('#variant-controls')!.hidden = false;

    function hashTarget() {
      try { return document.getElementById(decodeURIComponent(location.hash.slice(1))); } catch { return null; }
    }

    function render(id: string, announce: boolean) {
      select!.value = id;
      views.forEach(view => {
        view.hidden = view.dataset.speciesView !== id;
        if (view instanceof HTMLDetailsElement) view.open = !view.hidden;
      });
      const metadata = root!.querySelector<HTMLElement>('[data-base-metadata]');
      if (metadata) metadata.hidden = !!id;
      permalink.href = speciesViewUrl(location.href, id);
      const active = views.find(view => !view.hidden)!;
      if (announce) status.textContent = active.querySelector('h2')?.textContent || '';
      document.dispatchEvent(new CustomEvent('abilities-updated', { detail: { container: active.querySelector('.abilities') } }));
    }

    function readLocation(scroll = false) {
      const target = hashTarget();
      const owner = target?.closest<HTMLElement>('[data-species-view]');
      const id = owner?.dataset.speciesView ?? resolveSpeciesVariant(location.search, variants);
      render(id, false);
      const canonical = speciesViewUrl(location.href, id);
      if (canonical !== location.pathname + location.search + location.hash) history.replaceState(history.state, '', canonical);
      // Direct links can target a descendant of the collapsed base description.
      for (let details = target?.closest('details'); details; details = details.parentElement?.closest('details') || null) details.open = true;
      if (target && scroll) requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
    }

    select.addEventListener('change', () => {
      const target = hashTarget();
      const owner = target?.closest<HTMLElement>('[data-species-view]');
      const hash = owner && owner.dataset.speciesView !== select.value ? '' : location.hash;
      const next = speciesViewUrl(location.href, select.value, hash);
      if (next !== location.pathname + location.search + location.hash) history.pushState(history.state, '', next);
      render(select.value, true);
    });
    window.addEventListener('popstate', () => readLocation(true));
    window.addEventListener('hashchange', () => readLocation(true));
    readLocation(true);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initVariantSelector, { once: true });
  else initVariantSelector();
</script>
