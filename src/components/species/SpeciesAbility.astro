---
import SpeciesText from './SpeciesText.astro';
interface Props { title: string; description: string; id?: string; origin?: string; }
const { title, description, id, origin } = Astro.props;
---
<div class="species-ability" id={id}>
  {origin && <p class="ability-origin">{origin}</p>}
  <h3 class="ability-title">{title}</h3>
  <div class="ability-description"><SpeciesText text={description} /></div>
</div>
<style>
  .species-ability { padding: 1rem; border-top: 1px solid var(--card-border); scroll-margin-top: 5rem; }
  .ability-title { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .ability-origin { font-size: 0.85rem; opacity: 0.8; margin: 0 0 0.25rem; }
  .ability-description { line-height: 1.6; }
</style>
