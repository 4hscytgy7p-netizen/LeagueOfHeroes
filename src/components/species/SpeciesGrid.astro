---
import { speciesData } from '../../data/species/index';
import SpeciesCard from './SpeciesCard.astro';
---

<div class="species-grid">
  {speciesData.map(s => (
    <SpeciesCard
      id={s.id}
      name={s.name}
      nameEn={s.nameEn}
      portrait={s.portrait}
      sourceBook={s.sourceBook}
    />
  ))}
</div>

<style>
  .species-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    padding: 1.5rem;
  }
</style>
