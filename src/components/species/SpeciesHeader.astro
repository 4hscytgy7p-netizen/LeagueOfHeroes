---
import MaterialMetadata from '../materials/MaterialMetadata.astro';
interface Props {
  id: string;
  name: string;
  nameEn: string;
  sourceBook: string;
}

const { id, name, nameEn } = Astro.props;
---

<div class="species-header">
  <h1>{name} <span class="name-en">[{nameEn}]</span></h1>
  <div data-base-metadata><MaterialMetadata kind="species" id={id} /></div>
  <p><a href="/races#race-attributes">Возраст, рост и вес: если значения не указаны →</a></p>
</div>

<style>
  .species-header {
    padding: 1rem;
    background: var(--card-bg);
    border-radius: 0.5rem 0.5rem 0 0;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .name-en {
    color: var(--text);
    opacity: 0.7;
    font-size: 0.8em;
  }

  .source {
    color: var(--text);
    opacity: 0.8;
  }
</style>
