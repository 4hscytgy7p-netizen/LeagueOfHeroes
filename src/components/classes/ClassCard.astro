---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Class } from '../../types/class';
import { classSummaries } from '../../data/classPresentation';
import { parseMaterialSource } from '../../utils/materialCatalog';

interface Props {
  classData: Class;
  eager?: boolean;
}

const { classData, eager = false } = Astro.props;
const { name, nameEn, portrait, sourceBook, id, primaryAbility, hitDice } = classData;
if (!primaryAbility?.trim() || !Number.isInteger(hitDice) || hitDice < 1) {
  throw new Error(`Class card ${id}: primaryAbility and hitDice are required`);
}
const summary = classSummaries[id];
const source = parseMaterialSource(sourceBook);
// Keep the original PNGs; Astro generates hashed WebP variants during the build.
const portraits = import.meta.glob<{ default: ImageMetadata }>('../../../public/images/classes/*.png');
const loadPortrait = portraits[`../../../public${portrait}`];
const original = loadPortrait ? (await loadPortrait()).default : undefined;
const image = original ? await getImage({
  src: original,
  width: Math.min(400, original.width),
  widths: [...new Set([160, 320, 400, 800].map(width => Math.min(width, original.width)))],
  format: 'webp',
  quality: 80,
}) : undefined;
---

<a href={`/classes/${id}`} class="class-card" aria-labelledby={`class-title-${id}`} aria-describedby={`class-stats-${id}`}>
  <div class="image-wrapper">
    <img
      src={image?.src ?? portrait}
      srcset={image?.srcSet.attribute}
      sizes="(max-width: 600px) 96px, (max-width: 768px) calc((100vw - 78px) / 2), (max-width: 800px) calc((100vw - 92px) / 2), (max-width: 1100px) calc((100vw - 132px) / 3), (max-width: 1232px) calc((100vw - 172px) / 4), 265px"
      width={original?.width}
      height={original?.height}
      alt=""
      class="portrait"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
  <div class="info">
    <h2 id={`class-title-${id}`}>{name}</h2>
    <div class="name-en">{nameEn}</div>
    {summary && <p class="class-summary">{summary}</p>}
    <dl class="class-stats" id={`class-stats-${id}`}>
      <div>
        <dt>Основная характеристика</dt>
        <dd>{primaryAbility}</dd>
      </div>
      <div class="hit-die">
        <dt>Кость хитов</dt>
        <dd>{`к${hitDice}`}</dd>
      </div>
    </dl>
    <div class="source">Источник: {source.label} <span class="subclass-count">· Подклассов: {classData.subclasses.length}</span></div>
  </div>
</a>

<style>
  .class-card {
    background: var(--card-bg);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: var(--card-shadow);
    border: 1px solid var(--card-border);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s, border-color 0.2s;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .class-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
  }

  .class-card:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 4px;
  }

  .class-card[hidden] {
    display: none;
  }

  .image-wrapper {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    flex: 0 0 auto;
  }

  .portrait {
    position: absolute;
    inset: 0;
    padding: 0.625rem;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .info {
    flex: 1;
    min-width: 0;
    padding: 1rem;
    border-top: 1px solid var(--card-border);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  h2 {
    font-size: 1.25rem;
    line-height: 1.3;
    margin: 0 0 0.25rem;
    color: var(--text);
  }

  .name-en {
    color: var(--text);
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }

  .class-stats {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .class-summary { font-size: 0.875rem; line-height: 1.5; margin: 0 0 0.875rem; }
  .subclass-count { white-space: nowrap; }

  .class-stats dt {
    font-size: 0.75rem;
    color: var(--text);
  }

  .class-stats dd {
    margin: 0;
  }

  .hit-die {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
  }

  .hit-die dd {
    font-weight: 700;
    color: var(--primary);
  }

  .source {
    font-size: 0.75rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 600px) {
    .class-card { flex-direction: row; align-items: center; }
    .image-wrapper { width: 108px; flex: 0 0 108px; }
    .portrait { padding: 0.375rem; }
    .info { border-top: 0; padding: 0.875rem 0.75rem; }
    h2 { font-size: 1.125rem; }
    .name-en { margin-bottom: 0.5rem; }
    .source { margin-top: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .class-card { transition: none; }
    .class-card:hover { transform: none; }
  }
</style>
