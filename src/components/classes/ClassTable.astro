---
import type { ClassLevel, ClassFeature, Subclass } from '../../types/class';
import { classSpellSlotLevels, featureAnchor } from '../../utils/classPage';

interface Props { levels: ClassLevel[]; features?: ClassFeature[]; subclasses?: Subclass[]; }
const { levels, features = [], subclasses = [] } = Astro.props;
const optionalColumns = [
  ['bardicInspiration', 'Бардовское вдохновение'], ['wildShape', 'Дикая форма'],
  ['theories', 'Известные теории'], ['chanelDivinity', 'Божественный канал'],
  ['cantrips', 'Заговоры'], ['preparedSpells', 'Подготовленные заклинания'],
  ['rage', 'Ярость'], ['rageDamage', 'Урон ярости'], ['secondWind', 'Второе дыхание'],
  ['maneuvers', 'Оружейные приёмы'], ['sneakAttack', 'Скрытая атака'],
  ['martialArts', 'Кость боевых искусств'], ['spiritPoints', 'Очки духа'],
  ['unarmedMovement', 'Движение без доспехов'], ['favoredEnemy', 'Избранный враг'],
  ['sorceryPoints', 'Очки чародейства'], ['invocations', 'Воззвания'],
  ['bloodMagicDie', 'Кость магии крови'], ['knownMaledicts', 'Известные проклятия крови'],
  ['amplifyBloodCurse', 'Усиление проклятия крови'], ['brandOfCastigation', 'Клеймо наказания'],
  ['numOfSpellSlots', 'Количество ячеек'], ['spellSlotsLvl', 'Уровень ячеек'],
  ['plansKnown', 'Известные схемы'], ['magicItems', 'Магические предметы'],
  ['fisticuffs', 'Кулачный бой'], ['moxiePoints', 'Очки удали'], ['focusPoints', 'Очки фокуса'],
  ['signs', 'Знаки'], ['alchemyFormulas', 'Алхимические формулы'],
].filter(([key]) => levels.some(level => level[key] !== undefined));
const maxSpellLevel = classSpellSlotLevels(levels).length;
const spellLevels = classSpellSlotLevels([...levels, ...subclasses.flatMap(subclass => subclass.spellcasting || [])]);
const rows = maxSpellLevel > 0 ? 2 : 1;
const slotCount = (level: ClassLevel, slot: number) => level.spellSlots?.[slot as keyof NonNullable<ClassLevel['spellSlots']>] || '—';
const resourceValue = (level: ClassLevel, key: string): string | number => {
  const value = level[key];
  return typeof value === 'number' || typeof value === 'string' ? value : '—';
};
---
<p class="table-hint">БМ — бонус мастерства. Прокрутите таблицу, чтобы увидеть все столбцы.</p>
<div class="table-container" id="class-progression-table" role="region" aria-label="Таблица развития класса" tabindex="0">
  <table class="class-table">
    <caption>Умения и ресурсы класса по уровням</caption>
    <thead>
      <tr>
        <th class="level" scope="col" rowspan={rows}>Уровень</th>
        <th scope="col" rowspan={rows}><abbr title="Бонус мастерства">БМ</abbr></th>
        <th class="features" scope="col" rowspan={rows}>Умения</th>
        {optionalColumns.map(([key, label]) => <th scope="col" rowspan={rows} data-resource={key}>{label}</th>)}
        {spellLevels.length > 0 && <th scope="colgroup" data-spell-slot-group colspan={maxSpellLevel || 1} hidden={!maxSpellLevel}>Ячейки заклинаний</th>}
      </tr>
      {spellLevels.length > 0 && <tr data-spell-slot-levels hidden={!maxSpellLevel}>{spellLevels.map(level => <th scope="col" data-spell-slot={level} hidden={level > maxSpellLevel} aria-label={`Ячейки ${level}-го уровня`}>{level}</th>)}</tr>}
    </thead>
    <tbody>
      {levels.map(level => <tr data-level={level.level}>
        <th class="level" scope="row">{level.level}</th>
        <td>{level.profBonus}</td>
        <td class="features" data-progression-features data-level={level.level}>
          {level.features.map((name, index) => {
            const feature = features.find(feature => feature.name === name && feature.level === level.level);
            return <Fragment>{index > 0 && ', '}{feature ? <a href={`#${featureAnchor(feature.name, feature.level)}`} data-feature-anchor={featureAnchor(feature.name, feature.level)}>{name}</a> : name}</Fragment>;
          })}
        </td>
        {optionalColumns.map(([key]) => <td>{resourceValue(level, key)}</td>)}
        {spellLevels.map(spellLevel => <td data-spell-slot={spellLevel} hidden={spellLevel > maxSpellLevel}>{slotCount(level, spellLevel)}</td>)}
      </tr>)}
    </tbody>
  </table>
</div>

<style>
  .table-hint { font-size: 0.875rem; margin: 0.5rem 0; }
  .table-container { width: 100%; min-width: 0; max-width: 100%; overflow: auto; max-height: 70vh; margin: 0.75rem 0 1.5rem; border: 1px solid var(--card-border); border-radius: 0.75rem; background: var(--card-bg); }
  .table-container:focus-visible { outline: 3px solid var(--primary); outline-offset: 3px; }
  .class-table { width: 100%; min-width: 640px; border-collapse: separate; border-spacing: 0; font-size: 0.875rem; }
  caption { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  th, td { padding: 0.75rem; border-bottom: 1px solid var(--card-border); text-align: center; vertical-align: top; min-width: 48px; }
  thead { position: sticky; top: 0; z-index: 3; }
  thead th { background: var(--card-bg); color: var(--text); font-weight: 600; }
  .level { position: sticky; left: 0; z-index: 1; background: var(--card-bg); min-width: 64px; border-right: 1px solid var(--card-border); }
  thead .level { z-index: 4; }
  .features { text-align: left; min-width: 220px; line-height: 1.5; }
  .features a { color: var(--primary); text-underline-offset: 3px; }
  tbody tr:nth-child(even) { background: color-mix(in srgb, var(--background) 35%, var(--card-bg)); }
  tbody tr:hover { background: var(--nav-hover-bg); }
  tbody tr[hidden] { display: none; }
  abbr { text-decoration: none; }
  @media (max-width: 600px) { th, td { padding: 0.625rem; } }
</style>
