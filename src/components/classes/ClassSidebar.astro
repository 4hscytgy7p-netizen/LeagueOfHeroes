---
import type { Class } from '../../types/class';
import { featureAnchor } from '../../utils/classPage';
interface Props { classes: Class[]; activeClassId?: string; currentSubclassId?: string; }
const { classes, activeClassId, currentSubclassId } = Astro.props;
const activeClass = classes.find(item => item.id === activeClassId);
const otherClasses = classes.filter(item => item.id !== activeClassId).sort((a, b) => a.name.localeCompare(b.name, 'ru'));
const sections = [['overview', 'Обзор'], ['subclass-panel', 'Подклассы'], ['basics', 'Характеристики и владения'], ['equipment', 'Стартовое снаряжение'], ['progression', 'Развитие'], ['features-container', 'Умения']];
---
<button type="button" class="class-sidebar-fab" aria-controls="class-contents" aria-label="Открыть содержание класса" aria-expanded="false" hidden><span aria-hidden="true">☰</span> Содержание</button>
<div class="class-sidebar-overlay" hidden></div>
<nav id="class-contents" class="class-sidebar is-collapsed" aria-label="Содержание класса">
  <div class="sidebar-head"><div class="sidebar-title">{activeClass?.name || 'Классы'}</div><button type="button" class="class-sidebar-close" aria-label="Закрыть содержание">×</button></div>
  <ul class="section-list">{sections.map(([id, title]) => <li><a href={`#${id}`}>{title}</a></li>)}</ul>
  {activeClass && <div class="class-accordion">
    <details class="sidebar-group"><summary>Общие умения</summary><ul class="feature-list">
      {activeClass.features.map(feature => <li><button type="button" class="sidebar-feature-link" data-feature-anchor={featureAnchor(feature.name, feature.level)} data-subclass-id=""><span>{feature.name}</span><span class="sidebar-feature-level">Ур. {feature.level}</span></button></li>)}
    </ul></details>
    <details class="sidebar-group"><summary>Подклассы · {activeClass.subclasses.length}</summary><ul class="subclass-list">
      {activeClass.subclasses.map(subclass => <li class={`subclass-item ${subclass.id === currentSubclassId ? 'is-selected' : ''}`} data-subclass-id={subclass.id}>
        <details class="subclass-group"><summary>{subclass.name}</summary>
          <a class="subclass-overview-link" href={`/classes/${activeClass.id}?subclass=${encodeURIComponent(subclass.id)}#subclass-panel`} data-select-subclass={subclass.id}>Открыть подкласс →</a>
          <ul class="feature-list">{subclass.features.map(feature => <li><button type="button" class="sidebar-feature-link" data-feature-anchor={featureAnchor(feature.name, feature.level, true)} data-subclass-id={subclass.id}><span>{feature.name}</span><span class="sidebar-feature-level">Ур. {feature.level}</span></button></li>)}</ul>
        </details>
      </li>)}
    </ul></details>
  </div>}
  <details class="other-classes"><summary>Другой класс</summary><ul class="class-list">{otherClasses.map(item => <li><a href={`/classes/${item.id}`}>{item.name}</a></li>)}</ul></details>
</nav>

<script>
  const sidebar = document.querySelector<HTMLElement>('.class-sidebar');
  const openButton = document.querySelector<HTMLButtonElement>('.class-sidebar-fab');
  const closeButton = document.querySelector<HTMLButtonElement>('.class-sidebar-close');
  const overlay = document.querySelector<HTMLElement>('.class-sidebar-overlay');
  const content = document.querySelector<HTMLElement>('.class-detail .main-column');
  if (sidebar && openButton && closeButton && overlay) {
    const desktop = matchMedia('(min-width: 1100px)');
    let open = false;
    let savedOverflow = '';
    const focusable = () => Array.from(sidebar.querySelectorAll<HTMLElement>('a, button, summary, [tabindex="0"]')).filter(node => {
      if (!node.getClientRects().length) return false;
      for (let parent = node.parentElement; parent && parent !== sidebar; parent = parent.parentElement) {
        if (parent instanceof HTMLDetailsElement && !parent.open && parent.querySelector(':scope > summary') !== node) return false;
      }
      return true;
    });
    const close = (restoreFocus = true) => {
      open = false;
      sidebar.classList.add('is-collapsed');
      sidebar.inert = !desktop.matches;
      sidebar.removeAttribute('role');
      sidebar.removeAttribute('aria-modal');
      overlay.hidden = true;
      if (content) content.inert = false;
      document.body.style.overflow = savedOverflow;
      openButton.hidden = desktop.matches;
      openButton.setAttribute('aria-expanded', 'false');
      if (restoreFocus && !desktop.matches) openButton.focus();
    };
    const show = () => {
      if (desktop.matches) return;
      savedOverflow = document.body.style.overflow;
      open = true;
      sidebar.inert = false;
      sidebar.classList.remove('is-collapsed');
      sidebar.setAttribute('role', 'dialog');
      sidebar.setAttribute('aria-modal', 'true');
      overlay.hidden = false;
      if (content) content.inert = true;
      document.body.style.overflow = 'hidden';
      openButton.hidden = true;
      openButton.setAttribute('aria-expanded', 'true');
      closeButton.focus();
    };
    openButton.addEventListener('click', show);
    closeButton.addEventListener('click', () => close());
    overlay.addEventListener('click', () => close());
    sidebar.addEventListener('click', event => {
      const target = (event.target as Element).closest('a, .sidebar-feature-link');
      if (target && open) close(false);
    });
    document.addEventListener('keydown', event => {
      if (!open) return;
      if (event.key === 'Escape') { event.preventDefault(); close(); }
      if (event.key === 'Tab') {
        const items = focusable();
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }
    });
    document.addEventListener('focusin', event => {
      if (open && !sidebar.contains(event.target as Node)) closeButton.focus();
    });
    desktop.addEventListener('change', () => close(false));
    close(false);
  }
</script>

<style>
  .class-sidebar { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 0.75rem; padding: 1rem; max-height: calc(100dvh - 7rem); overflow-y: auto; scrollbar-gutter: stable; }
  .sidebar-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
  .sidebar-title { font-weight: 700; font-size: 1.125rem; color: var(--primary); }
  .class-sidebar-close { display: none; min-width: 44px; min-height: 44px; font-size: 1.75rem; border: 1px solid var(--card-border); border-radius: 0.5rem; color: var(--text); background: var(--background); cursor: pointer; }
  .class-sidebar-fab[hidden], .class-sidebar-overlay[hidden] { display: none; }
  .class-sidebar-fab { display: none; }
  ul { list-style: none; padding: 0; margin: 0; }
  .section-list { display: grid; gap: 0.125rem; margin-bottom: 1rem; }
  .section-list a, .class-list a { display: block; padding: 0.625rem 0.5rem; border-radius: 0.375rem; color: var(--text); text-decoration: none; font-size: 0.875rem; }
  a:hover { background: var(--nav-hover-bg); }
  .class-accordion { display: grid; gap: 0.625rem; }
  details { border-top: 1px solid var(--card-border); }
  summary { padding: 0.75rem 0.25rem; cursor: pointer; font-size: 0.875rem; font-weight: 600; }
  .feature-list, .subclass-list { display: grid; gap: 0.375rem; }
  .sidebar-feature-link { display: flex; flex-direction: column; width: 100%; padding: 0.625rem; min-height: 44px; text-align: left; font: inherit; font-size: 0.8125rem; line-height: 1.4; border: 1px solid var(--card-border); border-radius: 0.5rem; color: var(--text); background: var(--background); cursor: pointer; }
  .sidebar-feature-level { font-size: 0.75rem; margin-top: 0.25rem; }
  .sidebar-feature-link:hover, .sidebar-feature-link.is-active { border-color: var(--primary); }
  .subclass-item.is-selected > details > summary { color: var(--primary); }
  .subclass-overview-link { display: block; padding: 0.5rem; font-size: 0.8125rem; color: var(--primary); }
  .other-classes { margin-top: 1rem; }
  :is(a, button, summary):focus-visible { outline: 3px solid var(--primary); outline-offset: 2px; }
  @media (max-width: 1099px) {
    .class-sidebar-fab { display: inline-flex; align-items: center; gap: 0.5rem; position: fixed; bottom: 1rem; left: 0.75rem; z-index: 990; min-height: 44px; padding: 0.625rem 0.875rem; border: 1px solid var(--card-border); border-radius: 999px; background: var(--card-bg); color: var(--text); box-shadow: var(--card-shadow); cursor: pointer; font: inherit; font-size: 0.875rem; }
    .class-sidebar { position: fixed; top: 0.5rem; bottom: 0.5rem; left: 0.5rem; width: min(340px, calc(100vw - 1rem)); max-height: none; z-index: 1001; }
    .class-sidebar.is-collapsed { visibility: hidden; pointer-events: none; }
    .class-sidebar-close { display: block; }
    .class-sidebar-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55); z-index: 1000; }
  }
</style>
