---
import Layout from '../layouts/Layout.astro';
import { leagueRules } from '../data/leagueRules';
---

<Layout title="Правила прежней эрраты перенесены">
  <meta slot="head" name="robots" content="noindex, follow" />
  <div class="content">
    <h1>Правила прежней эрраты перенесены</h1>
    <p>Действующие правила Лиги теперь находятся в тематических разделах. Описания карточек уже могут включать адаптации для Лиги; используйте их вместе с применимыми общими правилами.</p>
    <ul>{Object.entries(leagueRules).map(([id, rule]) => <li id={id}><a href={rule.href}>{rule.title} →</a></li>)}</ul>
    <p><a href="/general-rules#core-mechanics">Общие правила →</a> · <a href="/allowed-materials">Разрешённые материалы →</a></p>
  </div>
</Layout>

<script>
  import { leagueRules, type LeagueRuleId } from '../data/leagueRules';
  function followLegacyRule() {
    const id = window.location.hash.slice(1);
    if (Object.hasOwn(leagueRules, id)) window.location.replace(leagueRules[id as LeagueRuleId].href);
  }
  followLegacyRule();
  window.addEventListener('hashchange', followLegacyRule);
</script>

<style>
  .content {
    max-width: 800px;
    margin: 0 auto;
  }


</style>
