---
import Layout from "../layouts/Layout.astro";
import { glossary } from "../data/glossary";
import "../styles/glossary.css";

const items = [...glossary].sort((a, b) => a.name.localeCompare(b.name, "ru"));
const categories = [...new Set(items.map((rule) => rule.category))].sort((a, b) => a.localeCompare(b, "ru"));
---

<Layout title="Глоссарий правил">
    <div class="glossary-page" id="glossary-page">
        <header class="glossary-heading">
            <p class="glossary-eyebrow">Справочник игрока</p>
            <h1>Глоссарий правил</h1>
            <p>Найдите термин, уточните правило и сохраните нужное под рукой.</p>
        </header>

        <div class="glossary-workspace">
            <aside class="glossary-sidebar" aria-label="Поиск и список терминов">
                <div class="glossary-controls">
                    <label for="glossary-search" class="glossary-search-label">Найти правило</label>
                    <div class="glossary-search-wrap">
                        <input id="glossary-search" type="search" placeholder="Название или текст правила…" autocomplete="off" aria-controls="rules-list" />
                        <button id="clear-search" class="glossary-icon-button" type="button" aria-label="Очистить поиск" hidden>×</button>
                    </div>
                    <button id="filter-button" class="glossary-button glossary-filter-toggle" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="category-panel">
                        Категории <span id="filter-count" class="glossary-badge" hidden>0</span><span aria-hidden="true">⌄</span>
                    </button>
                    <div class="glossary-results-bar">
                        <p id="result-count" role="status" aria-live="polite" aria-atomic="true">Терминов: {items.length}</p>
                        <button id="reset-all" class="glossary-text-button" type="button" hidden>Сбросить всё</button>
                    </div>
                </div>
                <nav id="rules-list" class="glossary-rules-list" aria-label="Термины глоссария">
                    {items.map((rule) => (
                        <a class="glossary-rule" href={`#${encodeURIComponent(rule.id)}`} data-id={rule.id}>
                            <span class="glossary-rule-name">{rule.name}</span>
                            <span class="glossary-rule-english" lang="en">{rule.nameEn}</span>
                            <span class="glossary-rule-category">{rule.category}</span>
                        </a>
                    ))}
                </nav>
                <div id="no-results" class="glossary-empty" hidden>
                    <h2>Ничего не найдено</h2>
                    <p>Попробуйте другой запрос или уберите категории.</p>
                    <button id="empty-reset" class="glossary-button" type="button">Сбросить поиск и фильтры</button>
                </div>
            </aside>

            <section class="glossary-reading" aria-label="Описание правила">
                <button id="back-to-list" class="glossary-button glossary-back" type="button">← К списку</button>
                <article id="details-area" class="glossary-detail" aria-label="Выбранный термин">
                    <div class="glossary-empty glossary-welcome">
                        <span class="glossary-empty-symbol" aria-hidden="true">А—Я</span>
                        <h2>Какое правило уточним?</h2>
                        <p>Выберите термин в списке или найдите его по названию и тексту. Можно закрепить до двух правил для быстрого доступа.</p>
                    </div>
                </article>
                <section id="pinned-section" class="glossary-pinned-section" aria-labelledby="pinned-heading" hidden>
                    <div class="glossary-section-heading">
                        <h2 id="pinned-heading">Закреплённые</h2>
                        <span id="pinned-count" class="glossary-badge">0/2</span>
                    </div>
                    <div id="pinned-list" class="glossary-pinned-list"></div>
                </section>
                <p id="glossary-status" class="glossary-status" role="status" aria-live="polite" aria-atomic="true"></p>
            </section>
        </div>

        <dialog id="category-panel" class="glossary-category-dialog" aria-labelledby="category-dialog-title" aria-describedby="category-dialog-description">
            <div class="glossary-dialog-header">
                <h2 id="category-dialog-title">Категории правил</h2>
                <button id="close-category-dialog" class="glossary-icon-button" type="button" aria-label="Закрыть категории">×</button>
            </div>
            <div class="glossary-category-body">
                <p id="category-dialog-description">Можно выбрать несколько категорий. Результаты обновляются сразу.</p>
                <div id="selected-categories" class="glossary-chips" aria-label="Выбранные категории" hidden></div>
                <fieldset class="glossary-category-options">
                    <legend class="glossary-sr-only">Фильтр по категориям</legend>
                    {categories.map((category) => (
                        <label>
                            <input type="checkbox" name="glossary-category" value={category} />
                            <span>{category}</span>
                            <span class="glossary-category-count">{items.filter((rule) => rule.category === category).length}</span>
                        </label>
                    ))}
                </fieldset>
            </div>
            <div class="glossary-category-footer">
                <p id="category-result-count" role="status" aria-live="polite" aria-atomic="true">Терминов: {items.length}</p>
                <div class="glossary-category-actions">
                    <button id="reset-categories" class="glossary-button" type="button" disabled>Сбросить категории</button>
                    <button id="done-categories" class="glossary-button glossary-primary-button" type="button">Показать результаты</button>
                </div>
            </div>
        </dialog>

        <dialog id="pin-dialog" class="glossary-pin-dialog" aria-labelledby="pin-dialog-title" aria-describedby="pin-dialog-description">
            <div class="glossary-dialog-header">
                <h2 id="pin-dialog-title">Заменить закреплённое правило?</h2>
                <button id="close-pin-dialog" class="glossary-icon-button" type="button" aria-label="Закрыть окно">×</button>
            </div>
            <p id="pin-dialog-description">Уже закреплены два правила. Выберите, какое заменить.</p>
            <div id="pin-replacements" class="glossary-replacements"></div>
            <button id="cancel-pin-dialog" class="glossary-button" type="button">Отмена</button>
        </dialog>
        <noscript><p>Для поиска и просмотра терминов включите JavaScript в браузере.</p></noscript>
    </div>
</Layout>

<script>
    import "../scripts/glossary";
</script>
