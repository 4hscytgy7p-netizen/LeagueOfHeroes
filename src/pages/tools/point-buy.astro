---
import Layout from '../../layouts/Layout.astro';
import StatRow from '../../components/tools/point-buy/StatRow.astro';
import { BONUS_BUDGET, COST_TABLE, INITIAL_STATS, POINT_BUDGET, STAT_KEYS } from '../../utils/pointBuy';
import '../../styles/pointBuy.css';
---

<Layout title="Point Buy калькулятор">
  <div class="point-buy-page">
    <header class="page-heading">
      <h1>Point Buy калькулятор</h1>
      <p>Распределите 27 очков и добавьте бонусы предыстории.</p>
    </header>

    <section class="calculator" aria-label="Распределение характеристик">
      <div class="budget-bar" aria-label="Оставшийся бюджет">
        <div class="budget-card">
          <span class="budget-label">Осталось очков</span>
          <span class="budget-number"><strong id="points-remaining">{POINT_BUDGET}</strong><span> / {POINT_BUDGET}</span></span>
          <progress id="points-progress" value="0" max={POINT_BUDGET} aria-label="Потраченные очки характеристик"></progress>
        </div>
        <div class="budget-card">
          <span class="budget-label">Осталось бонусов</span>
          <span class="budget-number"><strong id="bonuses-remaining">{BONUS_BUDGET}</strong><span> / {BONUS_BUDGET}</span></span>
          <progress id="bonuses-progress" value="0" max={BONUS_BUDGET} aria-label="Распределённые бонусы предыстории"></progress>
        </div>
      </div>

      <div class="calculator-body">
        <noscript><p class="notice">Для изменения характеристик включите JavaScript.</p></noscript>

        <table class="stats-table" role="table" aria-label="Характеристики персонажа">
          <thead role="rowgroup">
            <tr role="row">
              <th scope="col" role="columnheader">Характеристика</th>
              <th scope="col" role="columnheader">База</th>
              <th scope="col" role="columnheader">Бонус предыстории</th>
              <th scope="col" role="columnheader">Итого / мод.</th>
              <th scope="col" role="columnheader">Стоимость</th>
            </tr>
          </thead>
          <tbody id="stats-table" role="rowgroup">
            {STAT_KEYS.map((stat) => <StatRow stat={stat} value={INITIAL_STATS[stat]} />)}
          </tbody>
        </table>

        <div class="calculator-footer">
          <div class="footer-main">
            <p id="distribution-status" class="distribution-status" role="status" aria-live="polite" aria-atomic="true">Осталось: 27 очк. и 3 бонуса.</p>
            <div class="actions">
              <button type="button" id="copy-result-btn" class="action-btn primary-btn" aria-label="Копировать результат" title="Копировать результат" disabled>
                <span class="desktop-action-label">Копировать результат</span>
                <span class="mobile-action-label" aria-hidden="true">Результат</span>
              </button>
              <button type="button" id="copy-link-btn" class="action-btn" aria-label="Копировать ссылку" title="Копировать ссылку" disabled>
                <span class="desktop-action-label">Копировать ссылку</span>
                <span class="mobile-action-label" aria-hidden="true">Ссылка</span>
              </button>
              <button type="button" id="reset-btn" class="action-btn reset-btn" disabled>Сбросить</button>
            </div>
          </div>
          <div class="calculator-support">
            <details class="rules-help">
              <summary>Как это работает</summary>
              <div class="rules-content">
                <p>Начните с 8 в каждой характеристике. Повышайте базовые значения до 15, расходуя 27 очков. Шаги 13 → 14 и 14 → 15 стоят по 2 очка; остальные — по 1.</p>
                <p>Распределите бонусы предыстории: +2 и +1 либо три раза по +1. На одну характеристику можно назначить не больше +2; итоговое значение — не больше 17. Бонусы не расходуют очки характеристик.</p>
                <p>Модификатор рассчитывается из итогового значения: например, 14 и 15 дают +2, а 16 и 17 — +3.</p>
                <dl class="cost-guide" aria-label="Стоимость базовых значений">
                  {Object.entries(COST_TABLE).map(([value, cost]) => (
                    <div><dt>{value}</dt><dd>{cost} очк.</dd></div>
                  ))}
                </dl>
              </div>
            </details>
            <p id="storage-status" class="storage-status">Сохраняется автоматически.</p>
          </div>
          <p id="action-status" class="action-status" role="status" aria-live="polite" aria-atomic="true"></p>
          <div id="manual-copy" class="manual-copy" hidden>
            <label for="copy-text">Текст для копирования</label>
            <textarea id="copy-text" rows="8" readonly spellcheck="false"></textarea>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { initializeCalculator } from '../../components/tools/point-buy/pointBuyCalculator';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeCalculator, { once: true });
  } else {
    initializeCalculator();
  }
</script>
