---
import Layout from '../../layouts/Layout.astro';
import { crXPValues } from '../../data/encounters';
---

<Layout title="Калькулятор столкновений">
  <div class="content" id="encounter-builder">
    <h1>Калькулятор столкновений</h1>
    <p>По правилам DMG 2024: опыт противников суммируется без множителя за их количество. Бюджеты складываются по уровням персонажей.</p>
    <p><a href="/books/dmg-2024-ru/planning-scenes/#p97-1">Сложность сцен сражения — DMG 2024, стр. 97</a></p>
    <noscript>Для расчёта и сохранения столкновения включите JavaScript.</noscript>
    <div class="save-bar"><p id="encounter-save-status" role="status">Столкновение сохраняется автоматически в этом браузере.</p><button type="button" id="clear-encounter" class="remove-btn">Очистить столкновение</button></div>
    <div class="calculator-grid">
      <section class="characters-section" aria-labelledby="characters-heading">
        <h2 id="characters-heading">Персонажи</h2>
        <form id="character-form" novalidate>
          <div class="input-group">
            <label>Количество<input type="number" id="char-count" min="1" step="1" required class="number-input" aria-describedby="character-error"></label>
            <label>Уровень<input type="number" id="char-level" min="1" max="20" step="1" required class="number-input" aria-describedby="character-error"></label>
            <button type="submit" class="add-btn" id="add-character" aria-label="Добавить персонажей">+</button>
          </div>
          <p id="character-error" class="input-error" role="alert" hidden></p>
        </form>
        <div id="character-list" class="character-list"></div>
        <div class="party-info"><p>Персонажей: <span id="party-count">0</span></p><p>Средний уровень: <span id="avg-level">—</span></p></div>
        <div class="difficulty-thresholds">
          <h3>Бюджеты опыта</h3>
          <p>Категория соответствует наименьшему бюджету, в который укладывается суммарный опыт. Сумма выше высокого бюджета отмечается отдельно.</p>
          <div class="thresholds-grid">
            {['low', 'moderate', 'high'].map((key, index) => <div class="threshold"><span class="label">{['Низкая', 'Средняя', 'Высокая'][index]}</span><span id={key + '-threshold'} class="value">—</span><div id={key + '-per-character'} class="per-character">—</div></div>)}
          </div>
        </div>
      </section>
      <section class="encounter-section" aria-labelledby="monsters-heading">
        <h2 id="monsters-heading">Противники</h2>
        <form id="monster-form" novalidate>
          <div class="input-group monster-inputs">
            <label>Название<input type="text" id="monster-name" maxlength="200" required class="text-input" aria-describedby="monster-error"></label>
            <label>CR (ПО)<input type="text" id="monster-cr" list="cr-options" required class="number-input" aria-describedby="monster-error" placeholder="Например, 1/4"></label>
            <datalist id="cr-options">{crXPValues.map(item => <option value={item.cr} />)}</datalist>
            <label>Количество<input type="number" id="monster-count" min="1" step="1" required class="number-input" aria-describedby="monster-error"></label>
            <button type="submit" class="add-btn" id="add-monster" aria-label="Добавить противников">+</button>
          </div>
          <label id="zero-xp-control" hidden>Опыт за CR 0 по статблоку<select id="zero-xp"><option value="10">10 опыта</option><option value="0">0 опыта</option></select></label>
          <p id="monster-error" class="input-error" role="alert" hidden></p>
        </form>
        <div id="monster-list" class="monster-list"></div>
        <div class="encounter-info" aria-live="polite" aria-atomic="true">
          <h3>Параметры столкновения</h3>
          <p>Общая сложность: <span id="total-difficulty">Добавьте персонажей</span><span id="difficulty-multiplier"></span></p>
          <p>Общий опыт: <span id="total-xp">0</span></p>
          <p>Опыт на персонажа: <span id="xp-per-character">—</span></p>
          <p>Опыт здесь служит для оценки столкновения. Награды Лиги определяются её правилами.</p>
          <ul id="encounter-warnings" hidden></ul>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  import '../../scripts/encounterBuilder';
</script>

<style>
  .content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .calculator-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }

  .characters-section,
  .encounter-section {
    background: var(--card-bg);
    padding: 1.5rem;
    border-radius: 0.5rem;
    box-shadow: var(--card-shadow);
    border: 1px solid var(--card-border);
  }

  .input-group {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .text-input,
  .number-input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.5rem;
    border: 1px solid var(--card-border);
    border-radius: 0.25rem;
    background: var(--background);
    color: var(--text);
  }

  .add-btn {
    padding: 0.5rem 1rem;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 0.25rem;
    cursor: pointer;
  }

  .add-btn:hover {
    background: var(--primary-dark);
  }

  :global(#encounter-builder .list-item) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 0.5rem;
    background: var(--background);
    border-radius: 0.25rem;
    margin-bottom: 0.5rem;
  }

  :global(#encounter-builder .list-item .remove-btn) {
    line-height: 1;
    height: 24px;
    width: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #encounter-builder :global(.remove-btn) {
    background: none;
    border: none;
    color: var(--text);
    cursor: pointer;
    font-size: 1.25rem;
    padding: 0 0.5rem;
  }

  #encounter-builder :global(.remove-btn:hover) {
    color: #dc2626;
  }

  .difficulty-thresholds {
    margin-top: 2rem;
  }

  .thresholds-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  .threshold {
    background: var(--background);
    padding: 1rem;
    border-radius: 0.25rem;
    text-align: center;
  }

  .threshold .per-character {
    font-size: 0.875rem;
    color: var(--text);
    opacity: 0.8;
    margin-top: 0.25rem;
  }

  .threshold .label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .party-info,
  .encounter-info {
    margin-top: 2rem;
  }

  h2 {
    margin-bottom: 1rem;
  }

  h3 {
    margin: 1.5rem 0 1rem;
  }

  p {
    margin-bottom: 0.5rem;
  }

  label { display: grid; gap: 0.35rem; min-width: 0; flex: 1 1 5rem; }
  .monster-inputs label:first-child { flex-basis: 100%; }
  .save-bar { display: flex; gap: 1rem; align-items: center; justify-content: space-between; flex-wrap: wrap; margin: 1rem 0; }
  .save-bar .remove-btn { font-size: 1rem; text-decoration: underline; }
  .input-error { color: var(--text); border-left: 3px solid #dc2626; padding-left: 0.75rem; }
  :global(#encounter-builder .list-item span) { overflow-wrap: anywhere; min-width: 0; }
  :global(#encounter-builder .list-item .remove-btn) { flex-shrink: 0; }
  select { padding: 0.5rem; background: var(--background); color: var(--text); border: 1px solid var(--card-border); }
  #encounter-warnings { padding-left: 1.2rem; margin-top: 1rem; }
  [hidden] { display: none !important; }
  #encounter-builder :global(button:focus-visible), input:focus-visible, select:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  @media (max-width: 760px) {
    .content { padding: 1rem; }
    .calculator-grid { grid-template-columns: 1fr; gap: 1rem; }
    .characters-section, .encounter-section { padding: 1rem; min-width: 0; }
    .thresholds-grid { gap: 0.35rem; }
    .threshold { padding: 0.5rem 0.25rem; overflow-wrap: anywhere; }
  }
</style>
