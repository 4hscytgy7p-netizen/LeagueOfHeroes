---
import Layout from '../../layouts/Layout.astro';
import '../../styles/gameStats.css';
---

<Layout title="Статистика игр">
  <div class="game-stats-page">
    <header class="stats-heading">
      <div>
        <p class="stats-eyebrow">Жизнь Лиги · За всё время</p>
        <h1>Статистика игр</h1>
        <p class="stats-muted">Партии, участники и прогресс — от общего обзора до вашей статистики.</p>
      </div>
      <div class="stats-source">
        <p id="stats-loaded-at" class="stats-muted">Актуальные данные при открытии страницы</p>
        <button id="stats-reload" class="stats-button" type="button" disabled>Обновить данные</button>
      </div>
    </header>

    <div id="stats-load-message" class="stats-load-message" role="status" aria-live="polite" aria-atomic="true">
      Загрузка актуальной статистики…
    </div>
    <noscript><p>Для загрузки статистики включите JavaScript. Данные также доступны по ссылке «Источник данных».</p></noscript>
    <div id="stats-skeleton" class="stats-skeleton" aria-hidden="true">
      <div class="stats-skeleton-controls"></div>
      <div class="stats-summary-grid">
        {[1, 2, 3, 4].map(() => <div class="stats-skeleton-card"></div>)}
      </div>
      <div class="stats-skeleton-chart"></div>
    </div>

    <div id="stats-content" hidden aria-busy="true">
      <section class="stats-panel stats-filters" aria-labelledby="stats-filters-title">
        <div class="stats-section-heading">
          <div><h2 id="stats-filters-title">Выберите партии</h2><p class="stats-muted">Фильтры применяются ко всей странице.</p></div>
          <button id="stats-reset" class="stats-button" type="button">Сбросить фильтры</button>
        </div>
        <div class="stats-filter-grid">
          <div class="stats-field">
            <label for="stats-gm">Мастер</label>
            <input id="stats-gm" type="search" list="stats-gm-options" placeholder="Все мастера · поиск по имени" autocomplete="off" aria-describedby="stats-gm-hint" />
            <datalist id="stats-gm-options"></datalist>
            <span id="stats-gm-hint" class="stats-field-hint">Начните вводить имя и выберите из списка.</span>
          </div>
          <div class="stats-field">
            <label for="stats-player">Игрок</label>
            <input id="stats-player" type="search" list="stats-player-options" placeholder="Все игроки · поиск по имени" autocomplete="off" aria-describedby="stats-player-hint" />
            <datalist id="stats-player-options"></datalist>
            <span id="stats-player-hint" class="stats-field-hint">Партии с участием выбранного игрока.</span>
          </div>
        </div>
        <div class="stats-selection-bar">
          <p id="stats-results" role="status" aria-live="polite" aria-atomic="true"></p>
          <div id="stats-filter-chips" class="stats-chips" aria-label="Активные фильтры"></div>
          <button id="stats-share" class="stats-button stats-share" type="button">Скопировать ссылку</button>
        </div>
        <p id="stats-share-status" class="stats-field-hint" role="status"></p>
      </section>

      <section class="stats-summary" aria-labelledby="stats-summary-title">
        <h2 id="stats-summary-title" class="stats-visually-hidden">Сводка выбранных партий</h2>
        <div class="stats-summary-grid">
          <div class="stats-summary-card"><span data-stats-summary="totalParties" class="stats-summary-value"></span><span>Партий в выборке</span></div>
          <div class="stats-summary-card"><span data-stats-summary="uniqueGMs" class="stats-summary-value"></span><span>Мастеров</span></div>
          <div class="stats-summary-card"><span data-stats-summary="uniquePlayers" class="stats-summary-value"></span><span>Игроков</span></div>
          <div class="stats-summary-card"><span data-stats-summary="averagePlayersPerParty" class="stats-summary-value"></span><span>Игроков за партию в среднем</span></div>
        </div>
      </section>

      <section id="stats-personal" class="stats-panel stats-personal" aria-labelledby="stats-personal-title" hidden>
        <h2 id="stats-personal-title"></h2>
        <p class="stats-muted">Личные показатели игрока в выбранных партиях.</p>
        <dl id="stats-personal-values" class="stats-personal-grid"></dl>
      </section>

      <section id="stats-no-results" class="stats-panel stats-empty" hidden>
        <h2 id="stats-empty-title">Подходящих партий нет</h2>
        <p id="stats-empty-description">Измените выбранные имена или сбросьте фильтры.</p>
        <button id="stats-empty-reset" class="stats-button" type="button">Сбросить фильтры</button>
      </section>

      <div id="stats-analysis">
        <section class="stats-panel" aria-labelledby="stats-chart-title">
          <div class="stats-section-heading">
            <div><h2 id="stats-chart-title">Игроки по числу участий</h2><p id="stats-chart-description" class="stats-muted"></p></div>
            <div class="stats-segmented" role="group" aria-label="Вид графика">
              <button type="button" data-chart="bar" aria-pressed="true">Столбцы</button>
              <button type="button" data-chart="pie" aria-pressed="false">Доли</button>
            </div>
          </div>
          <div class="stats-field stats-chart-metric">
            <label for="stats-chart-metric">Показатель</label>
            <select id="stats-chart-metric">
              <option value="players_games">Участия игроков</option>
              <option value="players_progress">ОП игроков</option>
              <option value="gms_games">Партии мастеров</option>
              <option value="gms_progress">ОП мастеров</option>
            </select>
          </div>
          <div id="stats-chart" class="stats-chart"></div>
          <p id="stats-chart-note" class="stats-field-hint"></p>
          <details class="stats-chart-data">
            <summary>Данные графика в таблице — все участники</summary>
            <div class="stats-table-scroll" tabindex="0" role="region" aria-label="Таблица данных графика">
              <table><caption id="stats-chart-caption"></caption><thead><tr><th scope="col">Участник</th><th scope="col" id="stats-chart-unit">Участия</th><th scope="col">Доля</th></tr></thead><tbody id="stats-chart-data"></tbody></table>
            </div>
          </details>
        </section>

        <section class="stats-panel" aria-labelledby="stats-ranking-title">
          <div class="stats-section-heading">
            <div><h2 id="stats-ranking-title">Рейтинг участников</h2><p id="stats-ranking-description" class="stats-muted"></p></div>
            <div class="stats-segmented" role="group" aria-label="Участники рейтинга">
              <button type="button" data-ranking="players" aria-pressed="true">Игроки</button>
              <button type="button" data-ranking="gms" aria-pressed="false">Мастера</button>
              <button type="button" data-ranking="pairs" aria-pressed="false">Пары</button>
            </div>
          </div>
          <div class="stats-ranking-toolbar">
            <div class="stats-segmented" role="group" aria-label="Сортировка рейтинга">
              <button type="button" data-measure="games" aria-pressed="true">По партиям</button>
              <button type="button" data-measure="progress" aria-pressed="false">По ОП</button>
            </div>
            <button id="stats-ranking-all" class="stats-button" type="button" aria-expanded="false" aria-controls="stats-ranking-list">Показать всех</button>
          </div>
          <ol id="stats-ranking-list" class="stats-ranking-list" role="list"></ol>
          <p id="stats-pairs-note" class="stats-field-hint" hidden>В паре «мастер / игрок» учитываются совместные партии и ОП игрока, полученный в этих партиях.</p>
        </section>

        <section class="stats-panel" aria-labelledby="stats-parties-title">
          <div class="stats-section-heading">
            <div><h2 id="stats-parties-title" tabindex="-1">Партии</h2><p class="stats-muted">Номер обозначает строку источника. Даты партий в источнике не указаны.</p></div>
            <div class="stats-party-controls">
              <div class="stats-field"><label for="stats-sort">Сортировка</label><select id="stats-sort"><option value="id">Номер записи</option><option value="gm">Имя мастера</option><option value="playerCount">Число игроков</option><option value="totalProgress">Всего ОП</option></select></div>
              <div class="stats-field"><label for="stats-direction">Порядок</label><select id="stats-direction"><option value="desc">По убыванию</option><option value="asc">По возрастанию</option></select></div>
            </div>
          </div>
          <div class="stats-table-scroll stats-desktop-parties" tabindex="0" role="region" aria-label="Список партий">
            <table class="stats-parties-table">
              <caption id="stats-parties-caption">Партии выбранной выборки</caption>
              <thead><tr>
                <th scope="col" data-sort-heading="id"><button type="button" data-sort="id">Запись <span data-sort-indicator="id"></span></button></th>
                <th scope="col" data-sort-heading="gm"><button type="button" data-sort="gm">Мастер <span data-sort-indicator="gm"></span></button></th>
                <th scope="col">ОП мастера</th><th scope="col">Игроки и их ОП</th>
                <th scope="col" data-sort-heading="playerCount"><button type="button" data-sort="playerCount">Игроков <span data-sort-indicator="playerCount"></span></button></th>
                <th scope="col" data-sort-heading="totalProgress"><button type="button" data-sort="totalProgress">Всего ОП <span data-sort-indicator="totalProgress"></span></button></th>
              </tr></thead><tbody id="stats-parties-body"></tbody>
            </table>
          </div>
          <div id="stats-party-cards" class="stats-party-cards" aria-label="Партии выбранной выборки"></div>
          <div class="stats-pagination">
            <p id="stats-page-range" class="stats-muted" role="status" aria-live="polite"></p>
            <div class="stats-field"><label for="stats-page-size">На странице</label><select id="stats-page-size"><option value="10">10</option><option value="25" selected>25</option><option value="50">50</option></select></div>
            <nav class="stats-page-navigation" aria-label="Страницы партий">
              <button id="stats-prev" class="stats-button" type="button" aria-label="Предыдущая страница">←</button>
              <div class="stats-field"><label for="stats-page">Страница</label><select id="stats-page"></select></div>
              <button id="stats-next" class="stats-button" type="button" aria-label="Следующая страница">→</button>
            </nav>
          </div>
        </section>
      </div>

      <aside class="stats-methodology" aria-labelledby="stats-methodology-title">
        <h2 id="stats-methodology-title">Как читать статистику</h2>
        <p>Каждая запись источника считается одной партией. Участие — присутствие одного игрока в одной партии. Мастер не входит в среднее число игроков.</p>
        <p>ОП — очки прогресса. «Всего ОП» складывает значения мастера и игроков. Фильтр игрока выбирает партии с его участием: в общих графиках и рейтингах остаются все участники этих партий.</p>
        <p>Период: за всё время, представленное в источнике. Время получения данных не является датой последнего изменения источника.</p>
      </aside>
    </div>
  </div>
</Layout>

<script>
  import { initializeGameStatsPage } from '../../scripts/gameStatsPage';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeGameStatsPage, { once: true });
  } else {
    initializeGameStatsPage();
  }
</script>
