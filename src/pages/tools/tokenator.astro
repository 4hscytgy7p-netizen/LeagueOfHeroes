---
import Layout from '../../layouts/Layout.astro';
import TokenEditor from '../../components/TokenEditor.astro';
---

<Layout title="Токенатор">
  <div class="page">
    <section class="page-header">
      <div>
        <h1>Токенатор</h1>
        <p>Загрузите портрет, настройте кадр и рамку — скачайте готовый токен в PNG.</p>
      </div>
    </section>
    <TokenEditor />
  </div>
</Layout>

<style>
  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0 0 0.25rem;
  }

  .page-header h1 {
    margin: 0;
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    color: var(--primary);
  }

  .page-header p {
    margin: 0;
    color: var(--text);
    line-height: 1.75;
    max-width: 720px;
  }

  h1 {
    margin-bottom: 0.5rem;
  }

  p {
    margin-top: 0;
    margin-bottom: 1rem;
    color: var(--text);
  }

  @media (max-width: 840px) {
    .page {
      padding: 0.75rem 0.25rem 1rem;
    }

    .page-header {
      padding: 0;
    }
  }
</style>
