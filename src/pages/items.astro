---
import Layout from '../layouts/Layout.astro';
import { items } from '../data/items';
import { getPublishedMaterial } from '../data/materials';
import { renderMaterialMetadata } from '../utils/materialPresentation';
const itemsWithMetadata = items.map(item => ({ ...item, materialMetadataHtml: renderMaterialMetadata(getPublishedMaterial('item', item.id)) }));

const sortedItems = [...items].sort((a, b) => 
  a.name.localeCompare(b.name, 'ru')
);

const sourceBooks = [...new Set(items.map(item => item.sourceBook))].sort();
const itemTypes = [...new Set(items.map(item => item.type))].sort();
const typeCategories = [
  {
    id: 'weapons',
    name: 'Оружие и боеприпасы',
    types: ['Простое рукопашное оружие', 'Простое дальнобойное оружие', 'Воинское рукопашное оружие', 'Воинское дальнобойное оружие', 'Боеприпасы'],
  },
  {
    id: 'armor',
    name: 'Доспехи и щиты',
    types: ['Лёгкий доспех', 'Средний доспех', 'Тяжёлый доспех', 'Щит'],
  },
  {
    id: 'tools',
    name: 'Инструменты и наборы',
    types: ['Инструменты', 'Музыкальные инструменты', 'Игровой набор'],
  },
  {
    id: 'focuses',
    name: 'Фокусировки и символы',
    types: ['Магические фокусировки', 'Фокусировка друидов', 'Священный символ'],
  },
  {
    id: 'equipment',
    name: 'Снаряжение и расходники',
    types: ['Снаряжение приключенца', 'Яд'],
  },
  {
    id: 'transport',
    name: 'Животные и транспорт',
    types: ['Верховые и прочие животные', 'Транспортные средства'],
  },
].map(category => ({ ...category, types: category.types.filter(type => itemTypes.includes(type)) }))
  .filter(category => category.types.length > 0);

// Keep newly added item types available even before they are assigned a category.
const categorizedTypes = new Set(typeCategories.flatMap(category => category.types));
const otherTypes = itemTypes.filter(type => !categorizedTypes.has(type));
if (otherTypes.length) typeCategories.push({ id: 'other', name: 'Другие типы', types: otherTypes });
---

<Layout title="Предметы">
  <div class="content">
    <h1>Предметы</h1>
    <p><a href="/rules/equipment">Таблицы оружия, брони, инструментов и правила снаряжения Лиги →</a></p>
    
    <div class="items-container" id="items-container">
      <div id="items-data" data-items={JSON.stringify(itemsWithMetadata)} style="display: none;"></div>
      <div class="items-table">
        <div class="search-container">
          <div class="search-controls">
            <div class="search-input-container">
              <input 
                type="text" 
                id="item-search" 
                placeholder="Поиск предметов..."
                class="search-input"
                aria-label="Поиск предметов"
              />
              <button id="clear-search" class="clear-search-button" aria-label="Очистить поиск">×</button>
            </div>
            <button id="filter-button" class="filter-button" aria-haspopup="dialog">
              <span class="filter-icon">⚙</span>
              Фильтры
              <span id="filter-count" class="filter-count">0</span>
            </button>
          </div>
          <p id="items-counter" class="items-counter" role="status" aria-live="polite">Найдено: {items.length} из {items.length}</p>
          <div class="sort-controls">
            <label for="item-sort">Сортировка</label>
            <select id="item-sort">
              <option value="name:asc">Название: А–Я</option>
              <option value="name:desc">Название: Я–А</option>
              <option value="cost:asc">Сначала дешевле</option>
              <option value="cost:desc">Сначала дороже</option>
              <option value="weight:asc">Сначала легче</option>
              <option value="weight:desc">Сначала тяжелее</option>
              <option value="type:asc">Тип: А–Я</option>
              <option value="type:desc">Тип: Я–А</option>
              <option value="source:asc">Источник: А–Я</option>
              <option value="source:desc">Источник: Я–А</option>
            </select>
          </div>
        </div>

        <table>
          <thead>
            <tr>
              <th class="sortable" data-sort="name" scope="col" aria-sort="ascending">
                <button class="sort-button">
                  Название
                  <span class="sort-icon" aria-hidden="true">↑</span>
                </button>
              </th>
              <th class="sortable" data-sort="type" scope="col" aria-sort="none">
                <button class="sort-button">
                  Тип
                  <span class="sort-icon" aria-hidden="true">↕</span>
                </button>
              </th>
              <th class="sortable" data-sort="cost" scope="col" aria-sort="none">
                <button class="sort-button">
                  Цена
                  <span class="sort-icon" aria-hidden="true">↕</span>
                </button>
              </th>
              <th class="sortable" data-sort="weight" scope="col" aria-sort="none">
                <button class="sort-button">
                  Вес
                  <span class="sort-icon" aria-hidden="true">↕</span>
                </button>
              </th>
              <th class="sortable" data-sort="source" scope="col" aria-sort="none">
                <button class="sort-button">
                  Источник
                  <span class="sort-icon" aria-hidden="true">↕</span>
                </button>
              </th>
            </tr>
          </thead>
          <tbody>
            {sortedItems.map(item => (
              <tr class="item-row" data-item-id={item.id}>
                <td>
                  <a href={`/items/${item.id}`} class="item-select">{item.name}
                    <span class="name-en">[{item.nameEn}]</span>
                  </a>
                </td>
                <td>{item.type}</td>
                <td data-label="Цена">{item.cost}</td>
                <td data-label="Вес">{item.weight}</td>
                <td data-label="Источник">{item.sourceBook}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <div id="empty-results" class="empty-results" hidden>
          <h2>Предметы не найдены</h2>
          <p>Измените запрос или сбросьте выбранные фильтры.</p>
          <div class="empty-actions">
            <button id="empty-clear-search" class="reset-button">Очистить поиск</button>
            <button id="empty-reset-filters" class="reset-button">Сбросить фильтры</button>
          </div>
        </div>
      </div>

      <dialog id="filter-popup" class="filter-popup" aria-labelledby="filter-title">
        <div class="filter-content">
          <div class="filter-header">
            <h3 id="filter-title">Фильтры</h3>
            <button id="close-filter" class="close-button" aria-label="Закрыть фильтры">×</button>
          </div>
          
          <div class="filter-section">
            <h4>Тип предмета</h4>
            <div id="type-filters" class="type-categories">
              {typeCategories.map(category => (
                <div class="type-category" data-type-category data-category-name={category.name}>
                  <div class="type-category-header">
                    <label class="category-label">
                      <input type="checkbox" data-category-checkbox aria-controls={`category-options-${category.id}`} aria-describedby={`category-count-${category.id}`} />
                      <span id={`category-title-${category.id}`}>{category.name}</span>
                    </label>
                    <button type="button" class="category-toggle" aria-expanded="true" aria-controls={`category-options-${category.id}`} aria-label={`Свернуть категорию «${category.name}»`} aria-describedby={`category-count-${category.id}`}>
                      <span id={`category-count-${category.id}`} class="category-count" data-category-count>0/{category.types.length}</span>
                      <span class="category-chevron" aria-hidden="true">▾</span>
                    </button>
                  </div>
                  <div id={`category-options-${category.id}`} class="category-options checkbox-group" role="group" aria-labelledby={`category-title-${category.id}`}>
                    {category.types.map(type => (
                      <label class="checkbox-label"><input type="checkbox" name="type" value={type} />{type}</label>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
          
          <div class="filter-section">
            <h4>Источник</h4>
            <div id="source-filters" class="checkbox-group">
              {sourceBooks.map(source => <label class="checkbox-label"><input type="checkbox" name="source" value={source} />{source}</label>)}
            </div>
          </div>
          
          <div class="filter-actions">
            <button id="reset-filters" class="reset-button">Сбросить все фильтры</button>
            <button id="apply-filters" class="filter-button">Показать {items.length}</button>
          </div>
        </div>
      </dialog>

      <section id="item-details" class="item-details" aria-label="Описание предмета">
        <p id="details-placeholder">Выберите предмет для просмотра</p>
        <div id="selected-item" class="details-content" hidden>
          <button id="back-to-items" class="reset-button back-to-items">← Назад к списку</button>
          <h2 id="detail-name" tabindex="-1"></h2>
          <p id="detail-name-en" class="name-en"></p>
          <div id="detail-material-metadata"></div>
          <dl class="item-meta">
            <div><dt>Тип</dt><dd id="detail-type"></dd></div>
            <div><dt>Цена</dt><dd id="detail-cost"></dd></div>
            <div><dt>Вес</dt><dd id="detail-weight"></dd></div>
          </dl>
          <p id="detail-description" class="item-description"></p>
          <p id="detail-additional-rules" hidden><a id="detail-additional-rules-source" target="_blank" rel="noopener noreferrer">Источник дополнительных механик: XGE, «Владение инструментами» ↗</a></p>
          <a id="open-item-page" class="open-item-page" target="_blank" rel="noopener">Открыть отдельно ↗</a>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  import { parseCurrencyString, convertToGold } from '../utils/currency';
  import { normalizeItemSearch } from '../utils/itemSearch';

  type Item = typeof import('../data/items').items[number] & { materialMetadataHtml: string };

  function initializeItems() {
    const searchInput = document.getElementById('item-search') as HTMLInputElement | null;
    const itemRows = document.querySelectorAll<HTMLElement>('.item-row');
    const sortableHeaders = document.querySelectorAll<HTMLElement>('.sortable');
    const itemDetails = document.getElementById('item-details') as HTMLElement | null;
    const filterButton = document.getElementById('filter-button');
    const filterPopup = document.getElementById('filter-popup') as HTMLDialogElement;
    const closeButton = document.getElementById('close-filter');
    const resetButton = document.getElementById('reset-filters');
    const clearSearchButton = document.getElementById('clear-search');
    const itemsCounter = document.getElementById('items-counter');
    const items: Item[] = JSON.parse(document.getElementById('items-data')?.getAttribute('data-items') || '[]');
    const itemsById = new Map(items.map(item => [item.id, item]));
    const searchNames = new Map(items.map(item => [item.id, normalizeItemSearch(`${item.name} ${item.nameEn}`)]));
    const container = document.getElementById('items-container')!;
    const mobile = window.matchMedia('(max-width: 1023px)');
    const sortSelect = document.getElementById('item-sort') as HTMLSelectElement;
    const categories = Array.from(filterPopup.querySelectorAll<HTMLElement>('[data-type-category]')).map(group => ({
      group,
      checkbox: group.querySelector<HTMLInputElement>('[data-category-checkbox]')!,
      types: Array.from(group.querySelectorAll<HTMLInputElement>('input[name="type"]')),
      toggle: group.querySelector<HTMLButtonElement>('.category-toggle')!,
      options: group.querySelector<HTMLElement>('.category-options')!,
      count: group.querySelector<HTMLElement>('[data-category-count]')!,
    }));
    let selectedItemId: string | null = null;
    let listScrollY = 0;
    let currentSort = { column: 'name', direction: 'asc' };

    function filterItems() {
      const searchTerm = normalizeItemSearch(searchInput?.value || '');
      const selectedTypes = Array.from(filterPopup.querySelectorAll<HTMLInputElement>('input[name="type"]:checked')).map(cb => cb.value);
      const selectedSources = Array.from(filterPopup.querySelectorAll<HTMLInputElement>('input[name="source"]:checked')).map(cb => cb.value);
      
      let visibleCount = 0;
      
      itemRows.forEach(row => {
        const itemId = row instanceof HTMLElement ? row.dataset.itemId : undefined;
        const item = itemId ? itemsById.get(itemId) : undefined;
        if (!item) return;

        const name = searchNames.get(item.id)!;
        const type = item.type;
        const source = item.sourceBook;
        
        const matchesSearch = name.includes(searchTerm);
        const matchesType = selectedTypes.length === 0 || selectedTypes.includes(type);
        const matchesSource = selectedSources.length === 0 || selectedSources.includes(source);
        
        const isVisible = matchesSearch && matchesType && matchesSource;
        row.hidden = !isVisible;
        
        if (isVisible) {
          visibleCount++;
        }
      });
      
      // Update counter
      if (itemsCounter) {
        itemsCounter.textContent = `Найдено: ${visibleCount} из ${items.length}`;
      }
      
      // Update clear button visibility
      if (clearSearchButton) {
        clearSearchButton.style.display = searchInput?.value ? 'flex' : 'none';
      }
      document.getElementById('empty-results')!.hidden = visibleCount > 0;
      document.getElementById('apply-filters')!.textContent = `Показать ${visibleCount}`;
      
      saveFilters();
      updateFilterCount();
      updateTypeCategories();
    }

    function updateTypeCategories() {
      categories.forEach(category => {
        const selected = category.types.filter(checkbox => checkbox.checked).length;
        category.checkbox.checked = selected === category.types.length;
        category.checkbox.indeterminate = selected > 0 && selected < category.types.length;
        category.count.textContent = `${selected}/${category.types.length}`;
        category.count.setAttribute('aria-label', `Выбрано типов: ${selected} из ${category.types.length}`);
        category.group.classList.toggle('has-selected-types', selected > 0);
      });
    }

    function expandCategory(category: typeof categories[number], expanded: boolean) {
      category.options.hidden = !expanded;
      category.toggle.setAttribute('aria-expanded', String(expanded));
      category.toggle.setAttribute('aria-label', `${expanded ? 'Свернуть' : 'Развернуть'} категорию «${category.group.dataset.categoryName}»`);
    }

    function sortItems(column: string, direction?: string) {
      const tbody = container.querySelector('tbody');
      const rows = Array.from(container.querySelectorAll<HTMLElement>('.item-row'));
      
      if (!tbody) return;
      
      // Update sort direction
      if (direction) {
        currentSort = { column, direction };
      } else if (currentSort.column === column) {
        currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
      } else {
        currentSort = { column, direction: 'asc' };
      }
      
      // Update sort icons
      sortableHeaders.forEach(header => {
        const icon = header.querySelector('.sort-icon');
        if (!icon) return;
        
        if (header.getAttribute('data-sort') === column) {
          icon.textContent = currentSort.direction === 'asc' ? '↑' : '↓';
          header.setAttribute('aria-sort', currentSort.direction === 'asc' ? 'ascending' : 'descending');
        } else {
          icon.textContent = '↕';
          header.setAttribute('aria-sort', 'none');
        }
      });
      sortSelect.value = `${column}:${currentSort.direction}`;
      
      // Sort rows
      rows.sort((a, b) => {
        let aValue = '';
        let bValue = '';
        
        switch(column) {
          case 'name':
            aValue = a.querySelector('td')?.textContent?.toLowerCase() || '';
            bValue = b.querySelector('td')?.textContent?.toLowerCase() || '';
            break;
          case 'type':
            aValue = a.querySelectorAll('td')[1]?.textContent?.toLowerCase() || '';
            bValue = b.querySelectorAll('td')[1]?.textContent?.toLowerCase() || '';
            break;
          case 'cost':
            const aCost = parseCurrencyString(a.querySelectorAll('td')[2]?.textContent || '');
            const bCost = parseCurrencyString(b.querySelectorAll('td')[2]?.textContent || '');
            return currentSort.direction === 'asc'
              ? convertToGold(aCost) - convertToGold(bCost)
              : convertToGold(bCost) - convertToGold(aCost);
          case 'weight':
            const aWeight = parseFloat((a.querySelectorAll('td')[3]?.textContent || '').replace(',', '.')) || 0;
            const bWeight = parseFloat((b.querySelectorAll('td')[3]?.textContent || '').replace(',', '.')) || 0;
            return currentSort.direction === 'asc' ? aWeight - bWeight : bWeight - aWeight;
          case 'source':
            aValue = a.querySelectorAll('td')[4]?.textContent || '';
            bValue = b.querySelectorAll('td')[4]?.textContent || '';
            break;
        }
        
        return currentSort.direction === 'asc' 
          ? aValue.localeCompare(bValue, 'ru')
          : bValue.localeCompare(aValue, 'ru');
      });
      
      // Reorder DOM
      rows.forEach(row => tbody.appendChild(row));
    }

    function showItemDetails(itemId: string | null, moveFocus = true) {
      if (!itemDetails) return;
      const item = itemId ? itemsById.get(itemId) : undefined;
      selectedItemId = item?.id || null;
      container.classList.toggle('has-selection', Boolean(item));
      document.getElementById('details-placeholder')!.hidden = Boolean(item);
      document.getElementById('selected-item')!.hidden = !item;
      itemRows.forEach(row => {
        const active = row.dataset.itemId === selectedItemId;
        row.classList.toggle('active', active);
        const link = row.querySelector('a')!;
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
      if (!item) {
        if (moveFocus && mobile.matches) {
          searchInput?.focus({ preventScroll: true });
          window.scrollTo(0, listScrollY);
        }
        return;
      }
      const cost = parseCurrencyString(item.cost);
      const values = {
        'detail-name': item.name,
        'detail-name-en': `[${item.nameEn}]`,
        'detail-type': item.type,
        'detail-cost': `${item.cost}${cost.unit !== 'зм' ? ` (${convertToGold(cost)} зм)` : ''}`,
        'detail-weight': item.weight,
        'detail-description': item.description.trim(),
      };
      Object.entries(values).forEach(([id, value]) => { document.getElementById(id)!.textContent = value; });
      document.getElementById('detail-material-metadata')!.innerHTML = item.materialMetadataHtml;
      document.getElementById('detail-additional-rules')!.hidden = !item.additionalRulesSource;
      const rulesSource = document.getElementById('detail-additional-rules-source') as HTMLAnchorElement;
      if (item.additionalRulesSource) rulesSource.href = item.additionalRulesSource;
      else rulesSource.removeAttribute('href');
      (document.getElementById('open-item-page') as HTMLAnchorElement).href = `/items/${item.id}`;
      itemDetails.scrollTop = 0;
      if (moveFocus && mobile.matches) {
        window.scrollTo(0, 0);
        document.getElementById('detail-name')!.focus({ preventScroll: true });
      }
    }

    function selectItem(itemId: string) {
      if (selectedItemId === itemId) return;
      const fromList = !selectedItemId;
      if (fromList) {
        listScrollY = window.scrollY;
        history.replaceState({ ...history.state, listScrollY }, '');
      }
      history.pushState({ itemId, listScrollY, fromList }, '', `/items/${itemId}`);
      showItemDetails(itemId);
    }

    // Add sort event listeners
    sortableHeaders.forEach(header => {
      header.querySelector('button')?.addEventListener('click', () => {
        const column = header.getAttribute('data-sort');
        if (column) sortItems(column);
      });
    });

    searchInput?.addEventListener('input', filterItems);
    sortSelect.addEventListener('change', () => {
      const [column, direction] = sortSelect.value.split(':');
      sortItems(column, direction);
    });
    
    // Clear search functionality
    function clearSearch() {
      if (searchInput) {
        searchInput.value = '';
        filterItems();
        searchInput.focus();
      }
    }
    clearSearchButton?.addEventListener('click', clearSearch);
    document.getElementById('empty-clear-search')!.addEventListener('click', clearSearch);
    document.getElementById('empty-reset-filters')!.addEventListener('click', resetFilters);
    
    // Filter system event listeners
    filterButton?.addEventListener('click', togglePopup);
    closeButton?.addEventListener('click', () => filterPopup.close());
    document.getElementById('apply-filters')!.addEventListener('click', () => filterPopup.close());
    filterPopup?.addEventListener('click', closePopup);
    resetButton?.addEventListener('click', resetFilters);
    categories.forEach(category => {
      category.toggle.addEventListener('click', () => expandCategory(category, category.options.hidden));
    });
    
    // Add event listeners for filter checkboxes using event delegation
    filterPopup?.addEventListener('change', (e) => {
      const target = e.target;
      if (target instanceof HTMLInputElement && target.type === 'checkbox') {
        const category = categories.find(category => category.checkbox === target);
        if (category) category.types.forEach(checkbox => { checkbox.checked = target.checked; });
        filterItems();
      }
    });
    
    itemRows.forEach(row => {
      row.addEventListener('click', event => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        const itemId = row instanceof HTMLElement ? row.dataset.itemId : undefined;
        if (itemId) selectItem(itemId);
      });
    });

    // Handle browser back/forward buttons
    window.addEventListener('popstate', (event) => {
      listScrollY = event.state?.listScrollY ?? listScrollY;
      showItemDetails(event.state?.itemId || null);
    });
    document.getElementById('back-to-items')!.addEventListener('click', () => {
      if (history.state?.fromList) history.back();
      else {
        history.pushState({ itemId: null, listScrollY }, '', '/items');
        showItemDetails(null);
      }
    });

    // Check if URL contains item ID on page load
    const pathParts = window.location.pathname.split('/');
    const initialId = itemsById.has(pathParts[2]) ? pathParts[2] : null;
    history.replaceState({ ...history.state, itemId: initialId, listScrollY }, '');
    showItemDetails(initialId, false);
    
    // Initialize filter system
    loadFilters();
    
    // Initialize counter
    filterItems();
    // Load filters from localStorage
    function loadFilters() {
      try {
        const filters = JSON.parse(localStorage.getItem('itemFilters') || '{}');
        filterPopup.querySelectorAll<HTMLInputElement>('input[name="type"], input[name="source"]').forEach(cb => {
          cb.checked = Array.isArray(filters?.[cb.name]) && filters[cb.name].includes(cb.value);
        });
      } catch { /* Ignore corrupt or unavailable browser storage. */ }
    }

    // Initialize item tooltip for item links (load script and use window.ItemTooltip)
    (function ensureItemTooltipAndInit() {
      function ensureItemTooltip() {
        return new Promise<NonNullable<Window['ItemTooltip']>>((resolve, reject) => {
              if (window.ItemTooltip) return resolve(window.ItemTooltip);
              if (document.querySelector('script[data-item-tooltip]')) {
                // wait for loader to set window.ItemTooltip
                const check = setInterval(() => {
                  if (window.ItemTooltip) { clearInterval(check); resolve(window.ItemTooltip); }
                }, 50);
                setTimeout(() => { clearInterval(check); reject(new Error('timeout loading itemTooltip')); }, 5000);
                return;
              }
          const s = document.createElement('script');
          s.src = '/js/itemTooltip.js';
          s.async = true;
          s.setAttribute('data-item-tooltip', '1');
          s.onload = () => {
            if (window.ItemTooltip) resolve(window.ItemTooltip);
            else reject(new Error('ItemTooltip не зарегистрирован после загрузки скрипта'));
          };
          s.onerror = (e) => { reject(e); };
          document.head.appendChild(s);
        });
      }

      ensureItemTooltip().then(ItemTooltip => {
        try {
          const itemData = JSON.parse(document.getElementById('items-data')?.getAttribute('data-items') || '[]');
          const itemTooltipEl = document.createElement('div');
          itemTooltipEl.id = 'item-tooltip';
          itemTooltipEl.style.display = 'none';
          itemTooltipEl.style.position = 'fixed';
          itemTooltipEl.style.zIndex = '10000';
          document.body.appendChild(itemTooltipEl);

          const ItemCtor = ItemTooltip;
          const itemTooltip = new ItemCtor();
          itemTooltip.init(itemTooltipEl, itemData);
        } catch (e) {
          console.error('item tooltip init failed', e);
        }
      }).catch(err => console.error('failed loading itemTooltip script', err));
    })();

    // Save filters to localStorage
    function saveFilters() {
      const filters = {
        type: Array.from(filterPopup.querySelectorAll<HTMLInputElement>('input[name="type"]:checked')).map(cb => cb.value),
        source: Array.from(filterPopup.querySelectorAll<HTMLInputElement>('input[name="source"]:checked')).map(cb => cb.value)
      };
      
      try { localStorage.setItem('itemFilters', JSON.stringify(filters)); }
      catch { /* Searching remains available when browser storage is disabled. */ }
    }
      
    // Update filter count display
    function updateFilterCount() {
      const activeFilters = 
        filterPopup.querySelectorAll('input[name="type"]:checked').length +
        filterPopup.querySelectorAll('input[name="source"]:checked').length;
      
      const filterCount = document.getElementById('filter-count');
      if (filterCount) {
        filterCount.textContent = activeFilters.toString();
        filterCount.style.display = activeFilters > 0 ? 'flex' : 'none';
      }
      
      const filterButton = document.getElementById('filter-button');
      if (filterButton) {
        filterButton.classList.toggle('has-filters', activeFilters > 0);
      }
    }


    // Toggle filter popup
    function togglePopup() {
      categories.forEach(category => expandCategory(category, !mobile.matches || category.types.some(checkbox => checkbox.checked)));
      filterPopup.showModal();
    }

    // Close popup when clicking outside
    function closePopup(e: MouseEvent) {
      const rect = filterPopup.getBoundingClientRect();
      if (e.target === filterPopup && (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom)) {
        filterPopup.close();
      }
    }

    // Reset all filters
    function resetFilters() {
      filterPopup.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach(cb => {
        cb.checked = false;
      });
      filterItems();
    }
  }


  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeItems);
  else initializeItems();
</script>

